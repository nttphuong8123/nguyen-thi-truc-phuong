---
import MainLayout from '../../layouts/MainLayout.astro';
import db, {
  verifyGateToken,
  getSiteContactConfig,
  getYoutubeVideos,
  getEvaluationCriteria,
  getEvaluations,
  getSurveys,
  type AccessGate,
  type SyllabusCode,
  type ExamSubmission,
  type SitePage,
  getBirthdayTemplates,
  getBirthdayStats,
  getMonthlyBirthdayRecipients,
  type BirthdayWish,
  type BirthdayTemplate,
  type BirthdayStats,
  type BirthdayRecipientDetail,
  type NewsArticle,
  type SiteContactConfig,
  type YoutubeVideoItem,
  type EvaluationCriterion,
  type LecturerEvaluation,
  getTeachingSchedule,
  type TeachingScheduleItem,
  type StudentSurvey,
  getToroChatLogs,
  purgeOldChatLogs,
  type ToroChatLog,
  getAdminAccounts,
  getAdminAuditLogs,
  type AdminAccount,
  type AdminAuditLog,
} from '../../lib/db';
import { verifyAdminToken, type AdminSessionPayload } from '../../lib/admin-auth';
import { getAllQuizTargetsSummary, getOnlineExamConfig, type QuizTargetMeta, type OnlineExamConfig } from '../../lib/quiz-helper';

const sessionCookie = Astro.cookies.get('tkd_admin_session')?.value;
const adminSession = verifyAdminToken(sessionCookie);

const gateToken = Astro.cookies.get('tkd_gate_admin')?.value;
const isLegacyGateAuth = verifyGateToken('admin', gateToken);

const isAuthenticated = Boolean(adminSession || isLegacyGateAuth);
const currentAdmin: AdminSessionPayload = adminSession || {
  userId: 1,
  username: 'admin',
  role: 'super_admin',
  permissions: ['all'],
  displayName: 'Quản Trị Viên Cấp Cao',
  exp: Date.now() + 86400000,
};

let gates: AccessGate[] = [];
let syllabusCodes: SyllabusCode[] = [];
let submissions: ExamSubmission[] = [];
let pages: Array<Pick<SitePage, 'route_path' | 'title' | 'category' | 'page_type' | 'updated_at'>> = [];
let birthdays: BirthdayWish[] = [];
let newsArticles: NewsArticle[] = [];
let quizTargets: QuizTargetMeta[] = [];
let onlineExamConfig: OnlineExamConfig = getOnlineExamConfig();
let siteContact: SiteContactConfig = getSiteContactConfig();
let youtubeVideos: YoutubeVideoItem[] = [];
let evalCriteria: EvaluationCriterion[] = [];
let evaluations: LecturerEvaluation[] = [];
let contactMessages: StudentSurvey[] = [];
let nckhSurveys: StudentSurvey[] = [];
let teachingSchedule: TeachingScheduleItem[] = [];
let chatLogs: ToroChatLog[] = [];
let adminAccounts: AdminAccount[] = [];
let auditLogs: AdminAuditLog[] = [];
let birthdayStats: BirthdayStats = getBirthdayStats();
let birthdayTemplates: BirthdayTemplate[] = [];
let monthlyRecipients: BirthdayRecipientDetail[] = [];

if (isAuthenticated) {
  gates = db.prepare('SELECT * FROM access_gates ORDER BY gate_key ASC').all() as AccessGate[];
  syllabusCodes = db.prepare('SELECT * FROM syllabus_codes ORDER BY is_public DESC, code ASC').all() as SyllabusCode[];
  submissions = db.prepare('SELECT * FROM exam_submissions ORDER BY id DESC LIMIT 500').all() as ExamSubmission[];
  pages = db
    .prepare("SELECT route_path, title, category, page_type, updated_at FROM site_pages WHERE route_path NOT LIKE '/__%' ORDER BY route_path ASC")
    .all() as Array<Pick<SitePage, 'route_path' | 'title' | 'category' | 'page_type' | 'updated_at'>>;
  birthdays = db.prepare('SELECT * FROM birthday_wishes ORDER BY birth_month ASC, birth_day ASC').all() as BirthdayWish[];
  newsArticles = db.prepare('SELECT * FROM news_articles ORDER BY id DESC').all() as NewsArticle[];
  quizTargets = getAllQuizTargetsSummary();
  onlineExamConfig = getOnlineExamConfig();
  siteContact = getSiteContactConfig();
  youtubeVideos = getYoutubeVideos();
  evalCriteria = getEvaluationCriteria();
  evaluations = getEvaluations(500);
  contactMessages = getSurveys('contact_message', 500);
  nckhSurveys = getSurveys('nckh', 500);
  teachingSchedule = getTeachingSchedule();
  purgeOldChatLogs(30, true);
  chatLogs = getToroChatLogs(2000);
  adminAccounts = getAdminAccounts();
  auditLogs = getAdminAuditLogs(300);
  birthdayStats = getBirthdayStats();
  birthdayTemplates = getBirthdayTemplates();
  monthlyRecipients = getMonthlyBirthdayRecipients();
}
---

<MainLayout
  title="Quản Trị Hệ Thống (Admin CMS) — NGUYỄN THỊ TRÚC PHƯƠNG"
  description="Bảng điều khiển quản trị điểm thi sinh viên, mật khẩu lớp học, mã đề cương thực tập và kho học liệu."
  currentPath="/admin"
  noindex={true}
>
  {
    !isAuthenticated ? (
      <main class="max-w-md mx-auto px-4 py-16">
        <div class="bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
          <div class="bg-gradient-to-br from-slate-900 via-sky-900 to-slate-900 p-6 text-center text-white">
            <div class="w-12 h-12 rounded-2xl bg-sky-500/20 border border-sky-400/30 flex items-center justify-center mx-auto mb-3 text-2xl">
              ⚙️
            </div>
            <h1 class="text-lg font-extrabold uppercase tracking-wide">Quản Trị Hệ Thống (Bản Sao)</h1>
            <p class="text-xs text-sky-300 mt-1">Đăng nhập phân quyền bảo mật — nguyenthitrucphuong</p>
          </div>
          <form id="adminAccountLoginForm" class="p-6 space-y-4">
            <div>
              <label for="adminUsername" class="block text-xs font-bold uppercase text-slate-700 mb-1.5">
                Tài khoản Quản trị viên:
              </label>
              <input
                type="text"
                id="adminUsername"
                placeholder="Nhập tên tài khoản..."
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 font-mono text-sm focus:outline-none focus:border-sky-600 focus:bg-white"
              />
            </div>
            <div>
              <label for="adminPassword" class="block text-xs font-bold uppercase text-slate-700 mb-1.5">
                Mật khẩu:
              </label>
              <input
                type="password"
                id="adminPassword"
                placeholder="Nhập mật khẩu..."
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 font-mono text-sm focus:outline-none focus:border-sky-600 focus:bg-white"
              />
            </div>
            <button
              type="submit"
              class="w-full py-3 rounded-xl bg-sky-700 hover:bg-sky-800 text-white font-bold text-sm shadow-sm transition-colors cursor-pointer"
            >
              🔐 Đăng Nhập Quản Trị
            </button>
            <p id="adminLoginErr" class="text-rose-600 text-xs font-bold text-center hidden"></p>
          </form>
        </div>
      </main>
    ) : (
      <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
        <!-- Header Bar -->
        <div class="bg-white p-5 rounded-2xl shadow-xs border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 flex items-center gap-2.5">
                <span>⚙️</span> Bảng Điều Khiển Quản Trị (nguyenthitrucphuong)
              </h1>
              <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${
                currentAdmin.role === 'super_admin' ? 'bg-purple-50 text-purple-800 border-purple-200' :
                currentAdmin.role === 'editor' ? 'bg-sky-50 text-sky-800 border-sky-200' :
                'bg-slate-100 text-slate-700 border-slate-200'
              }`}>
                {currentAdmin.role === 'super_admin' ? '👑 Super Admin' : currentAdmin.role === 'editor' ? '✍️ Biên Tập Viên' : '👁️ Quan Sát Viên'}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              Xin chào <strong>{currentAdmin.displayName}</strong> (<span class="font-mono text-sky-700">@{currentAdmin.username}</span>) • Cơ sở dữ liệu: <code class="font-mono text-[11px] bg-slate-100 px-1 py-0.5 rounded">nguyenthitrucphuong-db</code>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="/api/chat-logs?format=csv"
              title="Tải file câu hỏi và câu trả lời của Trợ lý AI (tự động xóa sau 30 ngày)"
              class="inline-flex items-center gap-1.5 bg-sky-700 hover:bg-sky-800 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-xs transition-colors"
            >
              <span aria-hidden="true">🤖</span>
              <span>Xuất Câu Hỏi AI (.CSV)</span>
            </a>
            <a
              href="/api/submissions?format=csv"
              title="Tải bảng điểm sinh viên dưới dạng file Excel CSV"
              class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-xs transition-colors"
            >
              <span aria-hidden="true">📥</span>
              <span>Xuất Bảng Điểm (.CSV)</span>
            </a>
            <button
              type="button"
              id="adminLogoutBtn"
              class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs px-4 py-2.5 rounded-xl transition-colors cursor-pointer"
            >
              Đăng xuất
            </button>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-6 gap-3.5">
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Lượt nộp bài / Mở đề</span>
            <p class="text-2xl font-extrabold text-sky-700 num-font mt-1">{submissions.length}</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Mã đề cương (/DCCT)</span>
            <p class="text-2xl font-extrabold text-emerald-700 num-font mt-1">{syllabusCodes.length}</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Trang học liệu</span>
            <p class="text-2xl font-extrabold text-indigo-700 num-font mt-1">{pages.length}</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Đánh giá &amp; Khảo sát</span>
            <p class="text-2xl font-extrabold text-rose-600 num-font mt-1">{evaluations.length + contactMessages.length + nckhSurveys.length}</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Tài khoản Admin</span>
            <p class="text-2xl font-extrabold text-purple-700 num-font mt-1">{adminAccounts.length}</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-bold uppercase text-slate-400">Nhật ký thao tác</span>
            <p class="text-2xl font-extrabold text-amber-700 num-font mt-1">{auditLogs.length}</p>
          </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-2">
          <button
            type="button"
            data-tab="tab-submissions"
            class="admin-tab-btn bg-sky-700 text-white font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl cursor-pointer transition-colors"
          >
            📊 1. Bảng Điểm Sinh Viên ({submissions.length})
          </button>
          <button
            type="button"
            data-tab="tab-gates"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            🔐 2. Cấu Hình Liên Hệ &amp; Mật Khẩu
          </button>
          <button
            type="button"
            data-tab="tab-dcct"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            📘 3. Mã Đề Cương Thực Tập (/DCCT)
          </button>
          <button
            type="button"
            data-tab="tab-pages"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            📄 4. Danh Sách Trang Học Liệu ({pages.length})
          </button>
          <button
            type="button"
            data-tab="tab-news-bday"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            🎂 5. Tin Tức &amp; Sinh Nhật ({newsArticles.length + birthdays.length})
          </button>
          <button
            type="button"
            data-tab="tab-quiz-bank"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            🎯 6. Ngân Hàng Đề Thi &amp; Câu Hỏi ({quizTargets.length} bộ đề)
          </button>
          <button
            type="button"
            data-tab="tab-evaluations"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            ⭐ 7. Đánh Giá Giảng Viên &amp; Khảo Sát ({evaluations.length + contactMessages.length + nckhSurveys.length})
          </button>
          <button
            type="button"
            data-tab="tab-teaching-schedule"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            📅 8. Lịch Giảng &amp; Nhóm Lớp ({teachingSchedule.length})
          </button>
          <button
            type="button"
            data-tab="tab-chat-logs"
            class="admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors"
          >
            🤖 9. Xuất Câu Hỏi &amp; Trả Lời AI ({chatLogs.length})
          </button>
        </div>

        <!-- TAB 1: SUBMISSIONS -->
        <section id="tab-submissions" class="admin-tab-panel bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
          <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <h2 class="font-bold text-base text-slate-900">Lịch sử Sinh viên Làm bài Trắc nghiệm & Mở đề thi</h2>
            <div class="flex flex-wrap items-center gap-2">
              <input
                type="text"
                id="filterSubmissionInput"
                placeholder="Tìm theo tên sinh viên, lớp/MSSV, môn học, mã đề..."
                class="w-full sm:w-72 px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:border-sky-600"
              />
              {submissions.length > 0 && (
                <button
                  type="button"
                  id="clearAllSubsBtn"
                  class="px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs cursor-pointer transition-colors"
                >
                  🗑️ Xóa toàn bộ điểm
                </button>
              )}
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left">
              <thead class="bg-slate-100 text-slate-700 uppercase text-xs font-bold">
                <tr>
                  <th class="py-3 px-3">ID</th>
                  <th class="py-3 px-4">Họ và Tên Sinh viên</th>
                  <th class="py-3 px-3">Lớp / MSSV</th>
                  <th class="py-3 px-4">Môn học / Học phần</th>
                  <th class="py-3 px-3">Hình thức</th>
                  <th class="py-3 px-3 text-center">Mã đề</th>
                  <th class="py-3 px-3 text-center">Điểm số</th>
                  <th class="py-3 px-3">Thời gian làm</th>
                  <th class="py-3 px-3">Thời điểm nộp</th>
                  <th class="py-3 px-3 text-center">Xóa</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {submissions.length === 0 ? (
                  <tr>
                    <td colspan="10" class="py-8 text-center text-slate-400 italic">
                      Chưa có lượt nộp bài nào. Khi sinh viên làm bài trắc nghiệm hoặc mở đề kiểm tra, kết quả sẽ tự động hiển thị tại đây.
                    </td>
                  </tr>
                ) : (
                  submissions.map((sub) => (
                    <tr class="submission-row hover:bg-slate-50" data-search={`${sub.student_name.toLowerCase()} ${sub.student_id.toLowerCase()} ${sub.subject_title.toLowerCase()} ${sub.test_code.toLowerCase()}`}>
                      <td class="py-3 px-3 num-font text-slate-400">#{sub.id}</td>
                      <td class="py-3 px-4 font-bold text-slate-900">{sub.student_name}</td>
                      <td class="py-3 px-3 num-font text-slate-700">{sub.student_id || '—'}</td>
                      <td class="py-3 px-4">
                        <a href={sub.subject_path} title={`Mở trang ${sub.subject_title}`} class="text-sky-700 hover:underline font-medium">
                          {sub.subject_title}
                        </a>
                      </td>
                      <td class="py-3 px-3 text-slate-600">{sub.exam_mode}</td>
                      <td class="py-3 px-3 text-center num-font font-bold text-indigo-700">{sub.test_code}</td>
                      <td class="py-3 px-3 text-center">
                        <span class={`inline-block num-font font-extrabold px-2.5 py-0.5 rounded-full text-xs ${sub.score >= 80 ? 'bg-emerald-100 text-emerald-800' : sub.score >= 50 ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'}`}>
                          {sub.score} / {sub.max_score}
                        </span>
                      </td>
                      <td class="py-3 px-3 text-slate-600">{sub.duration_text}</td>
                      <td class="py-3 px-3 num-font text-xs text-slate-500">{sub.submitted_at}</td>
                      <td class="py-3 px-3 text-center">
                        <button
                          type="button"
                          data-del-sub={sub.id}
                          class="del-sub-btn text-rose-600 hover:text-rose-800 font-bold text-xs cursor-pointer"
                        >
                          Xóa
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>

        <!-- TAB 2: ACCESS GATES & CONTACT CONFIG -->
        <section id="tab-gates" class="admin-tab-panel hidden space-y-5">
          <!-- Khối Cấu hình Thông tin Liên hệ toàn website -->
          <div class="bg-white p-5 sm:p-6 rounded-2xl border border-sky-200 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-extrabold text-sm sm:text-base text-slate-900 flex items-center gap-2">
                  <span>📇</span>
                  <span>Cấu Hình Thông Tin Liên Hệ Giảng Viên (Toàn Website &amp; Trang /contact)</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  Thay đổi Email, Zalo/Hotline, Địa chỉ, Lịch tiếp sinh viên và Mạng xã hội hiển thị đồng bộ trên Footer, Schema SEO và trang Liên hệ
                </p>
              </div>
              <a
                href="/contact"
                target="_blank"
                class="px-3.5 py-1.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 font-bold text-xs shrink-0"
              >
                Xem trang /contact ↗
              </a>
            </div>
            <form id="siteContactConfigForm" class="space-y-4 text-xs">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Họ tên &amp; Học vị Giảng viên</label>
                  <input
                    type="text"
                    id="cfgInstructorName"
                    value={siteContact.instructor_name}
                    required
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 font-semibold text-slate-900 focus:outline-none focus:border-sky-600"
                  />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Đơn vị / Khoa công tác</label>
                  <input
                    type="text"
                    id="cfgDepartment"
                    value={siteContact.department}
                    required
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 focus:outline-none focus:border-sky-600"
                  />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Email chính thức *</label>
                  <input
                    type="email"
                    id="cfgEmail"
                    value={siteContact.email}
                    required
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono font-bold text-blue-700 focus:outline-none focus:border-sky-600"
                  />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Số Zalo / Hotline *</label>
                  <input
                    type="text"
                    id="cfgHotline"
                    value={siteContact.hotline}
                    required
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono font-bold text-emerald-700 focus:outline-none focus:border-sky-600"
                  />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Link chat Zalo trực tiếp</label>
                  <input
                    type="text"
                    id="cfgZaloUrl"
                    value={siteContact.zalo_url}
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-700 focus:outline-none focus:border-sky-600"
                  />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Địa chỉ trường / đơn vị *</label>
                  <input
                    type="text"
                    id="cfgAddress"
                    value={siteContact.address}
                    required
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 font-semibold text-slate-900 focus:outline-none focus:border-sky-600"
                  />
                </div>
                <div>
                  <label class="block font-bold text-slate-700 mb-1">Link kênh YouTube</label>

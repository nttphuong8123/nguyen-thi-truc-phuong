    // Add & delete Birthday Wishes + Excel File Import (.xlsx, .xls, .csv)
    const excelFileInput = document.getElementById('bdayExcelFileInput');
    if (excelFileInput) {
      excelFileInput.addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const statusEl = document.getElementById('excelFileStatus');
        const rawTextarea = document.getElementById('bulkBdayRawText');
        const defaultClassInput = document.getElementById('bulkDefaultClass');

        // Auto-fill default class name from filename if empty
        if (defaultClassInput && !defaultClassInput.value.trim()) {
          defaultClassInput.value = file.name.replace(/\.(xlsx|xls|csv|txt)$/i, '').trim();
        }

        try {
          if (statusEl) statusEl.textContent = `⏳ Đang đọc file "${file.name}"...`;

          if (/\.(csv|txt)$/i.test(file.name)) {
            const text = await file.text();
            rawTextarea.value = text.trim();
            if (statusEl) statusEl.textContent = `✅ Đã nạp dữ liệu từ "${file.name}". Bấm "Lưu Danh Sách Sinh Nhật" để hoàn tất!`;
            return;
          }

          // Load SheetJS on-demand for .xlsx / .xls files
          if (!window.XLSX) {
            await new Promise((resolve, reject) => {
              const s = document.createElement('script');
              s.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
              s.onload = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          }

          const buf = await file.arrayBuffer();
          const wb = window.XLSX.read(buf, { type: 'array', cellDates: true });
          const lines = [];

          wb.SheetNames.forEach((sheetName) => {
            const sheet = wb.Sheets[sheetName];
            const rows = window.XLSX.utils.sheet_to_json(sheet, { header: 1, raw: false, dateNF: 'dd/mm/yyyy' });
            rows.forEach((row) => {
              if (!Array.isArray(row) || row.length === 0) return;
              const formattedCells = row
                .map((cell) => {
                  if (cell instanceof Date && !isNaN(cell.getTime())) {
                    const d = String(cell.getDate()).padStart(2, '0');
                    const m = String(cell.getMonth() + 1).padStart(2, '0');
                    const y = cell.getFullYear();
                    return `${d}/${m}/${y}`;
                  }
                  return String(cell ?? '').trim();
                })
                .filter(Boolean);
              if (formattedCells.length >= 2) {
                lines.push(formattedCells.join('\t'));
              }
            });
          });

          rawTextarea.value = lines.join('\n');
          if (statusEl) {
            statusEl.textContent = `✅ Đã trích xuất ${lines.length} dòng từ file "${file.name}". Bấm "Lưu Danh Sách Sinh Nhật" để lưu!`;
          }
        } catch (err) {
          alert('Không thể đọc file Excel: ' + err);
        }
      });
    }


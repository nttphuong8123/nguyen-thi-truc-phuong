                </button>
              </div>
            </div>

            <!-- KHUNG SỬA "CHỌN HÌNH THỨC LÀM BÀI: ĐỀ THI THỬ / ÔN TẬP CHƯƠNG 1-6" (ẢNH 2 - HIỂN THỊ KHI CHỌN TRANG CÓ MODES) -->
            <div id="quizModesEditorPanel" class="hidden p-4 rounded-2xl bg-amber-50/60 border border-amber-200 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <h3 class="font-extrabold text-sm text-amber-950 flex items-center gap-1.5">
                    <span>🗂️</span>
                    <span>Chỉnh Sửa Khung "Chọn Hình Thức Làm Bài: Đề Thi Thử / Ôn Tập Chương 1–6"</span>
                  </h3>
                  <p class="text-xs text-amber-800">
                    Sửa trực tiếp tiêu đề chương, số câu, số phút và thang điểm hiển thị trên các nút chọn hình thức làm bài
                  </p>
                </div>
                <button
                  type="button"
                  id="saveQuizModesBtn"
                  class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold text-xs cursor-pointer shrink-0 shadow-2xs"
                >
                  💾 Lưu Khung Chọn Chương
                </button>
              </div>
              <div id="quizModesInputsContainer" class="grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs"></div>
            </div>

            <!-- GRID 2 CỘT: BÊN TRÁI (THÊM/SỬA CÂU HỎI & IMPORT EXCEL) | BÊN PHẢI (DANH SÁCH CÂU HỎI) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
              <!-- Cột trái: Form Thêm/Sửa 1 câu hỏi + Import Excel -->
              <div class="lg:col-span-5 space-y-4">
                <form id="singleQuestionEditorForm" class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3 text-xs">
                  <div class="flex items-center justify-between">
                    <h3 id="questionFormHeader" class="font-extrabold text-sm text-slate-900">
                      ➕ Thêm Câu Hỏi Trắc Nghiệm Mới
                    </h3>
                    <button
                      type="button"
                      id="cancelEditQuestionBtn"
                      class="hidden text-[11px] bg-slate-200 hover:bg-slate-300 text-slate-700 px-2.5 py-0.5 rounded-full font-bold cursor-pointer"
                    >
                      Hủy sửa (Tạo câu mới)
                    </button>
                  </div>

                  <input type="hidden" id="editQuestionIndex" value="-1" />

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Nội dung Câu hỏi <span class="text-rose-600">*</span>:</label>
                    <textarea
                      id="qInputText"
                      rows="3"
                      required
                      placeholder="Nhập nội dung câu hỏi trắc nghiệm..."
                      class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white font-semibold focus:outline-none focus:border-sky-600"
                    ></textarea>
                  </div>

                  <div class="space-y-2">
                    <div>
                      <label class="block font-bold text-slate-700 mb-0.5">Phương án A <span class="text-rose-600">*</span>:</label>
                      <input type="text" id="qOptA" required placeholder="Nội dung đáp án A..." class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
                    </div>
                    <div>
                      <label class="block font-bold text-slate-700 mb-0.5">Phương án B <span class="text-rose-600">*</span>:</label>
                      <input type="text" id="qOptB" required placeholder="Nội dung đáp án B..." class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
                    </div>
                    <div>
                      <label class="block font-bold text-slate-700 mb-0.5">Phương án C:</label>
                      <input type="text" id="qOptC" placeholder="Nội dung đáp án C..." class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
                    </div>
                    <div>
                      <label class="block font-bold text-slate-700 mb-0.5">Phương án D:</label>
                      <input type="text" id="qOptD" placeholder="Nội dung đáp án D..." class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
                    </div>
                  </div>

                  <div class="grid grid-cols-3 gap-2">
                    <div>
                      <label class="block font-bold text-emerald-800 mb-1">Đáp án đúng:</label>
                      <select id="qCorrectSelect" class="w-full px-2.5 py-2 rounded-xl border-2 border-emerald-400 bg-emerald-50 font-extrabold text-emerald-950">
                        <option value="0">Đáp án A</option>
                        <option value="1">Đáp án B</option>
                        <option value="2">Đáp án C</option>
                        <option value="3">Đáp án D</option>
                      </select>
                    </div>
                    <div>
                      <label class="block font-bold text-slate-700 mb-1">Chương:</label>
                      <select id="qChapterSelect" class="w-full px-2.5 py-2 rounded-xl border border-slate-300 bg-white font-bold">
                        <option value="1">Chương 1</option>
                        <option value="2">Chương 2</option>
                        <option value="3">Chương 3</option>
                        <option value="4">Chương 4</option>
                        <option value="5">Chương 5</option>
                        <option value="6">Chương 6</option>
                      </select>
                    </div>
                    <div>
                      <label class="block font-bold text-slate-700 mb-1">Độ khó:</label>
                      <select id="qDifficultySelect" class="w-full px-2.5 py-2 rounded-xl border border-slate-300 bg-white font-semibold">
                        <option value="Dễ">Dễ</option>
                        <option value="Trung bình">Trung bình</option>
                        <option value="Khó">Khó</option>
                      </select>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 mb-1">Giải thích đáp án (Hiển thị sau khi nộp bài):</label>

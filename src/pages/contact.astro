---
import MainLayout from '../layouts/MainLayout.astro';
import { getSiteContactConfig } from '../lib/db';

const contactCfg = getSiteContactConfig();
const cleanPhone = contactCfg.hotline.replace(/\s+/g, '');
const officeHourLines = contactCfg.office_hours
  .split('|')
  .map((s) => s.trim())
  .filter(Boolean);
---

<MainLayout title="Giải Đáp Học Vụ — NGUYỄN THỊ TRÚC PHƯƠNG" currentPath="/contact">
  <main class="w-full bg-[#F7F5F2] min-h-screen pb-16">
    <!-- Header Banner -->
    <header class="w-full bg-gradient-to-br from-[#742D3A] via-[#A83245] to-[#C65B69] text-white shadow-md">
      <div class="max-w-5xl mx-auto px-4 py-8 sm:px-6 lg:px-8 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-5">
          <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-[#A83245] border border-[#F8EDEF]/40 text-[#F8EDEF] text-xs sm:text-sm font-bold tracking-wider uppercase">
              <svg class="w-4 h-4 text-[#F8EDEF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
              </svg>
              <span>{contactCfg.department}</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight uppercase">GIẢI ĐÁP HỌC VỤ</h1>
            <p class="text-white text-sm sm:text-base mt-1">Kênh kết nối chính thức, lịch tiếp sinh viên và gửi câu hỏi trực tiếp đến {contactCfg.instructor_name}</p>
          </div>
          <a href="/danh-gia-giang-vien" class="px-5 py-3 rounded-2xl bg-[#C65B69] hover:bg-[#A83245] border border-[#C65B69]/40 text-white font-extrabold text-xs sm:text-sm transition-all shrink-0 shadow-sm flex items-center gap-2">
            <span>⭐</span>
            <span>Phiếu Đánh Giá Giảng Viên</span>
            <span>➔</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Nội dung Thông tin liên hệ & Góp ý chung -->
    <section class="max-w-5xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="md:col-span-2 p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-[#F8EDEF] text-[#A83245] flex items-center justify-center text-2xl font-extrabold">
              👩‍🏫
            </div>
            <div>
              <h2 class="text-lg font-extrabold text-slate-900">{contactCfg.instructor_name}</h2>
              <p class="text-xs text-slate-700 font-medium">Giảng viên {contactCfg.department}</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs sm:text-sm">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="text-slate-700 font-bold uppercase text-[11px] mb-1">📧 Email Học Vụ</div>
              <a href={`mailto:${contactCfg.email}`} class="font-bold text-[#C65B69] hover:underline break-all">{contactCfg.email}</a>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="text-slate-700 font-bold uppercase text-[11px] mb-1">📞 Zalo / Hotline</div>
              <div class="flex items-center gap-2">
                <a href={`tel:${cleanPhone}`} class="font-bold text-slate-800 hover:text-[#C65B69]">{contactCfg.hotline}</a>
                <a href={contactCfg.zalo_url} target="_blank" rel="noopener" class="px-2 py-0.5 rounded-md bg-[#F8EDEF] text-[#A83245] text-[11px] font-bold hover:bg-[#F8EDEF]">
                  Nhắn Zalo ↗
                </a>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="text-slate-700 font-bold uppercase text-[11px] mb-1">📍 Địa Chỉ Công Tác</div>
              <span class="font-semibold text-slate-800">{contactCfg.address}</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="text-slate-700 font-bold uppercase text-[11px] mb-1">🌐 Kênh Học Thuật</div>
              <div class="flex items-center gap-3 font-bold">
                <a href={contactCfg.youtube_url} target="_blank" rel="noopener" class="text-rose-600 hover:underline">YouTube</a>
                <span class="text-slate-300">•</span>
                <a href={contactCfg.tiktok_url} target="_blank" rel="noopener" class="text-slate-800 hover:underline">TikTok</a>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-gradient-to-br from-[#742D3A] to-[#742D3A] border border-[#E8DDE0]/80 shadow-xs flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <span class="inline-block px-2.5 py-1 rounded-full bg-[#C65B69] text-white text-[11px] font-extrabold uppercase tracking-wider">Lịch tiếp sinh viên</span>
            <h3 class="text-base font-extrabold text-white">Hỗ Trợ Cố Vấn Học Tập &amp; Giải Đáp Thực Tập</h3>
            <p class="text-xs text-[#F8EDEF] leading-relaxed">
              Giảng viên hỗ trợ giải đáp trực tiếp tại văn phòng Khoa ({contactCfg.address}) hoặc trực tuyến qua Zalo / Google Meet:
            </p>
            <div class="space-y-1.5 pt-1 text-xs text-[#F8EDEF]">
              {officeHourLines.map((line) => (
                <p>• <strong class="text-white">{line}</strong></p>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Banner mời đánh giá giảng viên -->
      <div class="p-5 rounded-2xl bg-gradient-to-r from-[#A83245] to-[#C65B69] text-white shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="text-base sm:text-lg font-extrabold text-white">⭐ Khảo sát đánh giá chất lượng giảng dạy học kỳ</h3>
          <p class="text-xs sm:text-sm text-[#F8EDEF]">Ý kiến chân thành của sinh viên giúp cô hoàn thiện phương pháp giảng dạy và nâng cao chất lượng bài giảng.</p>
        </div>
        <a href="/danh-gia-giang-vien" class="px-5 py-2.5 rounded-xl bg-[#C65B69] hover:bg-[#A83245] text-white font-extrabold text-xs sm:text-sm transition-all shrink-0 shadow-xs">
          Mở Trang Đánh Giá Giảng Viên ➔
        </a>
      </div>

      <!-- Form gửi tin nhắn nhanh -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-4">
        <h3 class="font-extrabold text-slate-900 text-base flex items-center gap-2">
          <span>✉️</span>
          <span>Gửi Tin Nhắn / Thắc Mắc Nhanh Đến Giảng Viên</span>
        </h3>
        <form id="generalContactForm" class="space-y-3.5 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Họ và tên của bạn *</label>
              <input type="text" id="contactName" required placeholder="Nguyễn Văn A" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Mã số sinh viên (MSSV)</label>
              <input type="text" id="contactStudentId" placeholder="VD: 2300123" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Lớp sinh hoạt / Học phần</label>
              <input type="text" id="contactClass" placeholder="VD: CĐ QTKD K26A" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white" />
            </div>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Nội dung thắc mắc / đóng góp ý kiến *</label>
            <textarea id="contactMessage" rows="4" required placeholder="Nhập câu hỏi hoặc nội dung bạn cần trao đổi..." class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white"></textarea>
          </div>
          <div class="flex items-center justify-between">
            <span id="contactFormStatus" class="text-xs text-slate-500"></span>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-[#A83245] hover:bg-[#C65B69] text-white font-extrabold cursor-pointer">
              Gửi Tin Nhắn
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script is:inline>
    // Chuyển hướng nếu truy cập link cũ ?tab=survey sang page riêng /danh-gia-giang-vien
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'survey' || window.location.hash.includes('danh-gia')) {
      window.location.replace('/danh-gia-giang-vien');
    }

    // Form góp ý chung - Lưu vào Cloudflare D1 để quản lý tại Admin
    const genForm = document.getElementById('generalContactForm');
    if (genForm) {
      genForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const status = document.getElementById('contactFormStatus');
        const submitBtn = genForm.querySelector('button[type="submit"]');
        const studentName = document.getElementById('contactName')?.value?.trim() || '';
        const studentId = document.getElementById('contactStudentId')?.value?.trim() || '';
        const className = document.getElementById('contactClass')?.value?.trim() || '';
        const message = document.getElementById('contactMessage')?.value?.trim() || '';

        if (!studentName || !message) return;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = '⏳ Đang gửi...';
        }
        status.textContent = '⏳ Đang lưu thông điệp...';
        status.className = 'text-xs text-slate-600 font-semibold';

        try {
          const resp = await fetch('/api/surveys', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              survey_type: 'contact_message',
              student_name: studentName,
              student_id: studentId,
              class_name: className,
              answers: { message },
            }),
          });
          if (resp.ok) {
            status.textContent = '✅ Đã gửi tin nhắn thành công! Thông điệp đã được lưu để giảng viên xem và phản hồi.';
            status.className = 'text-xs text-emerald-700 font-bold';
            genForm.reset();
          } else {
            status.textContent = '⚠️ Có lỗi xảy ra khi gửi tin nhắn. Vui lòng thử lại!';
            status.className = 'text-xs text-rose-600 font-bold';
          }
        } catch (err) {
          status.textContent = '⚠️ Không thể kết nối máy chủ. Vui lòng thử lại!';
          status.className = 'text-xs text-rose-600 font-bold';
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Gửi Tin Nhắn';
          }
        }
      });
    }
  </script>
</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import EducationNewsSection from '../components/EducationNewsSection.astro';
import db, {
  getPageByPath,
  distributeBirthdayWishes,
  getVietnamDate,
  type BirthdayWish,
  type NewsArticle,
} from '../lib/db';
import {
  DEFAULT_STOCKS,
  DEFAULT_STOCK_NEWS,
  DEFAULT_MATCHES,
  DEFAULT_FOOTBALL_NEWS,
  DEFAULT_HCE_ADMISSIONS_NEWS,
  DEFAULT_HCE_CENTER_NEWS,
} from '../lib/live-feeds';

const pageData = getPageByPath('/');

let homeHtmlContent = pageData?.html_content || '';

// Phân tách homeHtmlContent thành 2 khối độc lập:
// 1. gocHocTapContent: chuyên mục học phần và công cụ học vụ
// 2. utilitiesContent: Lịch Vạn Niên Âm Dương & Sự kiện ngày lễ hôm nay
const demLichComment = '<!-- MỤC 5: LỊCH VẠN NIÊN ÂM - DƯƠNG & SỰ KIỆN -->';
const legacyComment = '<!-- MỤC 5: ĐẾM NGÀY TẾT - LỊCH VẠN NIÊN ÂM - DƯƠNG -->';

let splitIdx = homeHtmlContent.indexOf(demLichComment);
if (splitIdx === -1) {
  splitIdx = homeHtmlContent.indexOf(legacyComment);
}

let gocHocTapContent = '';
let utilitiesContent = '';

if (splitIdx !== -1) {
  gocHocTapContent = (homeHtmlContent.slice(0, splitIdx) + '\n  </div>\n</div>').replace(/\bpb-8\b/g, 'pb-0').replace(/\bspace-y-5\b/g, 'space-y-0');
  utilitiesContent = ('<div class="tkd-page-scope">\n  <div class="space-y-4">\n    ' + homeHtmlContent.slice(splitIdx))
    .replace(/\bpb-8\b/g, 'pb-0');
} else {
  gocHocTapContent = homeHtmlContent;
}

const allBirthdays = db
  .prepare('SELECT * FROM birthday_wishes WHERE is_active = 1 ORDER BY birth_month ASC, birth_day ASC')
  .all() as BirthdayWish[];

const latestNews = db
  .prepare('SELECT id, slug, title, category, summary, author, published_at, views FROM news_articles ORDER BY id DESC LIMIT 5')
  .all() as NewsArticle[];

const { year: currentYear, month: currentMonth, day: currentDay } = getVietnamDate();
distributeBirthdayWishes(currentYear, currentMonth, false);

const todayBirthdays = allBirthdays.filter(
  (b) => Number(b.birth_day) === currentDay && Number(b.birth_month) === currentMonth
);

// Tự động lọc danh sách sinh viên có ngày sinh trong tháng hiện tại (ưu tiên sinh nhật đúng hôm nay lên đầu)
const monthBirthdays = allBirthdays
  .filter((b) => Number(b.birth_month) === currentMonth)
  .sort((a, b) => {
    const aToday = Number(a.birth_day) === currentDay ? 0 : 1;
    const bToday = Number(b.birth_day) === currentDay ? 0 : 1;
    if (aToday !== bToday) return aToday - bToday;
    return Number(a.birth_day) - Number(b.birth_day);
  });

const birthdays = monthBirthdays.length > 0 ? monthBirthdays : allBirthdays;
const scrollDurationSec = Math.max(45, birthdays.length * 5.5);

// Duplicate birthday list when >= 3 items for seamless infinite vertical scroll
const scrollingBirthdays = birthdays.length >= 3 ? [...birthdays, ...birthdays] : birthdays;

const initialStocks = DEFAULT_STOCKS;
const initialStockNews = DEFAULT_STOCK_NEWS;
const initialMatches = DEFAULT_MATCHES;
const initialFootballNews = DEFAULT_FOOTBALL_NEWS;
const initialHceAdmissionsNews = DEFAULT_HCE_ADMISSIONS_NEWS;
const initialHceCenterNews = DEFAULT_HCE_CENTER_NEWS;
---

<MainLayout
  title="NGUYỄN THỊ TRÚC PHƯƠNG — Cổng Học Tập, Ngân Hàng Đề Thi - Tri Thức Số"
  description="Không gian chia sẻ bài giảng, ngân hàng đề thi thử trắc nghiệm trực tuyến (Marketing căn bản, Kinh tế vi mô, Khởi nghiệp), hướng dẫn SPSS và thực tập tốt nghiệp hoàn toàn miễn phí của NGUYỄN THỊ TRÚC PHƯƠNG."
  currentPath="/"
  customCss={pageData?.custom_css || ''}
>
  <main id="main-content" class="w-full space-y-4 sm:space-y-6 pb-0">
    <!-- ============================================================== -->
    <!-- KHU VỰC 2. BANNER VÀ GIỚI THIỆU                                 -->
    <!-- ============================================================== -->
    <header class="relative w-full overflow-hidden bg-gradient-to-r from-[#701824] via-[#8B1E2D] to-[#701824] text-white py-5 sm:py-6 px-4 text-center shadow-md border-b border-[#C62828]/40">
      <!-- Glow effect nền sinh động -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-12 left-1/4 w-72 h-36 bg-[#C62828]/20 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-10 right-1/4 w-80 h-36 bg-[#FCEEEF]/20 rounded-full blur-3xl"></div>
      </div>

      <div class="relative max-w-5xl mx-auto flex flex-col items-center justify-center">
        <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black uppercase tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-white via-[#FCEEEF] to-[#FFFFFF] drop-shadow-xs flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 m-0 leading-tight">
          <span>NGUYỄN THỊ TRÚC PHƯƠNG</span>
          <span class="inline-flex items-center px-3 py-0.5 rounded-full bg-[#C62828]/30 border border-[#FCEEEF]/60 shadow-xs">
            <span id="currentYear" class="js-current-year text-[#FCEEEF] font-extrabold tracking-normal">{currentYear}</span>
          </span>
        </h1>
      </div>
    </header>

    <!-- Main Top Container: Marquee & Thông điệp chia sẻ -->
    <section class="max-w-6xl mx-auto px-3 sm:px-6 space-y-4">
      <!-- Dải thông báo chạy (Marquee) -->
      <div class="w-full bg-[#8B1E2D] text-[#FCEEEF] text-xs sm:text-sm font-semibold py-2 px-4 rounded-full overflow-hidden shadow-xs flex items-center border border-[#C62828]/40">
        <div class="overflow-hidden w-full relative text-center">
          <span id="marquee" class="marquee-track">🌟 Chào mừng đến với website NGUYỄN THỊ TRÚC PHƯƠNG 🌟</span>
        </div>
      </div>

      <!-- Dòng chữ: Tài liệu được chia sẻ hoàn toàn miễn phí -->
      <div class="text-center py-0.5">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#FCEEEF] border border-[#E8E0E1] text-[#8B1E2D] text-xs sm:text-sm font-extrabold uppercase tracking-wider shadow-2xs">
          <span class="text-[#C62828]">✨</span>
          <span>Tài Liệu Được Chia Sẻ Hoàn Toàn Miễn Phí</span>
          <span class="text-[#C62828]">✨</span>
        </span>
      </div>

      <!-- Hành Trình Đồng Hành | Giảng Đường & Thực Tế -->
      <div class="bg-white rounded-2xl shadow-xs border border-[#E8E0E1] overflow-hidden">
        <div class="bg-[#8B1E2D] px-4 py-2.5 text-white flex items-center justify-between">
          <h2 class="font-bold text-xs sm:text-sm tracking-tight flex items-center gap-2 uppercase">
            <svg class="w-4 h-4 text-[#FCEEEF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span>Hành Trình Đồng Hành</span>
          </h2>
          <span class="text-xs bg-[#C62828] px-2.5 py-0.5 rounded-full text-white font-medium">Giảng Đường &amp; Thực Tế</span>
        </div>

        <div class="p-4 sm:p-5 space-y-3.5 text-xs sm:text-sm text-slate-800 leading-relaxed">
          <p class="text-slate-700 text-justify">
            Trên con đường <strong class="text-[#8B1E2D] font-bold">định hình tư duy và phát triển sự nghiệp</strong>, kiến thức sách vở là nền tảng khởi đầu vững chắc. Gắn bó nhiều năm cùng giảng đường và các thế hệ sinh viên ngành Quản trị, tôi thấu hiểu sâu sắc những bỡ ngỡ của các bạn khi bước đầu tiếp cận với tri thức chuyên ngành. Không gian này được tạo ra như một chiếc cầu nối tâm huyết, giúp đơn giản hóa lý thuyết và lan tỏa những trải nghiệm thực tế từ doanh nghiệp.
          </p>

          <div class="bg-gradient-to-r from-[#8B1E2D] via-[#C62828] to-[#8B1E2D] p-[1.5px] rounded-xl shadow-xs my-2">
            <div class="bg-[#FAF8F6] p-3.5 rounded-[10px] text-center">
              <p class="math-font italic font-bold text-[#8B1E2D] text-xs sm:text-base leading-snug">
                “Người thầy giỏi không chỉ dạy lý thuyết, họ mở ra cánh cửa thực tế và thắp sáng niềm tin cho học trò.”
              </p>
            </div>
          </div>

          <p class="text-slate-700 text-justify">
            Hy vọng những tài liệu và chia sẻ tại đây sẽ là bệ phóng nhỏ vững vàng, giúp các bạn tự tin hơn trên hành trình khẳng định bản thân.
          </p>

          <div class="bg-emerald-50 border-l-4 border-emerald-600 p-3 rounded-r-xl text-emerald-950 text-xs sm:text-sm flex items-start gap-2.5 shadow-2xs">
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="leading-normal">
              Toàn bộ tài liệu tại đây được chia sẻ <strong>hoàn toàn miễn phí</strong>, không vì mục đích kinh doanh, nhằm phục vụ tốt nhất cho việc học tập và nghiên cứu của bạn.
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- KHU VỰC 4. HỌC TẬP VÀ GÓC HỌC PHẦN                             -->
    <!-- ============================================================== -->
    <section id="goc-hoc-tap" class="scroll-mt-20">
      {gocHocTapContent && <div set:html={gocHocTapContent} />}
    </section>

    <!-- Khối Kiến Thức Nền Tảng - Hệ Sinh Thái Học Liệu Số (SSR SEO Authority) -->
    <section id="he-sinh-thai-hoc-lieu" class="max-w-6xl mx-auto px-3 sm:px-6 scroll-mt-20 space-y-4">
      <div class="bg-white rounded-2xl border border-[#E8E0E1] shadow-xs overflow-hidden">
        <div class="bg-gradient-to-r from-[#8B1E2D] via-[#701824] to-[#8B1E2D] px-5 py-3.5 text-white flex items-center justify-between">
          <h2 class="text-xs sm:text-sm font-extrabold uppercase tracking-wide m-0 flex items-center gap-2">
            <span>🎓</span>
            <span>Hệ Sinh Thái Học Liệu Số</span>
          </h2>
        </div>
        <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm text-slate-700 leading-relaxed">
          <article class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1.5 hover:bg-[#FCEEEF]/40 transition-colors">
            <h3 class="font-extrabold text-[#8B1E2D] text-sm m-0">1. Chuyên đề Kinh tế & Quản trị Chiến lược</h3>
            <p class="m-0 text-justify">
              Cung cấp trọn bộ đề cương chi tiết, bài giảng lý thuyết và hướng dẫn giải bài tập tính toán cho các học phần cốt lõi: <strong>Kinh tế vi mô</strong> (Cung - Cầu, độ co giãn, lý thuyết hành vi người tiêu dùng, chi phí sản xuất và cân bằng thị trường), <strong>Quản trị chiến lược</strong> (ma trận EFE, IFE, CPM, SWOT, BCG, IE, QSPM).
            </p>
          </article>
          <article class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1.5 hover:bg-[#FCEEEF]/40 transition-colors">
            <h3 class="font-extrabold text-[#8B1E2D] text-sm m-0">2. Chuyên đề Marketing & Khởi nghiệp</h3>
            <p class="m-0 text-justify">
              Tổng hợp hệ thống kiến thức hiện đại về <strong>Marketing căn bản</strong> (phân tích STP, chiến lược Marketing-mix 4P/7P, chu kỳ sống sản phẩm PLC), <strong>Truyền thông Marketing tích hợp (IMC)</strong> và <strong>Khởi nghiệp</strong> (lập dự án khởi nghiệp mẫu, mô hình kinh doanh Canvas, phân tích PEST và đánh giá năng lực doanh nhân PEC).
            </p>
          </article>
          <article class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1.5 hover:bg-[#FCEEEF]/40 transition-colors">
            <h3 class="font-extrabold text-[#8B1E2D] text-sm m-0">3. Thực tập Tốt nghiệp & Phân tích SPSS</h3>
            <p class="m-0 text-justify">
              Đồng hành cùng sinh viên năm cuối với cẩm nang <strong>Hướng dẫn thực tập tốt nghiệp</strong>, cổng tra cứu mã đề cương chi tiết, kho 19 bài báo cáo thực tập mẫu điểm cao, chuẩn trích dẫn tài liệu tham khảo cùng sổ tay <strong>xử lý dữ liệu khảo sát bằng phần mềm IBM SPSS</strong> (thống kê mô tả, Cronbach’s Alpha, EFA, tương quan Pearson và hồi quy tuyến tính).
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- KHU VỰC 5. LUYỆN TẬP                                           -->
    <!-- Đấu trường luyện thi trắc nghiệm trực tuyến                    -->
    <!-- ============================================================== -->
    <section id="luyen-tap-thi" class="max-w-6xl mx-auto px-3 sm:px-6 scroll-mt-20">
      <div class="bg-white rounded-2xl border border-sky-200 shadow-xs overflow-hidden">
        <div class="bg-gradient-to-r from-[#8B1E2D] via-[#C62828] to-[#8B1E2D] px-5 py-3.5 text-white flex flex-wrap items-center justify-between gap-2 border-b border-[#C62828]/40">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-xl bg-white/15 border border-white/25 flex items-center justify-center text-white text-base shadow-2xs">
              ⚔️
            </span>
            <div>
              <h2 class="font-extrabold text-xs sm:text-sm uppercase tracking-wide text-white m-0 leading-tight">
                Luyện Tập
              </h2>
              <p class="text-[11px] text-sky-100 font-medium m-0 hidden sm:block">
                Hệ thống thi trắc nghiệm trực tuyến
              </p>
            </div>
          </div>
          <a
            href="/ngan-hang-de-thi"
            title="Vào cổng thi online và làm bài trắc nghiệm ngay"
            class="inline-flex items-center gap-1.5 bg-[#C62828] hover:bg-[#8B1E2D] text-white font-black text-xs px-3.5 py-1.5 rounded-xl shadow-xs transition-all active:scale-95"
          >
            <span>Vào Làm Bài Thi</span>
            <span aria-hidden="true">➔</span>
          </a>
        </div>

        <div class="p-4 sm:p-5 space-y-4">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-2">
              Các môn thi trắc nghiệm trực tuyến sẵn sàng:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 text-xs">
              <a href="/ngan-hang-de-thi?subject=principles-of-marketing" class="p-2.5 rounded-xl bg-slate-50 hover:bg-[#FCEEEF] border border-[#E8E0E1] hover:border-[#C62828] transition-colors flex items-center gap-2 group">
                <span class="text-base shrink-0 group-hover:scale-110 transition-transform">📣</span>
                <span class="font-bold text-slate-800 group-hover:text-[#8B1E2D] leading-snug">Marketing căn bản</span>
              </a>
              <a href="/ngan-hang-de-thi?subject=microeconomics" class="p-2.5 rounded-xl bg-slate-50 hover:bg-[#FCEEEF] border border-[#E8E0E1] hover:border-[#C62828] transition-colors flex items-center gap-2 group">
                <span class="text-base shrink-0 group-hover:scale-110 transition-transform">📊</span>
                <span class="font-bold text-slate-800 group-hover:text-[#8B1E2D] leading-snug">Kinh tế vi mô</span>
              </a>
              <a href="/ngan-hang-de-thi?subject=entrepreneurship" class="p-2.5 rounded-xl bg-slate-50 hover:bg-[#FCEEEF] border border-[#E8E0E1] hover:border-[#C62828] transition-colors flex items-center gap-2 group">
                <span class="text-base shrink-0 group-hover:scale-110 transition-transform">🚀</span>
                <span class="font-bold text-slate-800 group-hover:text-[#8B1E2D] leading-snug">Khởi nghiệp</span>
              </a>
              <a href="/spss" class="p-2.5 rounded-xl bg-slate-50 hover:bg-[#FCEEEF] border border-[#E8E0E1] hover:border-[#C62828] transition-colors flex items-center gap-2 group">
                <span class="text-base shrink-0 group-hover:scale-110 transition-transform">💻</span>
                <span class="font-bold text-slate-800 group-hover:text-[#8B1E2D] leading-snug">Xử lý dữ liệu SPSS</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- KHU VỰC 6. TIN TỨC VÀ THÔNG TIN                                 -->
    <!-- Newsroom 6 đầu báo + Tuyển sinh HCE + Góc chia sẻ bài viết mới  -->
    <!-- ============================================================== -->
    <!-- 1. Chuyên mục Tin tức Giáo dục (Newsroom 6 đầu báo lớn) -->
    <div class="max-w-6xl mx-auto px-3 sm:px-6">
      <EducationNewsSection />
    </div>

    <!-- 2. Khối Tuyển sinh HCE kết hợp Góc Chia Sẻ (Bài Viết Mới) -->
    <section class="max-w-6xl mx-auto px-3 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
        <!-- Cột Trái: Thông Tin Tuyển Sinh HCE (7 cols) -->
        <div class="lg:col-span-7 bg-white rounded-2xl border border-sky-200 shadow-xs overflow-hidden flex flex-col">
          <div class="bg-gradient-to-r from-sky-800 via-sky-700 to-cyan-800 px-5 py-3.5 text-white flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-xs sm:text-sm font-extrabold uppercase tracking-wide flex items-center gap-2 m-0">
              <span aria-hidden="true">🎓</span>
              <span>Thông Tin Tuyển Sinh HCE</span>
            </h2>
          </div>

          <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
              <!-- Nhánh 1: Cao đẳng chính quy -->
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex flex-col justify-between space-y-2.5">
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2 border-b border-slate-200 pb-1.5">
                    <h3 class="font-extrabold text-sky-900 text-xs m-0 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-sky-600 shrink-0"></span>
                      <span>Chính Quy HCE</span>
                    </h3>
                    <a
                      href="https://www.kthcm.edu.vn/thong-tin-tuyen-sinh"
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Xem cổng tuyển sinh chính thức"
                      class="text-[11px] font-bold text-sky-700 hover:text-sky-900 hover:underline shrink-0"
                    >
                      Chi tiết →
                    </a>
                  </div>
                  <ul id="liveHceAdmissionsList" class="space-y-1.5 text-xs">
                    {initialHceAdmissionsNews.map((item) => (
                      <li class="p-2 rounded-lg bg-white hover:bg-sky-50/70 border border-slate-200/80 transition-colors shadow-2xs">
                        <a
                          href={item.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`Xem thông báo: ${item.title}`}
                          class="flex items-start justify-between gap-2 text-slate-800 hover:text-sky-800 font-semibold leading-snug"
                        >
                          <span class="line-clamp-2">{item.title}</span>
                          <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-100 text-sky-800 font-bold shrink-0 num-font">{item.timeText}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="pt-1 flex flex-wrap gap-1.5">
                  <a
                    href="https://www.kthcm.edu.vn/thong-tin-tuyen-sinh"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tkd-btn tkd-btn-sm tkd-btn-primary text-[11px] py-1 px-2.5"
                  >
                    Cổng Tuyển Sinh
                  </a>
                  <a
                    href="https://tuyensinh.kthcm.edu.vn/he-dang-ky-xet-tuyen.html"
                    target="_blank"

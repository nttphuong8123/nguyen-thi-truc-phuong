    function formatMd(md) {
      if (window.marked && typeof window.marked.parse === 'function') {
        try {
          if (typeof window.marked.setOptions === 'function') {
            window.marked.setOptions({ breaks: true, gfm: true });
          }
          return window.marked.parse(md);
        } catch (_) {}
      }
      return String(md || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
    }

    function setCharacter(char) {
      currentChar = char;
      const isToro = char === 'TORO';
      document.getElementById('twCharAvatar').textContent = isToro ? '👦' : '🎀';
      document.getElementById('twCharName').textContent = isToro ? 'TRỢ LÝ TORO' : 'TRỢ LÝ SUSI';
      const badge = document.getElementById('twCharBadge');
      if (badge) {
        badge.textContent = isToro ? 'Gen Z' : 'PlayTogether';
        badge.className = isToro
          ? 'hidden xs:inline-block text-[9px] font-black uppercase px-1.5 py-0.5 rounded-full bg-white/15 border border-white/25 text-sky-100 shrink-0'
          : 'hidden xs:inline-block text-[9px] font-black uppercase px-1.5 py-0.5 rounded-full bg-pink-500/30 border border-pink-300/40 text-pink-100 shrink-0';
      }
      btnToro.className = isToro
        ? 'px-2 py-1 rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 bg-white text-[#123B65] shadow-2xs cursor-pointer'
        : 'px-2 py-1 rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 text-sky-100/85 hover:text-white cursor-pointer';
      btnSusi.className = !isToro
        ? 'px-2 py-1 rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 bg-gradient-to-r from-pink-500 to-rose-500 text-white shadow-2xs cursor-pointer'
        : 'px-2 py-1 rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 text-sky-100/85 hover:text-white cursor-pointer';
    }

    function appendMsg(role, text, isErr) {
      const div = document.createElement('div');
      if (role === 'user') {
        div.className = 'flex justify-end';
        const isToro = currentChar === 'TORO';
        const userBg = isToro
          ? 'bg-gradient-to-r from-[#123B65] to-[#168AAD] text-white'
          : 'bg-gradient-to-r from-pink-500 to-rose-500 text-white';
        div.innerHTML = `<div class="${userBg} px-3.5 py-2.5 rounded-2xl rounded-tr-xs max-w-[85%] shadow-xs text-xs whitespace-pre-wrap break-words">${String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</div>`;
      } else {
        let finalText = String(text || '')
          .replace(/["“”']?\s*cây đa\s*,?\s*cây đề\s*["“”']?/gi, 'giảng viên')
          .replace(/(?:theo\s+)?danh\s+sách\s+188\s*(?:cán\s+bộ|cb[\s-]*gv[\s-]*nv|giảng\s+viên)[^.,;\n]*/gi, 'thông tin trên website nhà trường')
          .replace(/188\s*(?:cán\s+bộ|cb[\s-]*gv[\s-]*nv|giảng\s+viên)/gi, 'thông tin trên website nhà trường')
          .replace(/(?:mục\s+)?(?:google\s*drive|gg\s*drive|drive\.google\.com[^\s)]*)/gi, 'website học liệu https://nguyenthitrucphuong.com/')
          .trim();
        if (!isErr && !finalText.includes('Vì tôi là một AI nên có thể mắc sai sót khi trả lời')) {
          finalText += '\n\n*Vì tôi là một AI nên có thể mắc sai sót khi trả lời.*';
        }
        const isToro = currentChar === 'TORO';
        div.className = 'flex items-start gap-2 max-w-full';
        div.innerHTML = `
          <div class="w-7 h-7 rounded-xl bg-gradient-to-tr ${isToro ? 'from-[#123B65] to-[#168AAD]' : 'from-pink-500 to-rose-400'} text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 shadow-2xs">
            ${isToro ? '👦' : '🎀'}
          </div>
          <div class="${isErr ? 'bg-rose-50 border-rose-200 text-rose-800' : 'bg-white border-[#CBD5E1]/90 text-slate-800 shadow-xs'} border p-3 rounded-2xl rounded-tl-xs text-xs toro-chat-md min-w-0 flex-1">
            ${formatMd(finalText)}
          </div>
        `;
      }
      msgContainer.appendChild(div);
      msgContainer.scrollTo({ top: msgContainer.scrollHeight, behavior: 'smooth' });
    }



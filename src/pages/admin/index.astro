                      type="text"
                      id="qExplanationInput"
                      placeholder="VD: Vì theo công thức EOQ, chi phí tồn kho tối ưu khi..."
                      class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white"
                    />
                  </div>

                  <button
                    type="submit"
                    id="qSubmitBtn"
                    class="w-full py-2.5 rounded-xl bg-sky-700 hover:bg-sky-800 text-white font-extrabold shadow-xs cursor-pointer transition-colors"
                  >
                    💾 Lưu Câu Hỏi Vào Hệ Thống (D1)
                  </button>
                </form>

                <!-- Khung Import câu hỏi hàng loạt từ Excel (.xlsx, .xls, .csv) & File JSON (.json) -->
                <details class="p-4 rounded-2xl bg-emerald-50/60 border border-emerald-200 space-y-3 text-xs group">
                  <summary class="font-extrabold text-emerald-950 cursor-pointer flex items-center justify-between">
                    <span>📂 Import Hàng Loạt Câu Hỏi Từ File Excel (.xlsx, .csv) &amp; File JSON (.json)</span>
                    <span class="text-[11px] underline text-emerald-700">Mở ▼</span>
                  </summary>
                  <form id="bulkImportQuestionsForm" class="mt-3 space-y-2.5">
                    <div class="p-3 rounded-xl bg-white border border-dashed border-emerald-300 flex items-center justify-between gap-2">
                      <div>
                        <p class="font-bold text-emerald-950">Tải lên File JSON (.json) hoặc File Excel (.xlsx, .xls, .csv)</p>
                        <p id="quizExcelStatus" class="text-[11px] text-slate-500">
                          Hỗ trợ file JSON mảng câu hỏi hoặc file Excel 5-7 cột: Câu hỏi | A | B | C | D | Đáp án đúng | Chương
                        </p>
                      </div>
                      <label class="px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold cursor-pointer shrink-0">
                        <span>Chọn File</span>
                        <input type="file" id="quizExcelFileInput" accept=".json,.xlsx,.xls,.csv,.txt" class="hidden" />
                      </label>
                    </div>

                    <textarea
                      id="bulkQuizRawText"
                      rows="5"
                      required
                      placeholder={'Hoặc dán trực tiếp đoạn mã JSON hoặc nội dung từ Excel vào đây:\n[\n  {\n    "question": "Câu hỏi 1...",\n    "answers": ["A", "B", "C", "D"],\n    "correct": 0,\n    "chapter": 1\n  }\n]'}
                      class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white font-mono text-xs"
                    ></textarea>

                    <div class="flex items-center justify-between gap-2">
                      <label class="inline-flex items-center gap-1.5 font-semibold text-slate-700 cursor-pointer">
                        <input type="checkbox" id="bulkQuizReplaceAll" class="rounded text-rose-600" />
                        <span>Xóa câu cũ, thay bằng danh sách mới</span>
                      </label>
                      <button
                        type="submit"
                        class="px-4 py-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold cursor-pointer"
                      >
                        📥 Import Vào Bộ Đề
                      </button>
                    </div>
                  </form>
                </details>
              </div>

              <!-- Cột phải: Danh sách câu hỏi hiện có của bộ đề đang chọn -->
              <div class="lg:col-span-7 border border-slate-200 rounded-2xl overflow-hidden bg-white">
                <div class="p-3.5 bg-slate-100 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                  <div class="flex items-center gap-2">
                    <select
                      id="filterQuizChapterSelect"
                      class="px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-800"
                    >
                      <option value="all">Tất cả chương</option>
                      <option value="1">Chương 1</option>
                      <option value="2">Chương 2</option>
                      <option value="3">Chương 3</option>
                      <option value="4">Chương 4</option>
                      <option value="5">Chương 5</option>
                      <option value="6">Chương 6</option>
                    </select>
                    <input
                      type="text"
                      id="filterQuizKeywordInput"
                      placeholder="Tìm nội dung câu hỏi hoặc đáp án..."
                      class="w-full sm:w-64 px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs focus:outline-none focus:border-sky-600"
                    />
                  </div>
                  <span id="filteredQuizCountText" class="text-xs font-bold text-slate-600 shrink-0">
                    Đang hiển thị: 0 câu
                  </span>
                </div>

                <div id="quizQuestionsListContainer" class="divide-y divide-slate-100 max-h-[680px] overflow-y-auto p-3.5 space-y-3">
                  <p class="text-center text-slate-400 py-8 text-xs italic">Đang tải danh sách câu hỏi...</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- TAB 7: ĐÁNH GIÁ GIẢNG VIÊN & KHẢO SÁT SINH VIÊN (REQ-04 & REQ-05) -->
        <section id="tab-evaluations" class="admin-tab-panel hidden space-y-6">
          <!-- Top bar & export buttons -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="space-y-1">
              <h2 class="font-extrabold text-base sm:text-lg text-slate-900 flex items-center gap-2">
                <span>⭐</span>
                <span>Quản Lý Đánh Giá Giảng Viên &amp; Khảo Sát Ý Kiến Sinh Viên</span>
              </h2>
              <p class="text-xs text-slate-500">
                Chỉnh sửa bộ tiêu chí đánh giá, xem phản hồi học kỳ của sinh viên và xuất dữ liệu báo cáo ra Excel (.CSV)
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <a
                href="/api/evaluations?format=csv"
                class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs cursor-pointer shadow-2xs flex items-center gap-1.5"
              >
                <span>📥</span>
                <span>Xuất Excel Đánh Giá Giảng Viên (.CSV)</span>
              </a>
              <a
                href="/api/surveys?format=csv&type=nckh"
                class="px-3.5 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs cursor-pointer shadow-2xs flex items-center gap-1.5"
              >
                <span>📊</span>
                <span>Xuất Excel Khảo Sát NCKH (.CSV)</span>
              </a>
              <button
                type="button"
                id="clearAllEvalsBtn"
                class="px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs cursor-pointer"
              >
                Xóa Tất Cả Phiếu
              </button>
            </div>
          </div>

          <!-- KHỐI 1: CẤU HÌNH TIÊU CHÍ ĐÁNH GIÁ GIẢNG VIÊN (REQ-05) -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-extrabold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span>⚙️</span>
                  <span>Cấu Hình Tiêu Chí Đánh Giá Giảng Viên ({evalCriteria.length} tiêu chí Likert)</span>
                </h3>
                <p class="text-xs text-slate-700 mt-0.5">
                  Chỉnh sửa nội dung các câu hỏi đánh giá hiển thị trên form khảo sát tại trang /contact (lưu trữ trên Cloudflare D1)
                </p>
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="resetCriteriaBtn"
                  class="px-3 py-1.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold text-xs cursor-pointer"
                >
                  🔄 Khôi Phục 12 Tiêu Chí Gốc
                </button>
                <button
                  type="button"
                  id="addCriterionRowBtn"
                  class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 font-bold text-xs cursor-pointer"
                >
                  + Thêm Tiêu Chí
                </button>
              </div>
            </div>

            <!-- Bảng danh sách tiêu chí có thể chỉnh sửa trực tiếp -->
            <form id="evaluationCriteriaForm" class="space-y-3">
              <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse border border-slate-200 rounded-xl overflow-hidden">
                  <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-2.5 w-16 text-center">Mã</th>
                      <th class="p-2.5 w-24">Nhóm</th>
                      <th class="p-2.5 w-44">Tên Nhóm</th>
                      <th class="p-2.5">Nội dung Tiêu chí Đánh giá</th>
                      <th class="p-2.5 w-16 text-center">Xóa</th>
                    </tr>
                  </thead>
                  <tbody id="criteriaTableBody" class="divide-y divide-slate-100">
                    {evalCriteria.map((crit, idx) => (
                      <tr class="crit-row hover:bg-slate-50/80 transition-colors">
                        <td class="p-2 text-center font-bold text-slate-500">
                          <input
                            type="text"
                            name={`crit_code_${idx}`}
                            value={crit.code}
                            class="crit-code w-12 text-center font-mono font-bold bg-slate-50 border border-slate-200 rounded px-1 py-1"
                          />
                        </td>
                        <td class="p-2">
                          <select
                            name={`crit_group_${idx}`}
                            class="crit-group w-full bg-white border border-slate-200 rounded px-1.5 py-1 font-bold text-slate-700"
                          >
                            <option value="I" selected={crit.group === 'I'}>Nhóm I</option>
                            <option value="II" selected={crit.group === 'II'}>Nhóm II</option>
                            <option value="III" selected={crit.group === 'III'}>Nhóm III</option>
                            <option value="IV" selected={crit.group === 'IV'}>Nhóm IV</option>
                          </select>
                        </td>
                        <td class="p-2">
                          <input
                            type="text"
                            name={`crit_group_title_${idx}`}
                            value={crit.groupTitle}
                            placeholder="Tên nhóm tiêu chí..."
                            class="crit-group-title w-full bg-white border border-slate-200 rounded px-2 py-1 text-slate-700"
                          />
                        </td>
                        <td class="p-2">
                          <input
                            type="text"
                            name={`crit_text_${idx}`}
                            value={crit.text}
                            required
                            placeholder="Nhập nội dung tiêu chí..."
                            class="crit-text w-full bg-white border border-slate-200 rounded px-2.5 py-1 text-slate-900 font-medium"
                          />
                        </td>
                        <td class="p-2 text-center">
                          <button
                            type="button"
                            class="delete-crit-btn text-rose-600 hover:text-rose-800 font-bold p-1 cursor-pointer"
                            title="Xóa tiêu chí này"
                          >
                            ✕
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="flex justify-end pt-2">
                <button
                  type="submit"
                  id="saveCriteriaBtn"
                  class="px-5 py-2.5 rounded-xl bg-blue-700 hover:bg-blue-800 text-white font-extrabold text-xs cursor-pointer shadow-xs"
                >
                  💾 Lưu Toàn Bộ Tiêu Chí Lên Cloudflare D1
                </button>
              </div>
            </form>
          </div>

          <!-- KHỐI 2: DANH SÁCH PHIẾU ĐÁNH GIÁ GIẢNG VIÊN ĐÃ GỬI -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-extrabold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span>📋</span>
                  <span>Danh Sách Phiếu Đánh Giá Chất Lượng Giảng Viên ({evaluations.length} phiếu đã nhận)</span>
                </h3>
                <p class="text-xs text-slate-700 mt-0.5">
                  Dữ liệu được bảo mật danh tính sinh viên, lưu trữ vĩnh viễn trên Cloudflare D1
                </p>
              </div>
              <input
                type="text"
                id="searchEvalInput"
                placeholder="Tìm theo môn học, lớp, học kỳ..."
                class="w-full sm:w-64 px-3 py-1.5 rounded-xl border border-slate-300 text-xs"
              />
            </div>

            <div class="overflow-x-auto max-h-[500px]">
              <table class="w-full text-xs text-left border-collapse border border-slate-200 rounded-xl overflow-hidden">
                <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200 sticky top-0 z-10">
                  <tr>
                    <th class="p-2.5 w-12 text-center">ID</th>
                    <th class="p-2.5">Học kỳ / Niên khóa</th>
                    <th class="p-2.5">Môn học</th>
                    <th class="p-2.5">Mã lớp</th>
                    <th class="p-2.5 text-center">Điểm TB</th>
                    <th class="p-2.5">Hài lòng</th>
                    <th class="p-2.5 max-w-[180px]">Tâm đắc</th>
                    <th class="p-2.5 max-w-[180px]">Cần cải tiến</th>
                    <th class="p-2.5">Ngày nộp</th>
                    <th class="p-2.5 w-12 text-center">Xóa</th>
                  </tr>
                </thead>
                <tbody id="evaluationsTableBody" class="divide-y divide-slate-100">
                  {evaluations.length === 0 ? (
                    <tr>
                      <td colspan="10" class="py-8 text-center text-slate-400 italic">
                        Chưa có phiếu đánh giá giảng viên nào.
                      </td>
                    </tr>
                  ) : (
                    evaluations.map((ev) => (
                      <tr class="hover:bg-slate-50/80 transition-colors eval-row">
                        <td class="p-2.5 text-center font-bold text-slate-400">#{ev.id}</td>
                        <td class="p-2.5 font-semibold text-slate-800">{ev.semester}</td>
                        <td class="p-2.5 font-bold text-sky-800">{ev.course_name}</td>
                        <td class="p-2.5 font-mono text-slate-600">{ev.class_code || '—'}</td>
                        <td class="p-2.5 text-center">
                          <span class="inline-block px-2 py-0.5 rounded-full bg-blue-100 text-blue-900 font-extrabold text-xs">
                            {ev.average_score} / 5
                          </span>
                        </td>
                        <td class="p-2.5 font-medium text-emerald-700">{ev.overall_satisfaction}</td>
                        <td class="p-2.5 max-w-[180px] truncate text-slate-600" title={ev.what_liked || ''}>
                          {ev.what_liked || '—'}
                        </td>
                        <td class="p-2.5 max-w-[180px] truncate text-slate-600" title={ev.suggestions || ''}>
                          {ev.suggestions || '—'}
                        </td>
                        <td class="p-2.5 text-slate-400 text-[11px] whitespace-nowrap">{ev.submitted_at}</td>
                        <td class="p-2.5 text-center">
                          <button
                            type="button"
                            data-eval-id={ev.id}
                            class="delete-eval-btn text-rose-600 hover:text-rose-800 font-bold p-1 cursor-pointer"
                            title="Xóa phiếu này"
                          >
                            🗑️
                          </button>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>

          <!-- KHỐI 3: TIN NHẮN / THẮC MẮC LIÊN HỆ TỪ SINH VIÊN (/contact) -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-extrabold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span>✉️</span>
                  <span>Tin Nhắn / Thắc Mắc Nhanh Từ Sinh Viên ({contactMessages.length} tin nhắn)</span>
                </h3>
                <p class="text-xs text-slate-700 mt-0.5">
                  Dữ liệu gửi từ biểu mẫu "Gửi Tin Nhắn / Thắc Mắc Nhanh Đến Giảng Viên" tại trang /contact
                </p>
              </div>
              <div class="flex items-center gap-2">
                <a
                  href="/api/surveys?format=csv&type=contact_message"
                  class="px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs cursor-pointer shadow-2xs"
                >
                  📥 Xuất Tin Nhắn (Excel CSV)
                </a>
              </div>
            </div>
            {contactMessages.length === 0 ? (
              <div class="text-center py-8 text-slate-600 text-xs italic">
                ✉️ Chưa có tin nhắn / thắc mắc nào từ sinh viên.
              </div>
            ) : (
              <div class="overflow-x-auto max-h-96">
                <table class="w-full text-xs text-left border-collapse border border-slate-200 rounded-xl overflow-hidden">
                  <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-2.5 w-12 text-center">ID</th>
                      <th class="p-2.5">Họ tên</th>
                      <th class="p-2.5">Lớp / MSSV</th>
                      <th class="p-2.5">Email / Zalo</th>
                      <th class="p-2.5">Chủ đề</th>
                      <th class="p-2.5">Nội dung</th>
                      <th class="p-2.5">Ngày gửi</th>
                      <th class="p-2.5 w-12 text-center">Xóa</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {contactMessages.map((m) => {
                      let ans = {} as any;
                      try {
                        ans = JSON.parse(m.answers_json || '{}');
                      } catch {}
                      return (
                        <tr class="hover:bg-slate-50/80 transition-colors">
                          <td class="p-2.5 text-center font-bold text-slate-400">#{m.id}</td>
                          <td class="p-2.5 font-bold text-slate-900">{ans.full_name || '—'}</td>
                          <td class="p-2.5 text-slate-600">{ans.student_info || '—'}</td>
                          <td class="p-2.5 font-mono text-sky-700">{ans.email_or_phone || '—'}</td>
                          <td class="p-2.5 font-semibold text-slate-800">{ans.subject_topic || '—'}</td>
                          <td class="p-2.5 max-w-xs truncate text-slate-600" title={ans.message_content || ''}>
                            {ans.message_content || '—'}
                          </td>
                          <td class="p-2.5 text-slate-400 text-[11px] whitespace-nowrap">{m.submitted_at}</td>
                          <td class="p-2.5 text-center">
                            <button
                              type="button"
                              data-survey-id={m.id}
                              class="delete-survey-btn text-rose-600 hover:text-rose-800 font-bold p-1 cursor-pointer"
                              title="Xóa tin nhắn này"
                            >
                              🗑️
                            </button>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </div>

          <!-- KHỐI 4: DANH SÁCH KHẢO SÁT NCKH SINH VIÊN (/spss/nckhsv - REQ-04) -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-extrabold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span>🔬</span>
                  <span>Dữ Liệu Khảo Sát Nghiên Cứu Khoa Học Sinh Viên ({nckhSurveys.length} phản hồi)</span>
                </h3>
                <p class="text-xs text-slate-700 mt-0.5">
                  Dữ liệu phục vụ phân tích SPSS từ bảng câu hỏi tại /spss/nckhsv
                </p>
              </div>
              <div class="flex items-center gap-2">
                <a
                  href="/api/surveys?format=csv&type=nckh"
                  class="px-3.5 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs cursor-pointer shadow-2xs"
                >
                  📥 Tải File CSV Cho SPSS
                </a>
                {nckhSurveys.length > 0 && (
                  <button
                    type="button"
                    id="clearAllSurveysBtn"
                    class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs cursor-pointer"
                  >
                    🗑️ Xóa Tất Cả
                  </button>
                )}
              </div>
            </div>
            {nckhSurveys.length === 0 ? (
              <div class="text-center py-10 text-slate-600 text-xs italic">
                🌸 Chưa có sinh viên nào nộp khảo sát NCKH.
              </div>
            ) : (
              <div class="overflow-x-auto max-h-96">
                <table class="w-full text-xs text-left border-collapse border border-slate-200 rounded-xl overflow-hidden">
                  <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-2.5 w-12 text-center">ID</th>
                      <th class="p-2.5">Giới tính</th>
                      <th class="p-2.5">Năm học</th>
                      <th class="p-2.5">Khoa</th>
                      <th class="p-2.5">Dữ liệu JSON</th>
                      <th class="p-2.5">Ngày nộp</th>
                      <th class="p-2.5 w-12 text-center">Xóa</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {nckhSurveys.map((s) => (
                      <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-2.5 text-center font-bold text-slate-400">#{s.id}</td>
                        <td class="p-2.5 font-semibold text-slate-800">{s.gender || '—'}</td>
                        <td class="p-2.5 text-slate-600">{s.academic_year || '—'}</td>
                        <td class="p-2.5 text-slate-600">{s.faculty || '—'}</td>
                        <td class="p-2.5 max-w-xs truncate font-mono text-[11px] text-slate-500" title={s.answers_json}>
                          {s.answers_json}
                        </td>
                        <td class="p-2.5 text-slate-400 text-[11px] whitespace-nowrap">{s.submitted_at}</td>
                        <td class="p-2.5 text-center">
                          <button
                            type="button"
                            data-survey-id={s.id}
                            class="delete-survey-btn text-rose-600 hover:text-rose-800 font-bold p-1 cursor-pointer"
                            title="Xóa khảo sát này"
                          >
                            🗑️
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>
      
        <!-- TAB 9: LỊCH SỬ CÂU HỎI & CÂU TRẢ LỜI TRỢ LÝ AI (TỰ ĐỘNG XÓA TRONG 30 NGÀY) -->

      <!-- TAB 10: TÀI KHOẢN & PHÂN QUYỀN ADMIN (MODULE 10) -->
        <section id="tab-accounts" class="admin-tab-panel hidden space-y-6">
          <div class="bg-white p-5 rounded-2xl border border-purple-200 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
              <div>
                <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                  <span>👥</span> Quản Lý Tài Khoản Quản Trị &amp; Phân Quyền (Admin Role-Based Access)
                </h2>
                <p class="text-xs text-slate-700 mt-0.5">
                  Tạo tài khoản quản trị riêng biệt cho Trợ giảng, Thư ký hoặc Cộng tác viên. Mật khẩu được mã hóa SHA-256 an toàn, hoàn toàn độc lập với Production.
                </p>
              </div>
              {currentAdmin.role === 'super_admin' && (
                <button
                  type="button"
                  id="openAddAccountModalBtn"
                  class="inline-flex items-center gap-1.5 bg-purple-700 hover:bg-purple-800 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-xs transition-colors cursor-pointer"
                >
                  <span>➕</span>
                  <span>Tạo Tài Khoản Admin Mới</span>
                </button>
              )}
            </div>

            <!-- Bảng danh sách tài khoản -->
            <div class="overflow-x-auto rounded-xl border border-slate-200">
              <table class="w-full text-left border-collapse text-xs">
                <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
                  <tr>
                    <th class="p-3 w-12 text-center">ID</th>
                    <th class="p-3">Tài khoản &amp; Email</th>
                    <th class="p-3">Tên hiển thị</th>
                    <th class="p-3">Vai trò (Role)</th>
                    <th class="p-3">Quyền hạn (Permissions)</th>
                    <th class="p-3 text-center">Trạng thái</th>
                    <th class="p-3">Đăng nhập gần nhất</th>
                    <th class="p-3 text-center w-28">Thao tác</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-800">
                  {adminAccounts.map((acc) => {
                    let perms = [];
                    try { perms = JSON.parse(acc.permissions_json || '[]'); } catch {}
                    const isRoot = acc.id === 1;
                    return (
                      <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-3 text-center font-bold text-slate-400">#{acc.id}</td>
                        <td class="p-3">
                          <span class="font-mono font-bold text-purple-900 block">{acc.username}</span>
                          <span class="text-slate-500 text-[11px]">{acc.email || 'Chưa cập nhật email'}</span>
                        </td>
                        <td class="p-3 font-semibold text-slate-900">{acc.display_name}</td>
                        <td class="p-3">
                          <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold border ${
                            acc.role === 'super_admin' ? 'bg-purple-100 text-purple-900 border-purple-200' :
                            acc.role === 'editor' ? 'bg-sky-100 text-sky-900 border-sky-200' :
                            'bg-slate-100 text-slate-700 border-slate-200'
                          }`}>
                            {acc.role === 'super_admin' ? '👑 Super Admin' : acc.role === 'editor' ? '✍️ Editor' : '👁️ Viewer'}
                          </span>
                        </td>
                        <td class="p-3 max-w-xs truncate text-[11px] text-slate-600" title={perms.join(', ')}>
                          {perms.includes('all') ? '⭐ Toàn quyền (All)' : perms.join(', ')}
                        </td>
                        <td class="p-3 text-center">
                          {acc.is_active ? (
                            <span class="inline-block px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-emerald-100 text-emerald-800">Hoạt động</span>
                          ) : (
                            <span class="inline-block px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-rose-100 text-rose-800">Khóa</span>
                          )}
                        </td>
                        <td class="p-3 font-mono text-[11px] text-slate-500">{acc.last_login_at || 'Chưa đăng nhập'}</td>
                        <td class="p-3 text-center space-x-1.5 whitespace-nowrap">
                          {currentAdmin.role === 'super_admin' && (
                            <>
                              <button
                                type="button"
                                class="edit-acc-btn text-purple-700 hover:text-purple-900 font-bold text-xs p-1"
                                data-acc={JSON.stringify(acc)}
                                title="Chỉnh sửa thông tin"
                              >
                                ✏️ Sửa
                              </button>
                              {!isRoot && (
                                <button
                                  type="button"
                                  class="delete-acc-btn text-rose-600 hover:text-rose-800 font-bold text-xs p-1"
                                  data-acc-id={acc.id}
                                  data-acc-username={acc.username}
                                  title="Xóa tài khoản"
                                >
                                  🗑️ Xóa
                                </button>
                              )}
                            </>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                  {adminAccounts.length === 0 && (
                    <tr>
                      <td colspan="8" class="p-6 text-center text-slate-400 italic">Chưa có tài khoản quản trị nào trong database bản sao.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>

            <!-- Modal Thêm/Sửa Tài Khoản -->
            <div id="accountModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
              <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                  <h3 id="accountModalTitle" class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                    <span>➕</span> Thêm Tài Khoản Admin
                  </h3>
                  <button type="button" id="closeAccountModalBtn" class="text-slate-400 hover:text-slate-600 text-lg font-bold">✕</button>
                </div>
                <form id="accountUpsertForm" class="space-y-3.5">
                  <input type="hidden" id="accFormId" value="" />
                  <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tên đăng nhập (Username):</label>
                    <input type="text" id="accFormUsername" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 font-mono focus:border-purple-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tên hiển thị:</label>
                    <input type="text" id="accFormDisplayName" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:border-purple-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Email liên hệ:</label>
                    <input type="email" id="accFormEmail" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:border-purple-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Mật khẩu (để trống nếu không đổi):</label>
                    <input type="password" id="accFormPassword" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 font-mono focus:border-purple-600" placeholder="Tối thiểu 6 ký tự..." />
                  </div>
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="block text-xs font-bold text-slate-700 mb-1">Vai trò (Role):</label>
                      <select id="accFormRole" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 bg-white">
                        <option value="super_admin">👑 Super Admin</option>
                        <option value="editor">✍️ Editor</option>
                        <option value="viewer">👁️ Viewer</option>
                      </select>
                    </div>
                    <div>
                      <label class="block text-xs font-bold text-slate-700 mb-1">Trạng thái:</label>
                      <select id="accFormActive" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 bg-white">
                        <option value="1">Hoạt động</option>
                        <option value="0">Tạm khóa</option>
                      </select>
                    </div>
                  </div>
                  <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                    <button type="button" id="cancelAccountModalBtn" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Hủy</button>
                    <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-purple-700 hover:bg-purple-800 shadow-xs cursor-pointer">Lưu Tài Khoản</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>

        <!-- TAB 11: NHẬT KÝ HỆ THỐNG / AUDIT LOGS (MODULE 11) -->
        <section id="tab-audit-logs" class="admin-tab-panel hidden space-y-6">
          <div class="bg-white p-5 rounded-2xl border border-amber-200 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
              <div>
                <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                  <span>📜</span> Nhật Ký Thao Tác Hệ Thống (Audit Logs)
                </h2>
                <p class="text-xs text-slate-700 mt-0.5">
                  Ghi lại toàn bộ hành vi đăng nhập, thêm/sửa/xóa mã đề cương, bài viết, cập nhật cấu hình cổng truy cập trên môi trường nguyenthitrucphuong.
                </p>
              </div>
              {currentAdmin.role === 'super_admin' && (
                <button
                  type="button"
                  id="clearAuditLogsBtn"
                  class="inline-flex items-center gap-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs px-3.5 py-2 rounded-xl transition-colors cursor-pointer"
                >
                  <span>🗑️</span>
                  <span>Xóa Lịch Sử Nhật Ký</span>
                </button>
              )}
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-200">
              <table class="w-full text-left border-collapse text-xs">
                <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
                  <tr>
                    <th class="p-3 w-12 text-center">ID</th>
                    <th class="p-3">Thời gian</th>
                    <th class="p-3">Người thao tác</th>
                    <th class="p-3">Hành động</th>
                    <th class="p-3">Phân hệ</th>
                    <th class="p-3">Chi tiết</th>
                    <th class="p-3 font-mono">Địa chỉ IP</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-800">
                  {auditLogs.map((log) => (
                    <tr class="hover:bg-slate-50/80 transition-colors">
                      <td class="p-3 text-center font-bold text-slate-400">#{log.id}</td>
                      <td class="p-3 whitespace-nowrap font-mono text-[11px] text-slate-500">{log.created_at}</td>
                      <td class="p-3">
                        <span class="font-bold text-purple-900 font-mono">{log.actor_username}</span>
                        <span class="text-[10px] text-slate-400 block uppercase">({log.actor_role})</span>
                      </td>
                      <td class="p-3">
                        <span class={`inline-block px-2 py-0.5 rounded font-mono font-bold text-[10.5px] ${
                          log.action_type.includes('DELETE') ? 'bg-rose-100 text-rose-800' :
                          log.action_type.includes('ADD') || log.action_type.includes('CREATE') ? 'bg-emerald-100 text-emerald-800' :
                          log.action_type.includes('LOGIN') ? 'bg-sky-100 text-sky-800' :
                          'bg-amber-100 text-amber-800'
                        }`}>
                          {log.action_type}
                        </span>
                      </td>
                      <td class="p-3 font-bold text-slate-700">{log.target_module}</td>
                      <td class="p-3 text-slate-600 max-w-sm truncate" title={log.details}>{log.details}</td>
                      <td class="p-3 font-mono text-[11px] text-slate-500">{log.ip_address || '—'}</td>
                    </tr>
                  ))}
                  {auditLogs.length === 0 && (
                    <tr>
                      <td colspan="7" class="p-6 text-center text-slate-400 italic">Chưa có nhật ký ghi nhận trong hệ thống.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </section>
        </main>
    )
  }

  <script is:inline>
    // Login form
    const loginForm = document.getElementById('adminLoginForm');
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pass = document.getElementById('adminPass').value.trim();
        const errEl = document.getElementById('adminLoginErr');
        errEl.classList.add('hidden');
        const resp = await fetch('/api/auth/unlock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ gate_key: 'admin', passcode: pass }),
        });
        const data = await resp.json();
        if (resp.ok && data.ok) {
          window.location.reload();
        } else {
          errEl.textContent = data.message || 'Mật khẩu không đúng!';
          errEl.classList.remove('hidden');
        }
      });
    }

    // Logout
    const logoutBtn = document.getElementById('adminLogoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        await fetch('/api/auth/lock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ gate_key: 'admin' }),
        });
        window.location.reload();
      });
    }

    // Tabs switching with persistence
    const tabBtns = document.querySelectorAll('.admin-tab-btn');
    const tabPanels = document.querySelectorAll('.admin-tab-panel');

    function activateAdminTab(target) {
      if (!target) return;
      let matched = false;
      tabBtns.forEach((b) => {
        const isMatch = b.getAttribute('data-tab') === target;
        if (isMatch) matched = true;
        b.className = isMatch
          ? 'admin-tab-btn bg-sky-700 text-white font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl cursor-pointer transition-colors'
          : 'admin-tab-btn bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 cursor-pointer transition-colors';
      });
      if (matched) {
        tabPanels.forEach((p) => {
          p.classList.toggle('hidden', p.id !== target);
        });
        try {
          sessionStorage.setItem('adminActiveTab', target);
        } catch {}
      }
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        activateAdminTab(target);
      });
    });

    try {
      const savedTab = sessionStorage.getItem('adminActiveTab') || (window.location.hash ? window.location.hash.substring(1) : '');
      if (savedTab && document.getElementById(savedTab)) {
        activateAdminTab(savedTab);
      }
    } catch {}

    // Filter submissions
    const filterSubInput = document.getElementById('filterSubmissionInput');
    if (filterSubInput) {
      filterSubInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        document.querySelectorAll('.submission-row').forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          row.style.display = !q || hay.includes(q) ? '' : 'none';
        });
      });
    }

    // Delete submission
    document.querySelectorAll('.del-sub-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-del-sub');
        if (!confirm('Xóa bản ghi điểm này?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_submission', id }),
        });
        if (resp.ok) window.location.reload();
      });
    });

    // Clear all submissions
    const clearAllSubsBtn = document.getElementById('clearAllSubsBtn');
    if (clearAllSubsBtn) {
      clearAllSubsBtn.addEventListener('click', async () => {
        if (!confirm('Bạn có chắc chắn muốn XÓA TOÀN BỘ lịch sử bảng điểm sinh viên không? (Hãy tải file Excel CSV trước khi xóa)')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clear_all_submissions' }),
        });
        if (resp.ok) window.location.reload();
      });
    }

    // Save Site Contact Config (Tab 2)
    const siteContactConfigForm = document.getElementById('siteContactConfigForm');
    if (siteContactConfigForm) {
      siteContactConfigForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save_site_contact_config',
            instructor_name: document.getElementById('cfgInstructorName')?.value?.trim(),
            department: document.getElementById('cfgDepartment')?.value?.trim(),
            email: document.getElementById('cfgEmail')?.value?.trim(),
            hotline: document.getElementById('cfgHotline')?.value?.trim(),
            zalo_url: document.getElementById('cfgZaloUrl')?.value?.trim(),
            address: document.getElementById('cfgAddress')?.value?.trim(),
            youtube_url: document.getElementById('cfgYoutubeUrl')?.value?.trim(),
            tiktok_url: document.getElementById('cfgTiktokUrl')?.value?.trim(),
            office_hours: document.getElementById('cfgOfficeHours')?.value?.trim(),
          }),
        });
        const data = await resp.json();
        alert(data.message || (resp.ok ? 'Đã lưu cấu hình thông tin liên hệ!' : 'Lỗi khi lưu!'));
        if (resp.ok) window.location.reload();
      });
    }

    // Filter pages (Tab 4) & Edit Page Modal
    const filterPageInput = document.getElementById('filterPageInput');
    if (filterPageInput) {
      filterPageInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        document.querySelectorAll('.page-row').forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          row.style.display = !q || hay.includes(q) ? '' : 'none';
        });
      });
    }

    const editPageModal = document.getElementById('editPageModal');
    const closePageModal = () => editPageModal && editPageModal.classList.add('hidden');
    const closePageModalBtn = document.getElementById('closePageModalBtn');
    const cancelPageModalBtn = document.getElementById('cancelPageModalBtn');
    if (closePageModalBtn) closePageModalBtn.addEventListener('click', closePageModal);
    if (cancelPageModalBtn) cancelPageModalBtn.addEventListener('click', closePageModal);

    document.querySelectorAll('.edit-page-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const routePath = btn.getAttribute('data-edit-page');
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'get_page', route_path: routePath }),
        });
        const data = await resp.json();
        if (!resp.ok || !data.ok) {
          alert(data.message || 'Không tải được dữ liệu trang!');
          return;
        }
        document.getElementById('modalPageRoute').value = data.page.route_path;
        document.getElementById('modalPageRouteLabel').textContent = data.page.route_path;
        document.getElementById('modalPageTitle').value = data.page.title || '';
        document.getElementById('modalPageHtml').value = data.page.html_content || '';
        document.getElementById('modalPageCss').value = data.page.custom_css || '';
        document.getElementById('modalPageJs').value = data.page.custom_js || '';
        editPageModal.classList.remove('hidden');
      });
    });

    const savePageModalForm = document.getElementById('savePageModalForm');
    if (savePageModalForm) {
      savePageModalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'update_page',
            route_path: document.getElementById('modalPageRoute').value,
            title: document.getElementById('modalPageTitle').value.trim(),
            html_content: document.getElementById('modalPageHtml').value,
            custom_css: document.getElementById('modalPageCss').value,
            custom_js: document.getElementById('modalPageJs').value,
          }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã lưu!');
        if (resp.ok && data.ok) window.location.reload();
      });
    }

    // =========================================================================
    // SOẠN THẢO VÀ THÊM GIÁO TRÌNH MỚI (CHUẨN SƯ PHẠM & SEO TỰ ĐỘNG)
    // =========================================================================
    
    function slugifyVietnamese(str) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .trim();
    }


    const addTextbookModal = document.getElementById('addTextbookModal');
    const openAddTextbookBtn = document.getElementById('openAddTextbookBtn');
    const closeAddTextbookModalBtn = document.getElementById('closeAddTextbookModalBtn');
    const cancelAddTextbookBtn = document.getElementById('cancelAddTextbookBtn');
    const saveTextbookForm = document.getElementById('saveTextbookForm');
    const tbTitleInput = document.getElementById('tbTitle');
    const tbSlugInput = document.getElementById('tbSlug');
    const chaptersContainer = document.getElementById('chaptersListContainer');
    const addNewChapterBtn = document.getElementById('addNewChapterBtn');
    const modeBuilderBtn = document.getElementById('modeBuilderBtn');
    const modeRawBtn = document.getElementById('modeRawBtn');
    const sectionBuilderWrapper = document.getElementById('sectionBuilderWrapper');
    const sectionRawWrapper = document.getElementById('sectionRawWrapper');
    const triggerParseRawBtn = document.getElementById('triggerParseRawBtn');
    const tbRawTextarea = document.getElementById('tbRawTextarea');

    let textbookChapters = [];

    function openTextbookModal() {
      if (!addTextbookModal) return;
      if (textbookChapters.length === 0) {
        textbookChapters = [
          {
            title: 'Tổng Quan Về Môn Học',
            description: 'Khái niệm, bản chất, vai trò và phạm vi ứng dụng thực tiễn.',
            objectives: ['Nắm vững định nghĩa cốt lõi và các nguyên lý cơ bản', 'Phân tích các yếu tố tác động đến hoạt động quản trị'],
            sections: [
              { number: '1.1', title: 'Khái niệm và bản chất', content: 'Trình bày định nghĩa cơ bản và phạm vi nghiên cứu của học phần...' },
              { number: '1.2', title: 'Vai trò và mục tiêu', content: 'Phân tích tầm quan trọng đối với hoạt động của doanh nghiệp hiện đại...' }
            ]
          }
        ];
      }
      renderChapterList();
      addTextbookModal.classList.remove('hidden');
    }

    function closeTextbookModal() {
      if (addTextbookModal) addTextbookModal.classList.add('hidden');
    }

    openAddTextbookBtn?.addEventListener('click', openTextbookModal);
    closeAddTextbookModalBtn?.addEventListener('click', closeTextbookModal);
    cancelAddTextbookBtn?.addEventListener('click', closeTextbookModal);

    // Auto-generate slug when typing textbook title
    tbTitleInput?.addEventListener('input', () => {
      const clean = tbTitleInput.value.trim().replace(/^giáo trình\s+/i, '');
      const s = slugifyVietnamese(clean);
      if (s) {
        tbSlugInput.value = '/study-corner/' + s;
      }
    });


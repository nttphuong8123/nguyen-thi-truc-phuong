        .replace(/"/g, '&quot;');
    }

    // 1. Online Exam Config Form (/ngan-hang-de-thi)
    const onlineModesContainer = document.getElementById('onlineModesListContainer');
    const addOnlineModeRowBtn = document.getElementById('addOnlineModeRowBtn');

    function bindDelOnlineModeBtns() {
      document.querySelectorAll('.del-online-mode-btn').forEach((btn) => {
        btn.onclick = () => {
          const rows = document.querySelectorAll('.online-mode-row');
          if (rows.length <= 1) {
            alert('Phải giữ lại ít nhất 1 chế độ thi!');
            return;
          }
          btn.closest('.online-mode-row')?.remove();
        };
      });
    }
    bindDelOnlineModeBtns();

    if (addOnlineModeRowBtn && onlineModesContainer) {
      addOnlineModeRowBtn.addEventListener('click', () => {
        const div = document.createElement('div');
        div.className = 'online-mode-row grid grid-cols-1 sm:grid-cols-12 gap-2 items-center';
        div.innerHTML = `
          <div class="sm:col-span-2 flex items-center gap-1.5">
            <span class="text-slate-500 shrink-0">Số câu:</span>
            <input type="number" min="1" max="200" value="30" class="mode-count-inp w-full px-2.5 py-1.5 rounded-lg border border-slate-300 num-font font-bold bg-white" />
          </div>
          <div class="sm:col-span-2 flex items-center gap-1.5">
            <span class="text-slate-500 shrink-0">Phút:</span>
            <input type="number" min="1" max="300" value="45" class="mode-min-inp w-full px-2.5 py-1.5 rounded-lg border border-slate-300 num-font font-bold bg-white" />
          </div>
          <div class="sm:col-span-7">
            <input type="text" value="Đề thi tùy chỉnh (30 câu — 45 phút)" class="mode-label-inp w-full px-3 py-1.5 rounded-lg border border-slate-300 font-semibold bg-white" />
          </div>
          <div class="sm:col-span-1 text-right">
            <button type="button" class="del-online-mode-btn text-rose-600 hover:underline font-bold cursor-pointer">Xóa</button>
          </div>
        `;
        onlineModesContainer.appendChild(div);
        bindDelOnlineModeBtns();
      });
    }

    const saveOnlineExamConfigForm = document.getElementById('saveOnlineExamConfigForm');
    if (saveOnlineExamConfigForm) {
      saveOnlineExamConfigForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const modes = [];
        document.querySelectorAll('.online-mode-row').forEach((row) => {
          const count = Number(row.querySelector('.mode-count-inp')?.value || 10);
          const minutes = Number(row.querySelector('.mode-min-inp')?.value || 15);
          const label = row.querySelector('.mode-label-inp')?.value.trim() || `${count} câu — ${minutes} phút`;
          modes.push({ count, minutes, label });
        });

        const subjectsMeta = [];
        document.querySelectorAll('.online-sub-meta-row').forEach((row) => {
          const key = row.getAttribute('data-sub-key');
          const enabled = Boolean(row.querySelector('.sub-enabled-chk')?.checked);
          const label = row.querySelector('.sub-label-inp')?.value.trim() || '';
          const linkedChk = row.querySelector('.sub-linked-chk');
          subjectsMeta.push({
            key,
            enabled,
            label,
            use_linked_bank: linkedChk ? Boolean(linkedChk.checked) : undefined,
          });
        });

        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save_online_exam_config',
            header_badge: document.getElementById('cfgHeaderBadge')?.value.trim(),
            header_title: document.getElementById('cfgHeaderTitle')?.value.trim(),
            header_subtitle: document.getElementById('cfgHeaderSubtitle')?.value.trim(),
            step1_title: document.getElementById('cfgStep1Title')?.value.trim(),
            show_detailed_answers: Boolean(document.getElementById('cfgShowDetailedAnswers')?.checked),
            modes,
            subjects_meta: subjectsMeta,
          }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã lưu cấu hình!');
      });
    }

    // 2. Visual Question Bank & Chapter Modes Editor
    const quizTargetSelect = document.getElementById('quizTargetSelect');
    const activeQuizCountBadge = document.getElementById('activeQuizCountBadge');
    const openActiveQuizPageLink = document.getElementById('openActiveQuizPageLink');
    const syncFromLinkedCourseBtn = document.getElementById('syncFromLinkedCourseBtn');
    const quizModesEditorPanel = document.getElementById('quizModesEditorPanel');
    const quizModesInputsContainer = document.getElementById('quizModesInputsContainer');
    const saveQuizModesBtn = document.getElementById('saveQuizModesBtn');
    const quizQuestionsListContainer = document.getElementById('quizQuestionsListContainer');
    const filterQuizChapterSelect = document.getElementById('filterQuizChapterSelect');
    const filterQuizKeywordInput = document.getElementById('filterQuizKeywordInput');
    const filteredQuizCountText = document.getElementById('filteredQuizCountText');

    let currentTargetId = '';
    let currentRoutePath = '';
    let currentSubjectKey = '';
    let currentQuestions = [];
    let currentModes = [];

    async function loadQuizTarget(targetId) {
      if (!targetId) return;
      currentTargetId = targetId;
      if (quizQuestionsListContainer) {
        quizQuestionsListContainer.innerHTML =
          '<p class="text-center text-slate-400 py-8 text-xs italic">⏳ Đang tải bộ câu hỏi từ hệ thống...</p>';
      }

      const resp = await fetch('/api/admin/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'get_quiz_target', target_id: targetId }),
      });
      const data = await resp.json();
      if (!resp.ok || !data.ok) {
        alert(data.message || 'Không tải được bộ đề!');
        return;
      }

      currentQuestions = Array.isArray(data.questions) ? data.questions : [];
      currentModes = Array.isArray(data.modes) ? data.modes : [];

      if (activeQuizCountBadge) {
        activeQuizCountBadge.textContent = String(currentQuestions.length);
      }

      if (data.group === 'online') {
        currentSubjectKey = data.subject.key;
        currentRoutePath = `/ngan-hang-de-thi?subject=${data.subject.key}`;
        if (openActiveQuizPageLink) openActiveQuizPageLink.href = currentRoutePath;
        if (quizModesEditorPanel) quizModesEditorPanel.classList.add('hidden');
        if (syncFromLinkedCourseBtn) {
          if (data.subject.linked_route && data.linked_count > 0) {
            syncFromLinkedCourseBtn.classList.remove('hidden');
            syncFromLinkedCourseBtn.textContent = `🔄 Đồng bộ ${data.linked_count} câu từ Kho Học Phần (${data.subject.linked_route.split('/').pop()})`;
          } else {
            syncFromLinkedCourseBtn.classList.add('hidden');
          }
        }
      } else {
        currentSubjectKey = '';
        currentRoutePath = data.route_path;
        if (openActiveQuizPageLink) openActiveQuizPageLink.href = currentRoutePath;
        if (syncFromLinkedCourseBtn) syncFromLinkedCourseBtn.classList.add('hidden');
        renderQuizModesEditor();
      }

      resetQuestionEditorForm();
      renderQuizQuestionsList();
    }

    function renderQuizModesEditor() {
      if (!quizModesEditorPanel || !quizModesInputsContainer) return;
      if (!currentModes || currentModes.length === 0) {
        quizModesEditorPanel.classList.add('hidden');
        return;
      }
      quizModesEditorPanel.classList.remove('hidden');
      quizModesInputsContainer.innerHTML = currentModes
        .map(
          (m, idx) => `
        <div class="quiz-mode-card-row p-3 rounded-xl bg-white border border-amber-200 space-y-1.5" data-mode-idx="${idx}" data-mode-val="${escHtml(m.value)}">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold">Ô chọn #${idx + 1} (${escHtml(m.value)})</span>
            <input
              type="text"
              value="${escHtml(m.badge || '')}"
              placeholder="Badge điểm (VD: 5đ/câu)"
              class="qm-badge-inp w-36 px-2 py-1 rounded-lg border border-slate-200 text-[11px] font-semibold text-right"
            />
          </div>
          <input
            type="text"
            value="${escHtml(m.title)}"
            placeholder="Tiêu đề (VD: 📘 Ôn tập chương 1)"
            class="qm-title-inp w-full px-2.5 py-1.5 rounded-lg border border-slate-300 font-extrabold text-slate-900"
          />
          <input
            type="text"
            value="${escHtml(m.desc)}"
            placeholder="Mô tả (VD: Đề thi 20 câu • 30 phút • 5đ/câu)"
            class="qm-desc-inp w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-slate-700"
          />
        </div>
      `
        )
        .join('');
    }

    if (saveQuizModesBtn) {
      saveQuizModesBtn.addEventListener('click', async () => {
        if (!currentRoutePath) return;
        const updated = [];
        document.querySelectorAll('.quiz-mode-card-row').forEach((row) => {
          const index = Number(row.getAttribute('data-mode-idx') || 0);
          const value = row.getAttribute('data-mode-val') || '';
          const title = row.querySelector('.qm-title-inp')?.value.trim() || '';
          const desc = row.querySelector('.qm-desc-inp')?.value.trim() || '';
          const badge = row.querySelector('.qm-badge-inp')?.value.trim() || '';
          updated.push({ index, value, title, desc, badge });
        });

        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save_quiz_modes',
            route_path: currentRoutePath,
            modes: updated,
          }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã lưu khung chọn chương!');
      });
    }

    function renderQuizQuestionsList() {
      if (!quizQuestionsListContainer) return;
      const chapFilter = filterQuizChapterSelect ? filterQuizChapterSelect.value : 'all';
      const kw = filterQuizKeywordInput ? filterQuizKeywordInput.value.trim().toLowerCase() : '';

      const filtered = [];
      currentQuestions.forEach((q, realIdx) => {
        const qChap = String(q.chapter || 1);
        if (chapFilter !== 'all' && qChap !== chapFilter) return;
        if (kw) {
          const hay = `${q.question} ${(q.answers || []).join(' ')} ${q.explanation || ''}`.toLowerCase();
          if (!hay.includes(kw)) return;
        }
        filtered.push({ q, realIdx });
      });

      if (filteredQuizCountText) {
        filteredQuizCountText.textContent = `Đang hiển thị: ${filtered.length} / ${currentQuestions.length} câu`;
      }

      if (filtered.length === 0) {
        quizQuestionsListContainer.innerHTML =
          '<p class="text-center text-slate-400 py-8 text-xs italic">Không có câu hỏi nào khớp với bộ lọc hiện tại.</p>';
        return;
      }

      // Render up to 150 items at once for fast DOM responsiveness
      const displaySlice = filtered.slice(0, 150);
      quizQuestionsListContainer.innerHTML = displaySlice
        .map(({ q, realIdx }, idx) => {
          const ansList = Array.isArray(q.answers) ? q.answers : [];
          const correctIdx = Number(q.correct) || 0;
          return `
            <div class="pt-3 first:pt-0 space-y-2 text-xs">
              <div class="flex items-start justify-between gap-2">
                <div class="space-y-1">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded bg-sky-100 text-sky-900 font-extrabold num-font">Câu #${realIdx + 1}</span>
                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-bold">Chương ${q.chapter || 1}</span>
                    ${q.difficulty ? `<span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-semibold">${escHtml(q.difficulty)}</span>` : ''}
                  </div>
                  <p class="font-bold text-slate-900 text-xs sm:text-sm leading-snug">${escHtml(q.question)}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    data-edit-q-idx="${realIdx}"
                    class="edit-q-item-btn px-2.5 py-1 rounded-lg bg-sky-50 hover:bg-sky-100 text-sky-700 font-bold cursor-pointer"
                  >
                    ✏️ Sửa
                  </button>
                  <button
                    type="button"
                    data-del-q-idx="${realIdx}"
                    class="del-q-item-btn px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold cursor-pointer"
                  >
                    🗑️ Xóa
                  </button>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pl-1">
                ${ansList
                  .map(
                    (ansText, aIdx) => `
                  <div class="px-2.5 py-1.5 rounded-lg border ${
                    aIdx === correctIdx
                      ? 'bg-emerald-50 border-emerald-300 text-emerald-900 font-bold'
                      : 'bg-slate-50/70 border-slate-200 text-slate-600'
                  }">
                    <strong>${String.fromCharCode(65 + aIdx)}.</strong> ${escHtml(ansText)}
                    ${aIdx === correctIdx ? ' <span class="text-emerald-700">✓ (Đúng)</span>' : ''}
                  </div>
                `
                  )
                  .join('')}
              </div>
              ${
                q.explanation
                  ? `<p class="text-[11px] text-slate-500 italic bg-slate-50 px-2.5 py-1 rounded-lg">💡 Giải thích: ${escHtml(q.explanation)}</p>`
                  : ''
              }
            </div>
          `;
        })
        .join('');

      // Bind Edit & Delete handlers
      quizQuestionsListContainer.querySelectorAll('.edit-q-item-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rIdx = Number(btn.getAttribute('data-edit-q-idx'));
          const item = currentQuestions[rIdx];
          if (!item) return;
          document.getElementById('editQuestionIndex').value = String(rIdx);
          document.getElementById('qInputText').value = item.question || '';
          document.getElementById('qOptA').value = item.answers?.[0] || '';
          document.getElementById('qOptB').value = item.answers?.[1] || '';
          document.getElementById('qOptC').value = item.answers?.[2] || '';
          document.getElementById('qOptD').value = item.answers?.[3] || '';
          document.getElementById('qCorrectSelect').value = String(item.correct ?? 0);
          document.getElementById('qChapterSelect').value = String(item.chapter || 1);
          document.getElementById('qDifficultySelect').value = item.difficulty || 'Trung bình';
          document.getElementById('qExplanationInput').value = item.explanation || '';
          document.getElementById('questionFormHeader').textContent = `✏️ Đang Sửa Câu Hỏi #${rIdx + 1}`;
          document.getElementById('qSubmitBtn').textContent = `💾 Cập Nhật Câu Hỏi #${rIdx + 1}`;
          document.getElementById('cancelEditQuestionBtn')?.classList.remove('hidden');
          document.getElementById('qInputText').focus();
        });
      });

      quizQuestionsListContainer.querySelectorAll('.del-q-item-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const rIdx = Number(btn.getAttribute('data-del-q-idx'));
          if (!confirm(`Bạn có chắc muốn xóa Câu hỏi #${rIdx + 1} không?`)) return;
          currentQuestions.splice(rIdx, 1);
          await persistCurrentQuestions();
        });
      });
    }

    function resetQuestionEditorForm() {
      const form = document.getElementById('singleQuestionEditorForm');
      if (form) form.reset();
      const idxInp = document.getElementById('editQuestionIndex');
      if (idxInp) idxInp.value = '-1';
      const header = document.getElementById('questionFormHeader');
      if (header) header.textContent = '➕ Thêm Câu Hỏi Trắc Nghiệm Mới';
      const subBtn = document.getElementById('qSubmitBtn');
      if (subBtn) subBtn.textContent = '💾 Lưu Câu Hỏi Vào Hệ Thống (D1)';
      document.getElementById('cancelEditQuestionBtn')?.classList.add('hidden');
    }

    document.getElementById('cancelEditQuestionBtn')?.addEventListener('click', resetQuestionEditorForm);

    async function persistCurrentQuestions() {
      const resp = await fetch('/api/admin/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'save_quiz_questions',
          target_id: currentTargetId,
          questions: currentQuestions,
        }),
      });
      const data = await resp.json();
      if (!resp.ok || !data.ok) {
        alert(data.message || 'Lỗi khi lưu câu hỏi!');
        return false;
      }
      if (activeQuizCountBadge) activeQuizCountBadge.textContent = String(currentQuestions.length);
      renderQuizQuestionsList();
      return true;
    }

    const singleQuestionEditorForm = document.getElementById('singleQuestionEditorForm');
    if (singleQuestionEditorForm) {
      singleQuestionEditorForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const editIdx = Number(document.getElementById('editQuestionIndex').value);
        const newQ = {
          question: document.getElementById('qInputText').value.trim(),
          answers: [
            document.getElementById('qOptA').value.trim(),
            document.getElementById('qOptB').value.trim(),
            document.getElementById('qOptC').value.trim(),
            document.getElementById('qOptD').value.trim(),
          ].filter((x, idx) => idx < 2 || x.length > 0),
          correct: Number(document.getElementById('qCorrectSelect').value) || 0,
          chapter: Number(document.getElementById('qChapterSelect').value) || 1,
          difficulty: document.getElementById('qDifficultySelect').value || 'Trung bình',
          explanation: document.getElementById('qExplanationInput').value.trim(),
        };

        if (editIdx >= 0 && editIdx < currentQuestions.length) {
          currentQuestions[editIdx] = newQ;
        } else {
          currentQuestions.unshift(newQ);
        }

        const ok = await persistCurrentQuestions();
        if (ok) {
          resetQuestionEditorForm();
          alert(editIdx >= 0 ? `Đã cập nhật câu hỏi #${editIdx + 1}!` : 'Đã thêm câu hỏi mới thành công!');
        }
      });
    }

    if (quizTargetSelect) {
      quizTargetSelect.addEventListener('change', () => {
        loadQuizTarget(quizTargetSelect.value);
      });
      // Initial load when Tab 6 is opened or on page load
      loadQuizTarget(quizTargetSelect.value);
    }

    if (filterQuizChapterSelect) {
      filterQuizChapterSelect.addEventListener('change', renderQuizQuestionsList);
    }
    if (filterQuizKeywordInput) {
      filterQuizKeywordInput.addEventListener('input', renderQuizQuestionsList);
    }

    if (syncFromLinkedCourseBtn) {
      syncFromLinkedCourseBtn.addEventListener('click', async () => {
        if (!currentSubjectKey) return;
        if (!confirm('Đồng bộ toàn bộ câu hỏi từ Kho Học Phần sang môn thi Online này?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'sync_online_from_linked',
            subject_key: currentSubjectKey,
          }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã đồng bộ!');
        if (resp.ok && data.ok) {
          loadQuizTarget(currentTargetId);
        }
      });
    }

    // Export current questions to Excel CSV
    const exportQuizCsvBtn = document.getElementById('exportQuizCsvBtn');
    if (exportQuizCsvBtn) {
      exportQuizCsvBtn.addEventListener('click', () => {
        if (!currentQuestions || currentQuestions.length === 0) {
          alert('Bộ đề hiện tại chưa có câu hỏi để xuất!');
          return;
        }
        const header = 'STT,Câu hỏi,Đáp án A,Đáp án B,Đáp án C,Đáp án D,Đáp án đúng,Chương,Độ khó,Giải thích\n';
        const rows = currentQuestions.map((q, i) => {
          const a = q.answers || [];
          const letter = String.fromCharCode(65 + (Number(q.correct) || 0));
          const escCsv = (val) => `"${String(val ?? '').replace(/"/g, '""')}"`;
          return [
            i + 1,
            escCsv(q.question),
            escCsv(a[0] || ''),
            escCsv(a[1] || ''),
            escCsv(a[2] || ''),
            escCsv(a[3] || ''),
            letter,
            q.chapter || 1,
            escCsv(q.difficulty || 'Trung bình'),
            escCsv(q.explanation || ''),
          ].join(',');
        });
        const blob = new Blob(['\uFEFF' + header + rows.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        const safeName = currentTargetId.replace(/[^a-z0-9\-]/gi, '_');
        link.download = `Ngan-Hang-Cau-Hoi-${safeName}.csv`;
        link.click();
      });
    }

    // Export current questions to JSON
    const exportQuizJsonBtn = document.getElementById('exportQuizJsonBtn');
    if (exportQuizJsonBtn) {
      exportQuizJsonBtn.addEventListener('click', () => {
        if (!currentQuestions || currentQuestions.length === 0) {
          alert('Bộ đề hiện tại chưa có câu hỏi để xuất JSON!');
          return;
        }
        const jsonStr = JSON.stringify(currentQuestions, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        const safeName = currentTargetId.replace(/[^a-z0-9\-]/gi, '_');
        link.download = `Ngan-Hang-Cau-Hoi-${safeName}.json`;
        link.click();
      });
    }

    // Excel & JSON File Upload for Bulk Quiz Questions
    const quizExcelFileInput = document.getElementById('quizExcelFileInput');
    if (quizExcelFileInput) {
      quizExcelFileInput.addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const statusEl = document.getElementById('quizExcelStatus');
        const rawTextarea = document.getElementById('bulkQuizRawText');

        try {
          if (statusEl) statusEl.textContent = `⏳ Đang đọc file "${file.name}"...`;
          if (/\.(csv|txt|json)$/i.test(file.name)) {
            const text = await file.text();
            rawTextarea.value = text.trim();
            if (statusEl) statusEl.textContent = `✅ Đã nạp dữ liệu từ "${file.name}". Bấm "Import Vào Bộ Đề" để lưu!`;
            return;
          }

          if (!window.XLSX) {
            await new Promise((resolve, reject) => {
              const s = document.createElement('script');
              s.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
              s.onload = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          }

          const buf = await file.arrayBuffer();
          const wb = window.XLSX.read(buf, { type: 'array' });
          const lines = [];
          wb.SheetNames.forEach((sheetName) => {
            const sheet = wb.Sheets[sheetName];
            const rows = window.XLSX.utils.sheet_to_json(sheet, { header: 1, raw: false });
            rows.forEach((row) => {
              if (!Array.isArray(row) || row.length < 5) return;
              const cells = row.map((c) => String(c ?? '').replace(/\r?\n/g, ' ').trim());
              if (cells.filter(Boolean).length >= 5) {
                lines.push(cells.join('\t'));
              }
            });
          });
          rawTextarea.value = lines.join('\n');
          if (statusEl) statusEl.textContent = `✅ Đã trích xuất ${lines.length} câu hỏi từ "${file.name}". Bấm "Import Vào Bộ Đề" để lưu!`;
        } catch (err) {
          alert('Lỗi đọc file Excel/JSON: ' + err);
        }
      });
    }

    const bulkImportQuestionsForm = document.getElementById('bulkImportQuestionsForm');
    if (bulkImportQuestionsForm) {
      bulkImportQuestionsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'bulk_import_quiz_questions',
            target_id: currentTargetId,
            raw_text: document.getElementById('bulkQuizRawText').value,
            replace_all: document.getElementById('bulkQuizReplaceAll').checked,
          }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã import!');
        if (resp.ok && data.ok) {
          document.getElementById('bulkQuizRawText').value = '';
          loadQuizTarget(currentTargetId);
        }
      });
    }

    // ==========================================
    // TAB 7: ĐÁNH GIÁ GIẢNG VIÊN & KHẢO SÁT
    // ==========================================
    const criteriaTableBody = document.getElementById('criteriaTableBody');
    const addCriterionRowBtn = document.getElementById('addCriterionRowBtn');
    const evaluationCriteriaForm = document.getElementById('evaluationCriteriaForm');
    const resetCriteriaBtn = document.getElementById('resetCriteriaBtn');

    if (addCriterionRowBtn && criteriaTableBody) {
      addCriterionRowBtn.addEventListener('click', () => {
        const rowCount = criteriaTableBody.querySelectorAll('.crit-row').length + 1;
        const newCode = 'q' + rowCount;
        const tr = document.createElement('tr');
        tr.className = 'crit-row hover:bg-slate-50/80 transition-colors';
        tr.innerHTML = `
          <td class="p-2 text-center font-bold text-slate-500">
            <input type="text" class="crit-code w-12 text-center font-mono font-bold bg-slate-50 border border-slate-200 rounded px-1 py-1" value="${newCode}" />
          </td>
          <td class="p-2">
            <select class="crit-group w-full bg-white border border-slate-200 rounded px-1.5 py-1 font-bold text-slate-700">
              <option value="I">Nhóm I</option>
              <option value="II">Nhóm II</option>
              <option value="III">Nhóm III</option>
              <option value="IV" selected>Nhóm IV</option>
            </select>
          </td>
          <td class="p-2">
            <input type="text" class="crit-group-title w-full bg-white border border-slate-200 rounded px-2 py-1 text-slate-700" value="Đánh giá & Phản hồi kết quả học tập" placeholder="Tên nhóm tiêu chí..." />
          </td>
          <td class="p-2">
            <input type="text" class="crit-text w-full bg-white border border-slate-200 rounded px-2.5 py-1 text-slate-900 font-medium" placeholder="Nhập nội dung tiêu chí..." value="" required />
          </td>
          <td class="p-2 text-center">
            <button type="button" class="delete-crit-btn text-rose-600 hover:text-rose-800 font-bold p-1 cursor-pointer" title="Xóa tiêu chí này">✕</button>
          </td>
        `;
        criteriaTableBody.appendChild(tr);
      });
    }

    if (criteriaTableBody) {
      criteriaTableBody.addEventListener('click', (e) => {
        const btn = e.target.closest('.delete-crit-btn');
        if (btn) {
          const row = btn.closest('.crit-row') || btn.closest('tr');
          if (row) {
            const rows = criteriaTableBody.querySelectorAll('tr');
            if (rows.length <= 1) {
              alert('Phải giữ lại ít nhất 1 tiêu chí đánh giá!');
              return;
            }
            row.remove();
          }
        }
      });
    }

    if (evaluationCriteriaForm) {
      evaluationCriteriaForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rows = document.querySelectorAll('#criteriaTableBody tr');
        const criteria = [];
        rows.forEach((r, idx) => {
          const codeInput = r.querySelector('.crit-code') || r.querySelector('input[name^="crit_code_"]');
          const groupSelect = r.querySelector('.crit-group') || r.querySelector('select[name^="crit_group_"]');
          const groupTitleInput = r.querySelector('.crit-group-title') || r.querySelector('input[name^="crit_group_title_"]');
          const textInput = r.querySelector('.crit-text') || r.querySelector('input[name^="crit_text_"]');
          const code = (codeInput?.value || `q${idx + 1}`).trim();
          const group = (groupSelect?.value || 'I').trim();
          const groupTitle = (groupTitleInput?.value || '').trim();
          const text = (textInput?.value || '').trim();
          if (text) {
            criteria.push({ id: idx + 1, code, group, groupTitle, text });
          }
        });

        if (criteria.length === 0) {
          alert('Danh sách tiêu chí không được để trống!');
          return;
        }

        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save_evaluation_criteria',
            criteria,
          }),
        });
        const data = await resp.json();
        alert(data.message || (resp.ok ? 'Đã lưu cấu hình tiêu chí!' : 'Lỗi khi lưu!'));
        if (resp.ok) window.location.reload();
      });
    }

    if (resetCriteriaBtn) {
      resetCriteriaBtn.addEventListener('click', async () => {
        if (!confirm('Bạn có chắc chắn muốn khôi phục 12 tiêu chí đánh giá mặc định theo quy chuẩn?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'reset_evaluation_criteria' }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã khôi phục!');
        if (resp.ok) window.location.reload();
      });
    }

    // Delete single evaluation
    document.querySelectorAll('.delete-eval-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-eval-id') || btn.getAttribute('data-id');
        if (!id) return;
        if (!confirm('Xóa đánh giá này khỏi cơ sở dữ liệu D1?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_evaluation', id }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã xóa!');
        if (resp.ok) window.location.reload();
      });
    });

    // Clear all evaluations
    const clearAllEvalsBtn = document.getElementById('clearAllEvalsBtn');
    if (clearAllEvalsBtn) {
      clearAllEvalsBtn.addEventListener('click', async () => {
        if (!confirm('⚠️ CẢNH BÁO: Bạn có chắc chắn muốn xóa TOÀN BỘ dữ liệu đánh giá giảng viên trong D1? Thao tác này không thể hoàn tác!')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clear_all_evaluations' }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã làm trống dữ liệu!');
        if (resp.ok) window.location.reload();
      });
    }

    // Delete single survey
    document.querySelectorAll('.delete-survey-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-survey-id') || btn.getAttribute('data-id');
        if (!id) return;
        if (!confirm('Xóa bản ghi này khỏi cơ sở dữ liệu D1?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_survey', id }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã xóa!');
        if (resp.ok) window.location.reload();
      });
    });

    // Clear all surveys
    const clearAllSurveysBtn = document.getElementById('clearAllSurveysBtn');
    if (clearAllSurveysBtn) {
      clearAllSurveysBtn.addEventListener('click', async () => {
        if (!confirm('⚠️ CẢNH BÁO: Bạn có chắc chắn muốn xóa TOÀN BỘ dữ liệu khảo sát NCKHSV trong D1? Thao tác này không thể hoàn tác!')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clear_all_surveys' }),
        });
        const data = await resp.json();
        alert(data.message || 'Đã làm trống dữ liệu!');
        if (resp.ok) window.location.reload();
      });
    }

    // Live search evaluations
    const searchEvalInput = document.getElementById('searchEvalInput');
    if (searchEvalInput) {
      searchEvalInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#evaluationsTableBody tr');
        rows.forEach((tr) => {
          const text = tr.textContent.toLowerCase();
          tr.style.display = text.includes(query) ? '' : 'none';
        });
      });
    }

    // YouTube Videos Admin Management: removed
  
    // Tab 9: Chat Logs filter & delete handlers
    const filterChatLogsInput = document.getElementById('filterChatLogsInput');
    if (filterChatLogsInput) {
      filterChatLogsInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        document.querySelectorAll('.chat-log-row').forEach((row) => {
          const hay = row.getAttribute('data-search') || '';
          row.style.display = !q || hay.includes(q) ? '' : 'none';
        });
      });
    }

    document.querySelectorAll('.del-chat-log-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-del-chat-log');
        if (!confirm('Xóa bản ghi câu hỏi & câu trả lời #' + id + '?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_chat_log', id }),
        });
        if (resp.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-chat-logs');
          window.location.reload();
        }
      });
    });

    const clearAllChatLogsBtn = document.getElementById('clearAllChatLogsBtn');
    if (clearAllChatLogsBtn) {
      clearAllChatLogsBtn.addEventListener('click', async () => {
        if (!confirm('Bạn có chắc chắn muốn XÓA TOÀN BỘ lịch sử câu hỏi và câu trả lời không? (Hãy xuất file CSV/TXT trước khi xóa)')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clear_all_chat_logs' }),
        });
        if (resp.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-chat-logs');
          window.location.reload();
        }
      });
    }
  
    // Account-based Login Handling
    const adminAccountLoginForm = document.getElementById('adminAccountLoginForm');
    const adminLoginErr = document.getElementById('adminLoginErr');
    if (adminAccountLoginForm) {
      adminAccountLoginForm.onsubmit = async (e) => {
        e.preventDefault();
        if (adminLoginErr) adminLoginErr.classList.add('hidden');
        const username = document.getElementById('adminUsername')?.value.trim();
        const password = document.getElementById('adminPassword')?.value.trim();
        try {
          const resp = await fetch('/api/admin/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });
          const data = await resp.json();
          if (resp.ok && data.ok) {
            window.location.reload();
          } else {
            if (adminLoginErr) {
              adminLoginErr.textContent = data.message || 'Đăng nhập thất bại!';
              adminLoginErr.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (adminLoginErr) {
            adminLoginErr.textContent = 'Lỗi kết nối máy chủ.';
            adminLoginErr.classList.remove('hidden');
          }
        }
      };
    }

    // Admin Logout
    const adminLogoutBtn = document.getElementById('adminLogoutBtn');
    if (adminLogoutBtn) {
      adminLogoutBtn.onclick = async () => {
        try {
          await fetch('/api/admin/auth/logout', { method: 'POST' });
        } catch {}
        window.location.reload();
      };
    }

    // Tab 10: Accounts Modal and Actions
    const accountModal = document.getElementById('accountModal');
    const openAddAccountModalBtn = document.getElementById('openAddAccountModalBtn');
    const closeAccountModalBtn = document.getElementById('closeAccountModalBtn');
    const cancelAccountModalBtn = document.getElementById('cancelAccountModalBtn');
    const accountForm = document.getElementById('accountUpsertForm');

    function openModal(data) {
      if (!accountModal) return;
      document.getElementById('accFormId').value = data ? data.id : '';
      document.getElementById('accFormUsername').value = data ? data.username : '';
      document.getElementById('accFormDisplayName').value = data ? data.display_name : '';
      document.getElementById('accFormEmail').value = data ? data.email : '';
      document.getElementById('accFormPassword').value = '';
      document.getElementById('accFormRole').value = data ? data.role : 'editor';
      document.getElementById('accFormActive').value = data ? data.is_active : '1';
      document.getElementById('accountModalTitle').innerHTML = data ? '<span>✏️</span> Chỉnh Sửa Tài Khoản' : '<span>➕</span> Thêm Tài Khoản Admin';
      accountModal.classList.remove('hidden');
    }

    function closeModal() {
      if (accountModal) accountModal.classList.add('hidden');
    }

    if (openAddAccountModalBtn) openAddAccountModalBtn.onclick = () => openModal(null);
    if (closeAccountModalBtn) closeAccountModalBtn.onclick = closeModal;
    if (cancelAccountModalBtn) cancelAccountModalBtn.onclick = closeModal;

    document.querySelectorAll('.edit-acc-btn').forEach((btn) => {
      btn.onclick = () => {
        try {
          const acc = JSON.parse(btn.getAttribute('data-acc'));
          openModal(acc);
        } catch (e) {
          console.error(e);
        }
      };
    });

    document.querySelectorAll('.delete-acc-btn').forEach((btn) => {
      btn.onclick = async () => {
        const id = Number(btn.getAttribute('data-acc-id'));
        const username = btn.getAttribute('data-acc-username') || 'tài khoản này';
        if (!confirm('Bạn có chắc chắn muốn xóa tài khoản @' + username + ' không?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_admin_account', id }),
        });
        const res = await resp.json();
        alert(res.message || 'Đã xử lý!');
        if (resp.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-accounts');
          window.location.reload();
        }
      };
    });

    if (accountForm) {
      accountForm.onsubmit = async (e) => {
        e.preventDefault();
        const id = document.getElementById('accFormId').value;
        const username = document.getElementById('accFormUsername').value.trim();
        const displayName = document.getElementById('accFormDisplayName').value.trim();
        const email = document.getElementById('accFormEmail').value.trim();
        const password = document.getElementById('accFormPassword').value.trim();
        const role = document.getElementById('accFormRole').value;
        const isActive = Number(document.getElementById('accFormActive').value);

        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'upsert_admin_account',
            id: id ? Number(id) : undefined,
            username,
            display_name: displayName,
            email,
            password: password || undefined,
            role,
            is_active: isActive,
          }),
        });
        const res = await resp.json();
        alert(res.message || 'Đã lưu!');
        if (resp.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-accounts');
          window.location.reload();
        }
      };
    }

    // Tab 11: Clear Audit Logs
    const clearAuditLogsBtn = document.getElementById('clearAuditLogsBtn');
    if (clearAuditLogsBtn) {
      clearAuditLogsBtn.onclick = async () => {
        if (!confirm('Bạn có chắc chắn muốn xóa toàn bộ lịch sử thao tác hệ thống không?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clear_audit_logs' }),
        });
        const res = await resp.json();
        alert(res.message || 'Đã xử lý!');
        if (resp.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-audit-logs');
          window.location.reload();
        }
      };
    }
  
    
    // ==========================================
    // Quản lý Môn Thi Trắc Nghiệm Online (/ngan-hang-de-thi)
    // ==========================================
    const addOnlineSubjectModal = document.getElementById('addOnlineSubjectModal');
    const openAddOnlineSubjectBtn = document.getElementById('openAddOnlineSubjectBtn');
    const closeAddOnlineSubjectModalBtn = document.getElementById('closeAddOnlineSubjectModalBtn');
    const cancelAddOnlineSubjectBtn = document.getElementById('cancelAddOnlineSubjectBtn');
    const addOnlineSubjectForm = document.getElementById('addOnlineSubjectForm');
    const newSubLabel = document.getElementById('newSubLabel');
    const newSubKey = document.getElementById('newSubKey');

    function openSubjectModal() {
      if (addOnlineSubjectModal) {
        addOnlineSubjectModal.classList.remove('hidden');
        newSubLabel?.focus();
      }
    }

    function closeSubjectModal() {
      if (addOnlineSubjectModal) {
        addOnlineSubjectModal.classList.add('hidden');
        addOnlineSubjectForm?.reset();
      }
    }

    openAddOnlineSubjectBtn?.addEventListener('click', openSubjectModal);
    closeAddOnlineSubjectModalBtn?.addEventListener('click', closeSubjectModal);
    cancelAddOnlineSubjectBtn?.addEventListener('click', closeSubjectModal);

    // Auto slug generator
    newSubLabel?.addEventListener('input', () => {
      if (newSubKey && !newSubKey.dataset.userEdited) {
        const val = newSubLabel.value.trim();
        const slug = val
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/đ/gi, 'd')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
        newSubKey.value = slug;
      }
    });

    newSubKey?.addEventListener('input', () => {
      newSubKey.dataset.userEdited = 'true';
    });

    // Submit Thêm môn thi mới
    addOnlineSubjectForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const label = newSubLabel?.value.trim();
      const key = newSubKey?.value.trim();
      if (!label) {
        alert('Vui lòng nhập tên môn học dự thi!');
        return;
      }

      const sourceRadio = document.querySelector('input[name="newSubSource"]:checked');
      const isLinked = sourceRadio?.value === 'linked';
      const linkedRoute = isLinked ? document.getElementById('newSubLinkedRoute')?.value : '';
      const questionsRaw = !isLinked ? document.getElementById('newSubQuestionsRaw')?.value : '';
      const enabled = document.getElementById('newSubEnabled')?.checked ?? true;

      const submitBtn = document.getElementById('submitAddOnlineSubjectBtn');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '⏳ Đang lưu...';
      }

      try {
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'add_online_exam_subject',
            label,
            key,
            linked_route: linkedRoute,
            use_linked_bank: Boolean(linkedRoute),
            questions_raw: questionsRaw,
            enabled,
          }),
        });
        const res = await resp.json();
        if (resp.ok && res.ok) {
          alert(res.message || 'Đã thêm môn thi thành công!');
          sessionStorage.setItem('adminActiveTab', 'tab-quiz-bank');
          window.location.reload();
        } else {
          alert('Lỗi: ' + (res.error || res.message || 'Không thể thêm môn thi'));
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>💾</span> Lưu &amp; Thêm Môn Thi';
          }
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ!');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>💾</span> Lưu &amp; Thêm Môn Thi';
        }
      }
    });

    // Delete môn thi trắc nghiệm
    document.querySelectorAll('.del-online-subject-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const key = btn.getAttribute('data-key');
        const label = btn.getAttribute('data-label') || key;
        if (!confirm(`⚠️ Bạn có chắc chắn muốn XÓA môn thi "${label}" (${key}) khỏi Ngân hàng Đề thi Online không?`)) {
          return;
        }

        try {
          const resp = await fetch('/api/admin/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'delete_online_exam_subject',
              key,
            }),
          });
          const res = await resp.json();
          if (resp.ok && res.ok) {
            alert(res.message || 'Đã xóa môn thi thành công!');
            sessionStorage.setItem('adminActiveTab', 'tab-quiz-bank');
            window.location.reload();
          } else {
            alert('Lỗi: ' + (res.error || res.message));
          }
        } catch (err) {
          alert('Lỗi kết nối máy chủ!');
        }
      });
    });
  
</script>

        <!-- MODAL: THÊM MÔN THI TRẮC NGHIỆM MỚI VÀO CỔNG THI ONLINE -->
        <div
          id="addOnlineSubjectModal"
          class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden"
        >
          <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in duration-150">
            <!-- Modal Header -->
            <div class="px-5 py-4 bg-gradient-to-r from-[#742D3A] via-[#A83245] to-[#742D3A] text-white flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-white/15 flex items-center justify-center text-base">➕</span>
                <div>
                  <h3 class="font-extrabold text-sm sm:text-base text-white m-0">Thêm Môn Thi Trắc Nghiệm Mới</h3>
                  <p class="text-2xs text-[#F8EDEF] m-0">Tạo môn thi mới trên Cổng Ngân Hàng Đề Thi Online (/ngan-hang-de-thi)</p>
                </div>
              </div>
              <button
                type="button"
                id="closeAddOnlineSubjectModalBtn"
                class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors text-sm cursor-pointer"
              >
                ✕
              </button>
            </div>

            <!-- Modal Body Form -->
            <form id="addOnlineSubjectForm" class="p-5 sm:p-6 overflow-y-auto space-y-4 text-xs">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label class="block font-bold text-slate-800 mb-1">
                    Tên Môn Học Dự Thi <span class="text-rose-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="newSubLabel"
                    required
                    placeholder="VD: Quản trị chuỗi cung ứng"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-300 font-bold text-slate-900 text-xs focus:border-[#A83245] focus:outline-none"
                  />
                  <p class="text-2xs text-slate-500 mt-1">Tên hiển thị trên thẻ chọn môn thi của sinh viên</p>
                </div>
                <div>
                  <label class="block font-bold text-slate-800 mb-1">
                    Mã Định Danh (Slug / Key)
                  </label>
                  <input
                    type="text"
                    id="newSubKey"
                    placeholder="VD: quan-tri-chuoi-cung-ung"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-300 font-mono text-xs text-slate-700 bg-slate-50 focus:border-[#A83245] focus:outline-none"
                  />
                  <p class="text-2xs text-slate-500 mt-1">Mã duy nhất, dùng trên link URL và kết quả thi</p>
                </div>
              </div>

              <!-- Nguồn Ngân Hàng Câu Hỏi -->
              <div class="p-4 rounded-2xl bg-[#F7F5F2]/70 border border-[#E8DDE0] space-y-3">
                <label class="block font-extrabold text-[#742D3A] text-xs uppercase tracking-wide">
                  Nguồn Ngân Hàng Câu Hỏi Trắc Nghiệm:
                </label>
                
                <div class="space-y-2.5">
                  <label class="flex items-start gap-2.5 p-3 rounded-xl bg-white border border-slate-200 cursor-pointer hover:border-[#A83245] transition-colors">
                    <input type="radio" name="newSubSource" value="linked" checked class="mt-0.5 text-[#A83245]" />
                    <div class="flex-1">
                      <strong class="text-slate-800 block text-xs">Cách 1: Liên kết với trang học liệu / đề thi có sẵn</strong>
                      <p class="text-2xs text-slate-500 mt-0.5">Hệ thống sẽ tự động đồng bộ ngân hàng câu hỏi từ trang học liệu đã có.</p>
                      <select id="newSubLinkedRoute" class="mt-2 w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold bg-slate-50">
                        <option value="">-- Chọn trang đề thi thử liên kết --</option>
                        {pages.filter(p => p.route_path.includes('test') || p.page_type === 'quiz' || p.category === 'Study-Corner').map(p => (
                          <option value={p.route_path}>{p.title} ({p.route_path})</option>
                        ))}
                      </select>
                    </div>
                  </label>

                  <label class="flex items-start gap-2.5 p-3 rounded-xl bg-white border border-slate-200 cursor-pointer hover:border-[#A83245] transition-colors">
                    <input type="radio" name="newSubSource" value="raw" class="mt-0.5 text-[#A83245]" />
                    <div class="flex-1">
                      <strong class="text-slate-800 block text-xs">Cách 2: Nhập trực tiếp ngân hàng câu hỏi mới</strong>
                      <p class="text-2xs text-slate-500 mt-0.5">Dán câu hỏi dạng văn bản thông minh (Câu 1... A/B/C/D... Đáp án: A) hoặc mảng JSON.</p>
                      <textarea
                        id="newSubQuestionsRaw"
                        rows="5"
                        placeholder="VD:&#10;Câu 1: Chiến lược kéo là chiến lược gì?&#10;A. Nhắm vào người tiêu dùng cuối cùng&#10;B. Nhắm vào đại lý trung gian&#10;C. Giảm giá đại trà&#10;D. Cả A và B đều đúng&#10;Đáp án: A&#10;&#10;Câu 2: ..."
                        class="mt-2 w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-2xs focus:border-[#A83245] focus:outline-none"
                      ></textarea>
                    </div>
                  </label>
                </div>
              </div>

              <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="newSubEnabled" checked class="rounded text-[#A83245] w-4 h-4 cursor-pointer" />
                <label for="newSubEnabled" class="font-bold text-slate-800 cursor-pointer">
                  Kích hoạt hiển thị môn thi ngay trên Cổng Thi Online
                </label>
              </div>

              <!-- Footer Buttons -->
              <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-3">
                <button
                  type="button"
                  id="cancelAddOnlineSubjectBtn"
                  class="px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition-colors cursor-pointer"
                >
                  Hủy Bỏ
                </button>
                <button
                  type="submit"
                  id="submitAddOnlineSubjectBtn"
                  class="px-5 py-2 rounded-xl bg-gradient-to-r from-[#742D3A] to-[#A83245] hover:opacity-95 text-white font-extrabold shadow-sm transition-all cursor-pointer flex items-center gap-1.5"
                >
                  <span>💾</span> Lưu &amp; Thêm Môn Thi
                </button>
              </div>
            </form>
          </div>
        </div>

</MainLayout>

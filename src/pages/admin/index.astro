                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
                <div class="sm:col-span-8">
                  <label class="block font-bold text-slate-700 mb-1">Dòng Hướng Dẫn Dưới Tiêu Đề:</label>
                  <input
                    type="text"
                    id="cfgHeaderSubtitle"
                    value={onlineExamConfig.header_subtitle}
                    class="w-full px-3 py-2 rounded-xl border border-slate-300"
                  />
                </div>
                <div class="sm:col-span-4 pt-4">
                  <label class="inline-flex items-center gap-2 font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 rounded-xl cursor-pointer w-full">
                    <input
                      type="checkbox"
                      id="cfgShowDetailedAnswers"
                      checked={onlineExamConfig.show_detailed_answers}
                      class="rounded text-emerald-600"
                    />
                    <span>Hiện "Chi tiết đáp án & giải thích" sau khi nộp bài</span>
                  </label>
                </div>
              </div>

              <!-- Chế độ đề thi & Thời gian -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-2.5">
                <div class="flex items-center justify-between">
                  <h3 class="font-extrabold text-slate-900">⏱️ Danh Sách Chế Độ Đề Thi & Thời Gian (Dropdown Chọn Chế Độ Thi)</h3>
                  <button
                    type="button"
                    id="addOnlineModeRowBtn"
                    class="px-3 py-1 rounded-lg bg-sky-100 hover:bg-sky-200 text-sky-800 font-bold cursor-pointer"
                  >
                    + Thêm chế độ thời gian
                  </button>
                </div>
                <div id="onlineModesListContainer" class="space-y-2">
                  {onlineExamConfig.modes.map((m) => (
                    <div class="online-mode-row grid grid-cols-1 sm:grid-cols-12 gap-2 items-center">
                      <div class="sm:col-span-2 flex items-center gap-1.5">

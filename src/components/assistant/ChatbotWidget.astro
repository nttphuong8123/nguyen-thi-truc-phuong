---
// src/components/assistant/ChatbotWidget.astro
---

<!-- Nút mở Chatbot Nổi -->
<div id="assistantFabContainer" class="fixed bottom-6 right-6 z-[9999] flex flex-col items-end">
  <!-- Tooltip gợi ý -->
  <div id="assistantTooltip" class="mb-2 bg-gradient-to-r from-red-800 to-rose-700 text-white text-xs px-3.5 py-1.5 rounded-full shadow-lg border border-amber-300/30 font-medium flex items-center gap-1.5 animate-bounce transition-all duration-300 cursor-pointer">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
    <span>Trợ lý học tập HCE</span>
    <button id="closeAssistantTooltip" class="ml-1 text-white/70 hover:text-white text-xs" title="Đóng gợi ý">&times;</button>
  </div>

  <!-- Nút tròn chính -->
  <button
    id="openAssistantBtn"
    class="w-14 h-14 rounded-full bg-gradient-to-br from-red-700 via-rose-800 to-amber-700 text-white shadow-2xl flex items-center justify-center hover:scale-105 active:scale-95 transition-all duration-200 border-2 border-amber-300 relative group"
    aria-label="Mở Trợ lý học tập Nguyễn Thị Trúc Phương"
  >
    <div class="relative w-8 h-8 flex items-center justify-center">
      <svg class="w-7 h-7 text-amber-200 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
      </svg>
      <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full"></span>
    </div>
  </button>
</div>

<!-- Modal Hộp thoại Chatbot -->
<div
  id="assistantModal"
  class="fixed bottom-6 right-6 z-[10000] w-[92vw] sm:w-[420px] max-w-[440px] h-[600px] max-h-[85vh] bg-white rounded-2xl shadow-2xl border border-red-100 flex flex-col overflow-hidden transition-all duration-300 transform scale-95 opacity-0 pointer-events-none origin-bottom-right"
  role="dialog"
  aria-modal="true"
  aria-labelledby="assistantTitle"
>
  <!-- Header hộp thoại -->
  <div class="bg-gradient-to-r from-red-800 via-red-900 to-rose-900 text-white px-4 py-3.5 flex items-center justify-between shadow-md border-b border-amber-400/20 relative">
    <div class="flex items-center gap-3">
      <div class="relative w-10 h-10 rounded-full bg-gradient-to-tr from-amber-400 to-rose-300 p-0.5 shadow-inner">
        <div class="w-full h-full rounded-full bg-white flex items-center justify-center overflow-hidden">
          <span class="text-red-800 font-black text-sm tracking-tighter">TP</span>
        </div>
        <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-red-900 rounded-full"></span>
      </div>
      <div>
        <h3 id="assistantTitle" class="font-bold text-sm leading-tight text-amber-100 flex items-center gap-1.5">
          Trợ lý học tập – Trúc Phương
        </h3>
        <p class="text-[11px] text-red-200/90 leading-tight">Tư vấn Quy chế & Hỗ trợ sinh viên HCE</p>
      </div>
    </div>
    <div class="flex items-center gap-1">
      <button id="minimizeAssistantBtn" class="p-1.5 text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="Thu nhỏ">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
      <button id="closeAssistantBtn" class="p-1.5 text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="Đóng">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>

  <!-- Navigation Tabs: Chat Quy chế / Tra cứu điểm -->
  <div class="flex border-b border-gray-100 bg-gray-50/80 text-xs font-medium text-gray-600">
    <button id="tabChat" class="flex-1 py-2 px-3 text-center border-b-2 border-red-700 text-red-800 font-semibold bg-white transition-all flex items-center justify-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
      Tư vấn Quy chế
    </button>
    <button id="tabGrades" class="flex-1 py-2 px-3 text-center border-b-2 border-transparent hover:text-red-700 transition-all flex items-center justify-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
      Tra cứu điểm (SIS)
    </button>
  </div>

  <!-- NỘI DUNG TAB 1: TƯ VẤN QUY CHẾ -->
  <div id="chatTabContent" class="flex-1 flex flex-col overflow-hidden bg-slate-50/50">
    <!-- Khu vực tin nhắn cuộn -->
    <div id="chatMessages" class="flex-1 overflow-y-auto p-3.5 space-y-3.5 text-sm">
      <!-- Tin nhắn chào mừng mặc định -->
      <div class="flex gap-2.5 items-start">
        <div class="w-7 h-7 rounded-full bg-red-800 text-amber-200 text-xs font-bold flex items-center justify-center flex-shrink-0 shadow-sm">
          TP
        </div>
        <div class="bg-white p-3 rounded-2xl rounded-tl-sm shadow-sm border border-gray-100 max-w-[85%] text-gray-800 space-y-2">
          <p class="leading-relaxed">
            Xin chào em! Cô là <strong>Trợ lý học tập – Trúc Phương</strong>. Cô sẵn sàng giải đáp các quy chế đào tạo, cách tính điểm, chuẩn đầu ra và công tác sinh viên của Trường Cao đẳng Kinh tế TP.HCM (HCE).
          </p>
          <div class="pt-1.5 border-t border-gray-100">
            <p class="text-[11px] font-semibold text-gray-500 mb-1.5">Gợi ý câu hỏi phổ biến:</p>
            <div class="flex flex-wrap gap-1.5">
              <button class="quick-suggest-btn text-[11px] bg-red-50 hover:bg-red-100 text-red-900 border border-red-200 rounded-full px-2.5 py-1 text-left transition-colors">
                📘 Cách tính điểm môn học (40/60)?
              </button>
              <button class="quick-suggest-btn text-[11px] bg-red-50 hover:bg-red-100 text-red-900 border border-red-200 rounded-full px-2.5 py-1 text-left transition-colors">
                ⚠️ Nghỉ bao nhiêu % thì bị cấm thi?
              </button>
              <button class="quick-suggest-btn text-[11px] bg-red-50 hover:bg-red-100 text-red-900 border border-red-200 rounded-full px-2.5 py-1 text-left transition-colors">
                🎓 Chuẩn đầu ra Ngoại ngữ & Tin học?
              </button>
              <button class="quick-suggest-btn text-[11px] bg-red-50 hover:bg-red-100 text-red-900 border border-red-200 rounded-full px-2.5 py-1 text-left transition-colors">
                🏆 Điểm xét học bổng khuyến khích?
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading Indicator -->
    <div id="chatLoading" class="hidden px-4 py-2 flex items-center gap-2 text-xs text-gray-500 bg-white border-t border-gray-100">
      <div class="flex gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-bounce [animation-delay:0.2s]"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-bounce [animation-delay:0.4s]"></span>
      </div>
      <span>Cô đang tra cứu văn bản quy chế chính thức...</span>
    </div>

    <!-- Khung nhập tin nhắn -->
    <div class="p-2.5 bg-white border-t border-gray-200">
      <form id="chatForm" class="flex gap-1.5 items-center">
        <input
          id="chatInput"
          type="text"
          placeholder="Hỏi về quy chế, điểm thi, tốt nghiệp..."
          class="flex-1 text-xs sm:text-sm bg-gray-50 border border-gray-300 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-transparent transition-all"
          autocomplete="off"
          required
        />
        <button
          type="submit"
          id="chatSendBtn"
          class="w-10 h-10 rounded-xl bg-red-700 hover:bg-red-800 active:scale-95 text-white flex items-center justify-center transition-all flex-shrink-0 shadow-sm"
          title="Gửi câu hỏi"
        >
          <svg class="w-4 h-4 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
        </button>
      </form>
      <div class="mt-1 flex items-center justify-between text-[10px] text-gray-600 px-1">
        <span>* Thông tin căn cứ theo quy chế đào tạo HCE</span>
        <a href="/admin/assistant" class="hover:text-red-700 text-gray-600">Quản trị</a>
      </div>
    </div>
  </div>

  <!-- NỘI DUNG TAB 2: TRA CỨU ĐIỂM (SIS) -->
  <div id="gradesTabContent" class="hidden flex-1 p-5 overflow-y-auto flex flex-col justify-center items-center text-center bg-gray-50">
    <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center mb-3 shadow-inner">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
      </svg>
    </div>
    <h4 class="font-bold text-gray-800 text-sm mb-1.5">Hệ thống Tra Cứu Điểm Trực Tuyến</h4>
    <span class="inline-block bg-amber-200/80 text-amber-900 text-[11px] font-semibold px-2.5 py-0.5 rounded-full mb-3">
      Trạng thái: Chưa kích hoạt (SIS_ENABLED = false)
    </span>
    <p class="text-xs text-gray-600 leading-relaxed max-w-xs mb-4">
      Để đảm bảo an toàn tuyệt đối thông tin cá nhân và dữ liệu học tập của sinh viên, chức năng tra cứu điểm trực tuyến đang được đồng bộ chuẩn kết nối SSO của Nhà trường.
    </p>
    <div class="bg-white p-3 rounded-xl border border-gray-200 text-[11px] text-left text-gray-600 space-y-1.5 w-full">
      <p class="font-semibold text-gray-800">📌 Hướng dẫn tra cứu điểm chính thức:</p>
      <p>1. Đăng nhập Cổng thông tin đào tạo HCE: <code class="text-red-700 font-mono">daotao.kthcm.edu.vn</code></p>
      <p>2. Hoặc liên hệ Cố vấn học tập (CVHT) và Văn phòng Khoa Quản trị - Kinh doanh.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const fabContainer = document.getElementById('assistantFabContainer');
    const openBtn = document.getElementById('openAssistantBtn');
    const modal = document.getElementById('assistantModal');
    const closeBtn = document.getElementById('closeAssistantBtn');
    const minimizeBtn = document.getElementById('minimizeAssistantBtn');
    const tooltip = document.getElementById('assistantTooltip');
    const closeTooltipBtn = document.getElementById('closeAssistantTooltip');

    const tabChat = document.getElementById('tabChat');
    const tabGrades = document.getElementById('tabGrades');
    const chatTabContent = document.getElementById('chatTabContent');
    const gradesTabContent = document.getElementById('gradesTabContent');

    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const chatMessages = document.getElementById('chatMessages');
    const chatLoading = document.getElementById('chatLoading');

    let isOpen = false;

    function openModal() {
      isOpen = true;
      modal.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      modal.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
      if (tooltip) tooltip.style.display = 'none';
      setTimeout(() => chatInput?.focus(), 150);
    }

    function closeModal() {
      isOpen = false;
      modal.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    }

    openBtn?.addEventListener('click', () => {
      if (isOpen) closeModal();
      else openModal();
    });

    closeBtn?.addEventListener('click', closeModal);
    minimizeBtn?.addEventListener('click', closeModal);
    closeTooltipBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (tooltip) tooltip.style.display = 'none';
    });

    // Tab Switching
    tabChat?.addEventListener('click', () => {
      tabChat.classList.add('border-red-700', 'text-red-800', 'font-semibold', 'bg-white');
      tabChat.classList.remove('border-transparent');
      tabGrades.classList.remove('border-red-700', 'text-red-800', 'font-semibold', 'bg-white');
      tabGrades.classList.add('border-transparent');
      chatTabContent.classList.remove('hidden');
      gradesTabContent.classList.add('hidden');
    });

    tabGrades?.addEventListener('click', () => {
      tabGrades.classList.add('border-red-700', 'text-red-800', 'font-semibold', 'bg-white');
      tabGrades.classList.remove('border-transparent');
      tabChat.classList.remove('border-red-700', 'text-red-800', 'font-semibold', 'bg-white');
      tabChat.classList.add('border-transparent');
      gradesTabContent.classList.remove('hidden');
      chatTabContent.classList.add('hidden');
    });

    // Quick suggestions click handler
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && target.classList && target.classList.contains('quick-suggest-btn')) {
        const text = target.textContent.trim().replace(/^[^\p{L}\d]+/u, '');
        if (chatInput) {
          chatInput.value = text;
          submitQuestion(text);
        }
      }
    });

    function appendMessage(sender, text, citations, suggestTransfer) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex gap-2.5 items-start ' + (sender === 'user' ? 'justify-end' : '');

      if (sender === 'user') {
        msgDiv.innerHTML = `
          <div class="bg-red-700 text-white p-3 rounded-2xl rounded-tr-sm shadow-sm max-w-[85%] text-xs sm:text-sm">
            ${escapeHtml(text)}
          </div>
        `;
      } else {
        let citationsHtml = '';
        if (citations && citations.length > 0) {
          citationsHtml = `
            <div class="mt-2.5 pt-2 border-t border-gray-100">
              <span class="text-[11px] font-bold text-red-900 block mb-1">📜 Căn cứ quy chế:</span>
              <div class="space-y-1 text-[11px] text-gray-600">
                ${citations.map(c => `
                  <div class="bg-red-50/60 p-1.5 rounded border border-red-100">
                    <span class="font-medium text-red-800">${escapeHtml(c.docTitle)}</span> (${escapeHtml(c.docCode)})
                    <br/><span class="text-gray-500 font-semibold">${escapeHtml(c.articleRef)}</span>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }

        let transferHtml = '';
        if (suggestTransfer) {
          transferHtml = `
            <div class="mt-2 p-2 bg-amber-50 border border-amber-200 rounded-lg text-[11px] text-amber-900 flex items-start gap-1.5">
              <span>ℹ️</span>
              <div>
                <strong>Cần hỗ trợ thêm:</strong> Em vui lòng liên hệ Cố vấn học tập (CVHT) hoặc Phòng Đào tạo qua kênh chính thức của nhà trường.
              </div>
            </div>
          `;
        }

        // Render Markdown cơ bản
        const formattedText = renderSimpleMarkdown(text);

        msgDiv.innerHTML = `
          <div class="w-7 h-7 rounded-full bg-red-800 text-amber-200 text-xs font-bold flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5">
            TP
          </div>
          <div class="bg-white p-3 rounded-2xl rounded-tl-sm shadow-sm border border-gray-100 max-w-[85%] text-xs sm:text-sm text-gray-800 space-y-1.5">
            <div class="prose-chat leading-relaxed">${formattedText}</div>
            ${citationsHtml}
            ${transferHtml}
            <div class="pt-1.5 flex items-center justify-between text-[10px] text-gray-400">
              <span>Được trả lời bởi Trợ lý học tập</span>
              <div class="flex items-center gap-1.5">
                <button class="feedback-btn hover:text-emerald-600 transition-colors" title="Hữu ích">👍</button>
                <button class="feedback-btn hover:text-rose-600 transition-colors" title="Chưa rõ ràng">👎</button>
              </div>
            </div>
          </div>
        `;
      }

      chatMessages?.appendChild(msgDiv);
      chatMessages?.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderSimpleMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 py-0.5 rounded text-red-700 text-xs font-mono">$1</code>')
        .replace(/\n\n/g, '<br/><br/>')
        .replace(/\n/g, '<br/>');
    }

    async function submitQuestion(question) {
      if (!question || !question.trim()) return;
      const clean = question.trim();
      appendMessage('user', clean);
      if (chatInput) chatInput.value = '';

      if (chatLoading) chatLoading.classList.remove('hidden');

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: clean })
        });

        const data = await res.json();
        if (chatLoading) chatLoading.classList.add('hidden');

        if (data && data.success && data.data) {
          appendMessage('assistant', data.data.answer, data.data.citations, data.data.suggestTransferToCVHT);
        } else {
          appendMessage('assistant', data?.error || 'Có lỗi kết nối. Vui lòng thử lại sau ít phút.');
        }
      } catch (err) {
        if (chatLoading) chatLoading.classList.add('hidden');
        appendMessage('assistant', 'Không thể kết nối đến máy chủ. Em vui lòng kiểm tra kết nối mạng nhé.');
      }
    }

    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (chatInput) submitQuestion(chatInput.value);
    });

    // Feedback interaction
    document.addEventListener('click', (e) => {
      const btn = e.target;
      if (btn && btn.classList && btn.classList.contains('feedback-btn')) {
        btn.parentElement.innerHTML = '<span class="text-[10px] text-emerald-600 font-medium">Cảm ơn đánh giá của em!</span>';
      }
    });
  })();
</script>

    <script is:inline>
      // 1. Mobile Drawer Toggle & Accordion Interaction
      (function () {
        const btn = document.getElementById('mobileMenuBtn');
        const drawer = document.getElementById('mobileMenuDrawer');
        if (btn && drawer) {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            drawer.classList.toggle('hidden');
          });

          // Tá»± Ä‘á»™ng Ä‘Ã³ng drawer khi click ra ngoÃ i
          document.addEventListener('click', (e) => {
            if (!drawer.classList.contains('hidden')) {
              if (!drawer.contains(e.target) && !btn.contains(e.target)) {
                drawer.classList.add('hidden');
              }
            }
          });
        }

        // Mobile Accordion Cáº¥p 1
        document.querySelectorAll('.mobile-accordion-btn').forEach((aBtn) => {
          aBtn.addEventListener('click', () => {
            const card = aBtn.closest('.rounded-2xl');
            if (!card) return;
            const content = card.querySelector('.mobile-accordion-content');
            const chevron = aBtn.querySelector('.mobile-chevron');
            if (content) {
              const isHidden = content.classList.toggle('hidden');
              aBtn.setAttribute('aria-expanded', !isHidden);
              if (chevron) {
                chevron.textContent = isHidden ? '▼' : '▲';
              }
            }
          });
        });

        // Mobile Sub-Accordion Cáº¥p 2
        document.querySelectorAll('.mobile-sub-toggle').forEach((sBtn) => {
          sBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const subCard = sBtn.closest('.rounded-xl');
            if (!subCard) return;
            const subContent = subCard.querySelector('.mobile-sub-content');
            const subChevron = sBtn.querySelector('.mobile-sub-chevron');
            if (subContent) {
              const isHidden = subContent.classList.toggle('hidden');
              if (subChevron) {
                subChevron.textContent = isHidden ? '▼' : '▲';
              }
            }
          });
        });
      })();

      // 2. Desktop dropdown menus: support both hover AND click toggle on all computers
      (function () {
        const navItems = document.querySelectorAll('.desktop-nav-item');
        const subItems = document.querySelectorAll('.desktop-sub-item');

        function closeAllDesktopMenus(exceptItem) {
          navItems.forEach((item) => {
            if (item !== exceptItem) {
              item.classList.remove('is-open');
              item.querySelectorAll('.desktop-sub-item.is-open').forEach((s) => s.classList.remove('is-open'));
            }
          });
        }

        navItems.forEach((item) => {
          let closeTimer = null;
          const dropdown = item.querySelector('.desktop-nav-dropdown');
          if (!dropdown) return;

          item.addEventListener('mouseenter', () => {
            if (closeTimer) clearTimeout(closeTimer);
            closeAllDesktopMenus(item);
            item.classList.add('is-open');
          });

          item.addEventListener('mouseleave', () => {
            closeTimer = setTimeout(() => {
              item.classList.remove('is-open');
              item.querySelectorAll('.desktop-sub-item.is-open').forEach((s) => s.classList.remove('is-open'));
            }, 120);
          });

          const toggleBtn = item.querySelector('.desktop-nav-toggle-btn');
          if (toggleBtn) {
            toggleBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const willOpen = !item.classList.contains('is-open');
              closeAllDesktopMenus(item);
              item.classList.toggle('is-open', willOpen);
            });
          }

          const triggerLink = item.querySelector('.desktop-nav-trigger');
          if (triggerLink) {
            triggerLink.addEventListener('click', (e) => {
              const href = triggerLink.getAttribute('href') || '';
              const normCurrent = window.location.pathname.replace(/\/+$/, '') || '/';
              const normTarget = href.replace(/\/+$/, '') || '/';
              if (normCurrent.toLowerCase() === normTarget.toLowerCase() || !item.classList.contains('is-open')) {
                if (normCurrent.toLowerCase() === normTarget.toLowerCase()) {
                  e.preventDefault();
                  e.stopPropagation();
                  const willOpen = !item.classList.contains('is-open');
                  closeAllDesktopMenus(item);
                  item.classList.toggle('is-open', willOpen);
                }
              }
            });
          }
        });

        subItems.forEach((sub) => {
          let subTimer = null;
          const subDropdown = sub.querySelector('.desktop-sub-dropdown');
          if (!subDropdown) return;

          sub.addEventListener('mouseenter', () => {
            if (subTimer) clearTimeout(subTimer);
            sub.parentElement?.querySelectorAll('.desktop-sub-item.is-open').forEach((s) => {
              if (s !== sub) s.classList.remove('is-open');
            });
            sub.classList.add('is-open');
          });

          sub.addEventListener('mouseleave', () => {
            subTimer = setTimeout(() => {
              sub.classList.remove('is-open');
            }, 120);
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.desktop-nav-item')) {
            closeAllDesktopMenus(null);
          }
        });
      })();

      // Auto-update current year across all elements
      (function () {
        const y = String(new Date().getFullYear());
        document.querySelectorAll('#currentYear, #footerYear, .js-current-year').forEach((el) => {
          el.textContent = y;
        });
        const dynTitle = document.getElementById('dynamic-academic-title');
        if (dynTitle) {
          dynTitle.textContent = 'GÓC HỌC TẬP NĂM ' + y;
        }
      })();
    </script>
  
        <script is:inline>
      /* Tự động thu nhỏ bảng biểu, sơ đồ, hình vẽ vừa khít màn hình điện thoại:
         - Không xuống dòng trong ô bảng (white-space: nowrap)
         - Không sử dụng thanh trượt ngang (overflow: hidden)
         - Tự động co giãn theo tỷ lệ (transform: scale) */
      (function () {
        function autoScaleAcademicMedia() {
          var isMobile = window.innerWidth <= 768;

          // 1. Co giãn bảng biểu
          document.querySelectorAll('.tkd-page-scope table, .tkd-academic-subpage table, main table').forEach(function(tbl) {
            var wrapper = tbl.parentElement;
            if (!wrapper || !wrapper.classList.contains('tkd-auto-scale-wrapper')) {
              var wrap = document.createElement('div');
              wrap.className = 'tkd-auto-scale-wrapper';
              wrap.style.width = '100%';
              wrap.style.overflow = 'hidden';
              wrap.style.position = 'relative';
              wrap.style.margin = '0.5rem 0';
              tbl.parentNode.insertBefore(wrap, tbl);
              wrap.appendChild(tbl);
              wrapper = wrap;
            }

            if (!isMobile) {
              tbl.style.transform = '';
              tbl.style.transformOrigin = '';
              tbl.style.width = '100%';
              wrapper.style.height = '';
              wrapper.style.overflow = '';
              return;
            }

            // Mobile: giữ ô không xuống dòng
            tbl.querySelectorAll('th, td').forEach(function(c) {
              c.style.setProperty('white-space', 'nowrap', 'important');
              c.style.setProperty('word-break', 'normal', 'important');
            });
            tbl.style.width = 'max-content';
            tbl.style.maxWidth = 'none';
            tbl.style.transform = 'none';

            var containerWidth = wrapper.clientWidth || (window.innerWidth - 32);
            var tableWidth = tbl.scrollWidth || tbl.offsetWidth;

            if (tableWidth > containerWidth && containerWidth > 0) {
              var scale = containerWidth / tableWidth;
              tbl.style.transform = 'scale(' + scale + ')';
              tbl.style.transformOrigin = 'top left';
              var scaledHeight = Math.ceil(tbl.offsetHeight * scale);
              wrapper.style.height = scaledHeight + 'px';
              wrapper.style.overflow = 'hidden';
            } else {
              tbl.style.transform = '';
              wrapper.style.height = '';
              wrapper.style.overflow = 'hidden';
            }
          });

          // 2. Co giãn biểu đồ, sơ đồ, SVG, hình ảnh
          document.querySelectorAll('.tkd-page-scope svg, .tkd-academic-subpage svg, .diagram, .flowchart, .svg-container svg, .tkd-page-scope img, .tkd-academic-subpage img').forEach(function(el) {
            el.style.maxWidth = '100%';
            el.style.height = 'auto';
            el.style.boxSizing = 'border-box';
            if (el.parentElement) {
              el.parentElement.style.overflowX = 'hidden';
              el.parentElement.style.maxWidth = '100%';
            }
          });

          // 3. Khử hoàn toàn thanh trượt ngang trên toàn bộ container
          document.querySelectorAll('.table-responsive, .table-container, .table-responsive-wrapper, .overflow-x-auto').forEach(function(c) {
            c.style.overflowX = 'hidden';
            c.style.maxWidth = '100%';
          });
        }

        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(autoScaleAcademicMedia, 150);
        });
        window.addEventListener('load', autoScaleAcademicMedia);
        document.addEventListener('DOMContentLoaded', autoScaleAcademicMedia);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          setTimeout(autoScaleAcademicMedia, 50);
        }
      })();
    </script>
  </body>
</html>

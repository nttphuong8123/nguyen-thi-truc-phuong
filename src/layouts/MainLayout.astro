---
import '../styles/global.css';
import { MAIN_NAVIGATION } from '../lib/navigation';
import { SILO_GROUPS, getSeoMetaForPath, type FaqItem } from '../lib/seo-meta';
import { getSiteContactConfig } from '../lib/db';

const contactCfg = getSiteContactConfig();
const cleanPhone = contactCfg.hotline.replace(/\s+/g, '');

export interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  customCss?: string;
  noindex?: boolean;
  faqs?: FaqItem[];
}

const {
  title,
  description,
  currentPath = '/',
  customCss = '',
  noindex = false,
  faqs: propFaqs,
} = Astro.props;

const normPath = currentPath === '/' ? '/' : currentPath.toLowerCase().replace(/\/+$/, '');
const seoMeta = getSeoMetaForPath(normPath, title);
const finalTitle = title && !title.startsWith('NGUYỄN THỊ TRÚC PHƯƠNG -') ? title : seoMeta.title;
const finalDescription =
  description && !description.includes('Tài liệu học tập, bài tập thực hành và công cụ hỗ trợ sinh viên trên cổng thông tin')
    ? description
    : seoMeta.description;

const canonicalUrl = new URL(normPath, Astro.site || 'https://nguyenthitrucphuong.pages.dev').toString();
const currentYear = new Date().getFullYear();

// Build Accurate Vietnamese BreadcrumbList JSON-LD
const breadcrumbItems: { '@type': string; position: number; name: string; item: string }[] = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Trang chủ',
    item: 'https://nguyenthitrucphuong.pages.dev/',
  },
];

if (normPath.startsWith('/study-corner') && normPath !== '/study-corner') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: 'Góc học tập',
    item: 'https://nguyenthitrucphuong.pages.dev/study-corner',
  });
}

if (normPath.startsWith('/goc-chia-se/') && normPath !== '/goc-chia-se') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: 'Góc chia sẻ',
    item: 'https://nguyenthitrucphuong.pages.dev/goc-chia-se',
  });
}

if (
  seoMeta.parentPath &&
  seoMeta.parentPath !== '/' &&
  seoMeta.parentPath !== '/study-corner' &&
  seoMeta.parentPath !== normPath
) {
  const parentMeta = getSeoMetaForPath(seoMeta.parentPath);
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: parentMeta.breadcrumbLabel,
    item: `https://nguyenthitrucphuong.pages.dev${seoMeta.parentPath}`,
  });
}

if (normPath !== '/') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: seoMeta.breadcrumbLabel,
    item: canonicalUrl,
  });
}

const silo = seoMeta.siloKey ? SILO_GROUPS[seoMeta.siloKey] : undefined;
const activeFaqs: FaqItem[] = propFaqs || seoMeta.faqs || silo?.defaultFaqs || [];

const graphNodes: Record<string, any>[] = [
  {
    '@type': 'WebSite',
    '@id': 'https://nguyenthitrucphuong.pages.dev/#website',
    url: 'https://nguyenthitrucphuong.pages.dev/',
    name: 'NGUYỄN THỊ TRÚC PHƯƠNG — Cổng Học Tập - Tri Thức Số',
    description: finalDescription,
    inLanguage: 'vi-VN',
    publisher: { '@id': 'https://nguyenthitrucphuong.pages.dev/#person' }, image: { '@type': 'ImageObject', '@id': 'https://nguyenthitrucphuong.pages.dev/#logo', url: 'https://nguyenthitrucphuong.pages.dev/images/logo-tp.svg', contentUrl: 'https://nguyenthitrucphuong.pages.dev/images/logo-tp.svg', width: 512, height: 512, caption: 'Logo TP — NGUYỄN THỊ TRÚC PHƯƠNG — Cổng Học Tập & Tri Thức Số' },
  },
  {
    '@type': 'Person',
    '@id': 'https://nguyenthitrucphuong.pages.dev/#person',
    name: contactCfg.instructor_name,
    jobTitle: 'Giảng viên Khoa Quản trị - Kinh doanh',
    worksFor: {
      '@type': 'CollegeOrUniversity',
      name: 'Trường Cao đẳng Kinh tế TP. Hồ Chí Minh (HCE)',
    },
    url: 'https://nguyenthitrucphuong.pages.dev/home/introduction',
    telephone: cleanPhone,
    email: contactCfg.email,
    address: contactCfg.address,
    sameAs: [
      contactCfg.youtube_url,
      contactCfg.tiktok_url,
    ],
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbItems,
  },
];

if (seoMeta.schemaType === 'Course') {
  graphNodes.push({
    '@type': 'Course',
    '@id': `${canonicalUrl}#course`,
    name: finalTitle,
    description: finalDescription,
    url: canonicalUrl,
    inLanguage: 'vi-VN',
    provider: {
      '@type': 'CollegeOrUniversity',
      name: 'Khoa Quản trị - Kinh doanh, Trường Cao đẳng Kinh tế TP.HCM (HCE)',
      sameAs: 'https://nguyenthitrucphuong.pages.dev/',
    },
    instructor: { '@id': 'https://nguyenthitrucphuong.pages.dev/#person' },
    isAccessibleForFree: true,
  });
} else if (seoMeta.schemaType === 'Quiz') {
  graphNodes.push({
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: finalTitle,
    description: finalDescription,
    url: canonicalUrl,
    inLanguage: 'vi-VN',
    educationalLevel: 'Đại học / Cao đẳng',
    author: { '@id': 'https://nguyenthitrucphuong.pages.dev/#person' },
    isAccessibleForFree: true,
  });
} else if (seoMeta.schemaType === 'LearningResource') {
  graphNodes.push({
    '@type': 'LearningResource',
    '@id': `${canonicalUrl}#resource`,
    name: finalTitle,
    description: finalDescription,
    url: canonicalUrl,
    inLanguage: 'vi-VN',
    learningResourceType: 'Bài giảng, Hướng dẫn giải bài tập - Đề cương học thuật',
    author: { '@id': 'https://nguyenthitrucphuong.pages.dev/#person' },
    isAccessibleForFree: true,
  });
}

if (activeFaqs.length > 0 && !noindex) {
  graphNodes.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: activeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};

// Cấu hình giao diện Mobile Drawer sinh động & hiện đại theo Design System
const TOP_NAV_META: Record<string, { icon: string; bg: string; subtitle: string }> = {
  'Trang chủ': { icon: '🏠', bg: 'bg-[#C65B69]', subtitle: 'Thông tin Giảng viên & Hoạt động' },
  'Góc học tập': { icon: '📚', bg: 'bg-[#A83245] ring-1 ring-[#C65B69]/50', subtitle: 'Bài giảng, Đề cương & Bài tập' },
  'Thi Online': { icon: '⚡', bg: 'bg-[#C65B69] text-white', subtitle: 'Ngân hàng Đề thi Trắc nghiệm Live' },
  'SPSS - Phần mềm': { icon: '📈', bg: 'bg-[#A83245]', subtitle: 'Xử lý Dữ liệu & Kho Phần mềm' },
  
  
  'Liên hệ': { icon: '📬', bg: 'bg-[#C65B69]', subtitle: 'Liên hệ Giảng viên & Góp ý' },
};

const SUB_NAV_ICONS: Record<string, string> = {
  'Giới thiệu Giảng viên': '👨‍🏫',
  'Hoạt động Giảng dạy': '📖',
  'Cố vấn học tập (CVHT)': '🤝',
  'Góc chia sẻ - Tin tức': '📰',
  'Kiến thức Marketing - AI': '🤖',
  '5. Marketing căn bản': '📣',
  '6. Kinh tế vi mô': '📊',
  '7. Hướng dẫn thực tập': '🎓',
  '8. Khởi nghiệp': '🚀',
  'Chuyên đề IMC (Truyền thông)': '📢',
  'Hướng dẫn xử lý dữ liệu SPSS': '📊',
  'Khảo sát NCKH Sinh viên': '📝',
  'Kho Phần mềm (SPSS, POM-QM)': '💻',
  'Thông tin Liên hệ - Góp ý': '📮',
  'Phiếu Đánh giá Giảng viên': '⭐',
  };

function getLeafIcon(label: string): string {
  const l = label.toLowerCase();
  if (l.includes('bài giảng') || l.includes('slide') || l.includes('đề cương')) return '📖';
  if (l.includes('đề thi') || l.includes('trắc nghiệm') || l.includes('test')) return '📝';
  if (l.includes('bài tập') || l.includes('hướng dẫn giải') || l.includes('tự luận')) return '💡';
  if (l.includes('phần mềm') || l.includes('pom') || l.includes('casio') || l.includes('spss')) return '💻';
  if (l.includes('báo cáo') || l.includes('mẫu')) return '📑';
  if (l.includes('tra cứu') || l.includes('dcct')) return '🔍';
  if (l.includes('trích dẫn')) return '📌';
  return '🔹';
}

---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="NGUYỄN THỊ TRÚC PHƯƠNG" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content="https://nguyenthitrucphuong.pages.dev/images/og-default.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" /><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" /><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />

    <!-- Google Fonts: Non-blocking Preload with Display Swap (Be Vietnam Pro, Noto Serif, Roboto Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Noto+Serif:ital,wght@0,600;0,700;1,400&family=Roboto+Mono:wght@500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Noto+Serif:ital,wght@0,600;0,700;1,400&family=Roboto+Mono:wght@500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Noto+Serif:ital,wght@0,600;0,700;1,400&family=Roboto+Mono:wght@500;700&display=swap"
      />
    </noscript>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

        <style is:inline>
      /* Cố định tuyệt đối thanh điều hướng chính ở đỉnh màn hình, không trôi khi cuộn */
      #mainNavbar,
      nav[aria-label="Điều hướng chính"],
      .site-sticky-navbar {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100% !important;
        z-index: 100 !important;
      }
      body {
        padding-top: 4rem !important; /* 64px tương ứng đúng chiều cao thanh điều hướng */
      }

      /* Khoảng đệm an toàn dưới cùng cho trang web */
      main, .site-main-content, #mainContent {
        padding-bottom: 0 !important;
      }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
    {customCss && <style is:inline set:html={customCss} />}
  </head>
  <body class="min-h-screen flex flex-col bg-[#F7F5F2] text-[#303039] antialiased selection:bg-[#C65B69] selection:text-white pt-14 sm:pt-16">
    <!-- Top Academic Navigation Bar (Cố định ở đỉnh màn hình, không trôi khi cuộn) -->
    <nav id="mainNavbar" aria-label="Điều hướng chính" class="site-sticky-navbar fixed top-0 left-0 right-0 w-full z-50 bg-[#A83245]/98 backdrop-blur-md text-white border-b border-[#C65B69]/40 shadow-sm">
      <div class="max-w-7xl mx-auto px-2 sm:px-6">
        <div class="flex items-center justify-between h-14 sm:h-16 gap-1 sm:gap-4">
          <!-- Brand Logo TP® -->
          <a
            href="/"
            title="Về Trang chủ Cổng Học Tập - Tri Thức Số NGUYỄN THỊ TRÚC PHƯƠNG"
            class="group flex items-center gap-1.5 sm:gap-2.5 font-extrabold text-xs sm:text-base tracking-tight text-white hover:text-[#F8EDEF] transition-colors min-w-0 shrink"
          >
            <span class="inline-flex items-center justify-center w-8 h-8 sm:w-11 sm:h-11 rounded-lg sm:rounded-xl bg-gradient-to-br from-[#F7F5F2] via-[#FFFFFF] to-[#F8EDEF] border border-[#F8EDEF]/90 text-[#A83245] font-black text-base sm:text-2xl shadow-sm tracking-tighter shrink-0 select-none group-hover:scale-105 transition-transform">
              TP<sup class="text-[7.5px] sm:text-[10px] -top-1.5 ml-0.5 font-bold text-[#C65B69]">®</sup>
            </span>
            <span class="leading-tight block min-w-0">
              <span class="block text-[12px] sm:text-base font-extrabold tracking-tight sm:tracking-wide whitespace-nowrap">NGUYỄN THỊ TRÚC PHƯƠNG</span>
              <span class="block text-[5.8px] sm:text-[7.2px] text-[#F8EDEF] font-semibold tracking-tight uppercase whitespace-nowrap">Cổng Học Tập - Tri Thức Số<sup class="text-[4.5px] sm:text-[5.5px] leading-none relative -top-[2px] ml-[0.5px] font-bold">®</sup></span>
            </span>
          </a>

          <!-- Desktop Menu -->
          <div class="hidden lg:flex items-center gap-1 xl:gap-1.5">
            {MAIN_NAVIGATION.map((item, navIdx) => {
              const hasActiveChild =
                item.children?.some(
                  (sub) =>
                    normPath === sub.href.toLowerCase() ||
                    normPath.startsWith(sub.href.toLowerCase() + '/')
                ) ?? false;
              const isActive =
                item.href === '/'
                  ? normPath === '/' || hasActiveChild
                  : normPath === item.href.toLowerCase() ||
                    normPath.startsWith(item.href.toLowerCase() + '/') ||
                    hasActiveChild;
              const alignRight = navIdx >= MAIN_NAVIGATION.length - 2;
              return (
                <div class="relative group desktop-nav-item">
                  <div
                    class={`rounded-lg text-[13px] font-semibold flex items-center whitespace-nowrap shrink-0 transition-all ${
                      isActive
                        ? 'bg-[#C65B69] text-white shadow-xs ring-1 ring-[#F8EDEF]/60'
                        : 'text-slate-100 hover:bg-[#C65B69]/55 hover:text-white'
                    }`}
                  >
                    <a
                      href={item.href}
                      title={`Truy cập chuyên mục ${item.label} trên cổng học tập`}
                      class={`py-2 flex items-center gap-1.5 ${item.children ? 'pl-3 pr-1.5 desktop-nav-trigger' : 'px-3'}`}
                    >
                      <span>{item.label}</span>
                      {item.badge === 'LOCK' && (
                        <span aria-hidden="true" class="text-[11px] opacity-80 leading-none">
                          🔒
                        </span>
                      )}
                      {item.badge && item.badge !== 'LOCK' && (
                        <span class="px-1.5 py-0.5 text-[10px] leading-none rounded-md bg-[#F8EDEF] text-[#A83245] font-black uppercase tracking-wider whitespace-nowrap shadow-2xs">
                          {item.badge}
                        </span>
                      )}
                    </a>
                    {item.children && (
                      <button
                        type="button"
                        aria-label={`Mở danh mục con ${item.label}`}
                        class="desktop-nav-toggle-btn pr-2.5 pl-1 py-2 flex items-center justify-center cursor-pointer focus:outline-none"
                      >
                        <svg aria-hidden="true" class="desktop-nav-chevron w-3.5 h-3.5 opacity-80 transition-transform duration-150 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </button>
                    )}
                  </div>

                  {item.children && (
                    <div class={`desktop-nav-dropdown absolute ${alignRight ? 'right-0' : 'left-0'} top-full pt-1.5 w-64 z-50`}>
                      <div class="bg-white text-slate-800 rounded-xl shadow-2xl border border-slate-200 py-1.5 ring-1 ring-black/5">
                        {item.children.map((sub) => (
                          <div class="relative group/sub desktop-sub-item">
                            <a
                              href={sub.href}
                              title={`Mở học phần và tài liệu ${sub.label}`}
                              class="flex items-center justify-between px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-[#F8EDEF] hover:text-[#A83245] transition-colors"
                            >
                              <span>{sub.label}</span>
                              {sub.children && <span aria-hidden="true" class="text-slate-400 text-[10px] ml-2">▶</span>}
                            </a>
                            {sub.children && (
                              <div class={`desktop-sub-dropdown absolute ${alignRight ? 'right-full pr-1' : 'left-full pl-1'} top-0 w-64 z-50`}>
                                <div class="bg-white rounded-xl shadow-2xl border border-slate-200 py-1.5 ring-1 ring-black/5">
                                  {sub.children.map((leaf) => (
                                    <a
                                      href={leaf.href}
                                      title={`Xem chi tiết ${leaf.label} (${sub.label})`}
                                      class="block px-3.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-[#F8EDEF] hover:text-[#A83245]"
                                    >
                                      {leaf.label}
                                    </a>
                                  ))}
                                </div>
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>

          <!-- Mobile Hamburger Button & Quick Action -->
          <div class="flex items-center gap-1 sm:gap-2 shrink-0 lg:hidden">
            <a
              href="/ngan-hang-de-thi"
              title="Làm bài thi trắc nghiệm trực tuyến 50 câu trong 60 phút"
              class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-[#C65B69] hover:bg-[#A83245] border border-[#C65B69]/60 text-white font-extrabold text-[11px] sm:text-xs whitespace-nowrap shadow-sm active:scale-95 transition-all shrink-0"
            >
              <span class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-[#742D3A] flex items-center justify-center text-[7px] sm:text-[8px] text-[#F8EDEF] pl-0.5 select-none font-bold">▶</span>
              <span>Thi Online</span>
            </a>
            <button
              id="mobileMenuBtn"
              type="button"
              aria-label="Mở menu điều hướng"
              class="p-1.5 sm:p-2 rounded-lg text-white hover:bg-[#C65B69]/50 focus:outline-none shrink-0 cursor-pointer"
            >
              <svg aria-hidden="true" class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

            <!-- Mobile Drawer Sang Trọng, Sinh Động & Hiện Đại -->
      <div
        id="mobileMenuDrawer"
        class="hidden lg:hidden bg-gradient-to-b from-[#742D3A] via-[#A83245] to-[#742D3A] border-t border-[#C65B69]/40 px-3 pt-3 pb-8 max-h-[85vh] overflow-y-auto shadow-2xl backdrop-blur-xl"
      >
        <!-- Header Banner trong Drawer -->
        <div class="flex items-center justify-between p-3 mb-3 rounded-2xl bg-gradient-to-r from-[#A83245] via-[#C65B69]/70 to-[#A83245] border border-[#F8EDEF]/40 shadow-md">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-[#F7F5F2] via-[#FFFFFF] to-[#F8EDEF] border border-[#F8EDEF]/90 text-[#A83245] font-black text-xl shadow-sm tracking-tighter shrink-0 select-none">
              TP<sup class="text-[8px] -top-1.5 ml-0.5 font-bold text-[#C65B69]">®</sup>
            </span>
            <div>
              <div class="text-xs sm:text-sm font-black uppercase text-white tracking-wide flex items-center gap-1.5">
                <span>NGUYỄN THỊ TRÚC PHƯƠNG</span>
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              </div>

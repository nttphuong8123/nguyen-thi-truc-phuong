        return "👦 **Tướng quân ơi, khoan đã nào!** ✋\n\nTrước khi Toro lấy thông tin từ website để trả lời, đồng đội vui lòng **viết hoa đúng tên riêng** (viết hoa chữ cái đầu mỗi chữ trong tên riêng của Thầy/Cô) rồi nhắn lại giúp Toro nhé!\n\n💡 Việc **viết hoa tên riêng** chính là thể hiện **sự tôn trọng** đối với Thầy/Cô và là **văn hóa ứng xử**, giao tiếp lịch sự của sinh viên chúng mình đó nha! Đồng đội nhắn lại tên viết hoa chuẩn chỉ là Toro hỗ trợ ngay lập tức nè! 🤝✨";
      }
      return "🎀 **Bạn ơi, chờ Susi một xíu nhé!** ✋🌷\n\nTrước khi Susi lấy thông tin từ website để gửi cho bạn, bạn vui lòng **viết hoa đúng tên riêng** (viết hoa chữ cái đầu mỗi chữ trong tên riêng của Thầy/Cô) rồi nhắn lại giúp Susi nha!\n\n💡 Việc **viết hoa tên riêng** thể hiện **sự tôn trọng** đối với Thầy/Cô và là **văn hóa ứng xử** đẹp, văn minh trong môi trường học đường đó nè. Bạn nhắn lại tên viết hoa đúng chuẩn để Susi hỗ trợ ngay nhé! ✨🌸";
    }

    function logQuestionAndAnswer(questionText, answerText) {
      try {
        fetch('/api/chat-logs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            character: currentCharacter,
            question: questionText,
            answer: answerText,
            source: window.location.pathname || '/tro-ly-toro'
          })
        }).catch(() => {});
      } catch (_) {}
    }

    async function sendMessage() {
      const input = document.getElementById('chatInput');
      const text = input.value.trim();
      if (!text) return;

      appendUserMessage(text);
      input.value = '';
      autoResizeTextarea(input);

      if (hasProfanity(text)) {
        const profReply = getProfanityReply(currentCharacter);
        appendBotMessage(profReply);
        logQuestionAndAnswer(text, profReply);
        return;
      }

      if (hasUncapitalizedProperName(text)) {
        const reminderReply = getProperNameReminderReply(currentCharacter);
        appendBotMessage(reminderReply);
        logQuestionAndAnswer(text, reminderReply);
        return;
      }

      const loadingId = 'loading-' + Date.now();
      appendLoadingIndicator(loadingId);
      updateStatusDisplay('Đang trả lời...', true);

      try {
        const reply = await callGeminiAPI(text);
        removeLoadingIndicator(loadingId);
        appendBotMessage(reply);
        logQuestionAndAnswer(text, reply);
        updateStatusDisplay('Đang trực tuyến • HCE', false);
      } catch (err) {
        console.error("Lỗi:", err);
        removeLoadingIndicator(loadingId);
        updateStatusDisplay('Lỗi kết nối', false);
        
        let errDesc = `Có lỗi khi kết nối: ${err.message || err}`;
        if (err.message && err.message.includes('API key')) {
          errDesc = `**Chưa cài đặt API Key.** Bạn vui lòng chạm vào biểu tượng chìa khóa 🔑 ở góc trên để cấu hình Gemini API Key nhé!`;
        }
        appendBotMessage(errDesc, true);
      }
    }

    const FAST_MODELS = [
      "gemini-2.5-flash",
      "gemini-2.0-flash",
      "gemini-1.5-flash",
      "gemini-1.5-flash-8b",
      "gemini-1.5-pro"
    ];

    async function callGeminiAPI(promptText) {
      const activeKey = (savedApiKey || "").trim();

      const charInstruction = `HIỆN TẠI BẠN ĐANG ĐÓNG VAI: ${currentCharacter}. Hãy duy trì đúng xưng hô, phong cách ngôn từ của ${currentCharacter}.`;

      conversationHistory.push({
        role: "user",
        parts: [{ text: promptText }]
      });

      const payload = {
        contents: conversationHistory,
        systemInstruction: {
          parts: [{ text: `${getSystemInstruction()}\n\n${charInstruction}` }]
        },
        generationConfig: {
          temperature: 0.2,
          maxOutputTokens: 2048
        }
      };

      let reply = "";
      let lastError = null;

      try {
        if (activeKey.startsWith('AIzaSy')) {
          for (const model of FAST_MODELS) {
            try {
              const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(activeKey)}`;
              const controller = new AbortController();
              const timeoutId = setTimeout(() => controller.abort(), 4500);

              const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
                signal: controller.signal
              });
              clearTimeout(timeoutId);

              const data = await res.json().catch(() => ({}));

              if (res.ok) {
                reply = (data.candidates?.[0]?.content?.parts || [])
                  .map(p => p.text || '')
                  .join('')
                  .trim();
                if (reply) break;
              } else {
                lastError = new Error(data.error?.message || `Lỗi HTTP ${res.status}`);
              }
            } catch (fetchErr) {
              lastError = fetchErr;
            }
          }
        }

        if (!reply) {
          try {
            const proxyController = new AbortController();
            const proxyTimeoutId = setTimeout(() => proxyController.abort(), 6000);
            const proxyRes = await fetch('/api/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ payload, character: currentCharacter, apiKey: activeKey || undefined }),
              signal: proxyController.signal
            });
            clearTimeout(proxyTimeoutId);
            const proxyData = await proxyRes.json().catch(() => ({}));
            if (proxyRes.ok) {
              reply = (proxyData.candidates?.[0]?.content?.parts || [])
                .map(p => p.text || '')
                .join('')
                .trim();
            }
          } catch (_) {}
        }

        if (!reply) {
          throw lastError || new Error("Không thể kết nối đến máy chủ AI, vui lòng thử lại.");
        }
      } catch (e) {
        conversationHistory.pop();
        throw e;
      }

      conversationHistory.push({
        role: "model",
        parts: [{ text: reply }]
      });

      if (conversationHistory.length > 20) {
        conversationHistory = conversationHistory.slice(-14);
      }

      return reply;
    }

    function appendUserMessage(text) {
      const container = document.getElementById('chatMessagesContainer');
      const div = document.createElement('div');
      div.className = "flex justify-end items-start gap-2";
      const isToro = currentCharacter === 'TORO';
      const userBubbleBg = isToro
        ? 'bg-gradient-to-r from-[#8B1E2D] to-[#C62828] text-white'
        : 'bg-gradient-to-r from-pink-500 to-rose-500 text-white';
      div.innerHTML = `
        <div class="${userBubbleBg} px-4 py-2.5 rounded-2xl rounded-tr-xs max-w-[85%] shadow-xs text-xs sm:text-sm leading-relaxed whitespace-pre-wrap">
          ${escapeHtml(text)}
        </div>
      `;
      container.appendChild(div);
      scrollToBottom();
    }

    function appendBotMessage(markdownText, isError = false) {
      let finalMd = String(markdownText || '')
        .replace(/["“”']?\s*cây đa\s*,?\s*cây đề\s*["“”']?/gi, 'giảng viên')
        .replace(/(?:theo\s+)?danh\s+sách\s+188\s*(?:cán\s+bộ|cb[\s-]*gv[\s-]*nv|giảng\s+viên)[^.,;\n]*/gi, 'thông tin trên website nhà trường')
        .replace(/188\s*(?:cán\s+bộ|cb[\s-]*gv[\s-]*nv|giảng\s+viên)/gi, 'thông tin trên website nhà trường')
        .replace(/(?:mục\s+)?(?:google\s*drive|gg\s*drive|drive\.google\.com[^\s)]*)/gi, 'website học liệu https://nguyenthitrucphuong.pages.dev/')
        .trim();
      if (!isError && !finalMd.includes('Vì tôi là một AI nên có thể mắc sai sót khi trả lời')) {
        finalMd += '\n\n*Vì tôi là một AI nên có thể mắc sai sót khi trả lời.*';
      }
      markdownText = finalMd;
      const container = document.getElementById('chatMessagesContainer');
      const div = document.createElement('div');
      div.className = "w-full";

      const isToro = currentCharacter === 'TORO';
      const avatarIcon = isToro ? '👦' : '🎀';
      const avatarName = isToro ? 'Trợ lý Toro' : 'Trợ lý Susi';
      const avatarBg = isToro
        ? 'from-[#8B1E2D] to-[#C62828] text-white'
        : 'from-pink-500 to-rose-500 text-white';
      const nameColor = isToro ? 'text-[#8B1E2D]' : 'text-pink-600';

      let parsedHtml = "";
      try {
        parsedHtml = marked.parse(markdownText);
      } catch (e) {
        parsedHtml = markdownText.replace(/\n/g, '<br>');
      }

      const cardStyle = isError 
        ? 'bg-rose-50 border border-rose-200 text-rose-800' 
        : 'bg-white text-slate-800 border border-[#CBD5E1]/90 shadow-xs';

      div.innerHTML = `
        <div class="${cardStyle} p-3.5 sm:p-4 rounded-2xl text-xs sm:text-sm leading-relaxed w-full">
          <div class="flex items-center gap-1.5 mb-2 pb-1.5 border-b border-slate-100">
            <span class="w-5 h-5 rounded-md bg-gradient-to-tr ${avatarBg} inline-flex items-center justify-center text-[11px] shrink-0 shadow-2xs">${avatarIcon}</span>
            <span class="text-[11px] font-extrabold uppercase tracking-wide ${nameColor}">${avatarName}</span>
          </div>
          <div class="chat-markdown">
            ${parsedHtml}
          </div>
        </div>
      `;
      container.appendChild(div);
      scrollToBottom();
    }

    function appendLoadingIndicator(id) {
      const container = document.getElementById('chatMessagesContainer');
      const div = document.createElement('div');
      div.id = id;
      div.className = "flex items-center gap-2";

      const isToro = currentCharacter === 'TORO';
      const avatarIcon = isToro ? '👦' : '🎀';
      const avatarBg = isToro ? 'from-[#8B1E2D] to-[#C62828] text-white' : 'from-pink-500 to-rose-500 text-white';
      const dotColor = isToro ? 'bg-[#8B1E2D]' : 'bg-pink-500';

      div.innerHTML = `
        <div class="bg-white border border-[#CBD5E1]/90 px-3.5 py-2.5 rounded-2xl text-xs text-slate-600 flex items-center gap-2 shadow-2xs">
          <span class="w-5 h-5 rounded-md bg-gradient-to-tr ${avatarBg} inline-flex items-center justify-center text-[11px] shrink-0">${avatarIcon}</span>
          <span class="font-medium">${isToro ? 'Toro đang suy nghĩ...' : 'Susi đang tra cứu...'}</span>
          <div class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 ${dotColor} rounded-full typing-dot"></span>
            <span class="w-1.5 h-1.5 ${dotColor} rounded-full typing-dot"></span>
            <span class="w-1.5 h-1.5 ${dotColor} rounded-full typing-dot"></span>
          </div>
        </div>
      `;
      container.appendChild(div);
      scrollToBottom();
    }

    function removeLoadingIndicator(id) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }

    function scrollToBottom() {
      const container = document.getElementById('chatMessagesContainer');
      if (!container) return;
      const lastChild = container.lastElementChild;
      if (lastChild) {
        lastChild.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function updateStatusDisplay(text, isBusy) {
      const el = document.getElementById('charStatusText');
      if (isBusy) {
        el.className = "text-[11px] text-amber-300 flex items-center gap-1.5 mt-0.5 whitespace-nowrap";
        el.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-300 animate-pulse shrink-0"></span> <span>${text}</span>`;
      } else {
        el.className = "text-[11px] text-emerald-300 flex items-center gap-1.5 mt-0.5 whitespace-nowrap";
        el.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span> <span>${text}</span>`;
      }
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function openApiKeyModal() {
      const input = document.getElementById('apiKeyInputField');
      input.value = savedApiKey || "";
      document.getElementById('apiKeyModal').classList.remove('hidden');
      input.focus();
    }

    function closeApiKeyModal() {
      document.getElementById('apiKeyModal').classList.add('hidden');
    }

    function saveApiKey() {
      const input = document.getElementById('apiKeyInputField');
      savedApiKey = input.value.trim();
      localStorage.setItem('hce_gemini_api_key', savedApiKey);
      updateApiKeyStatusIndicator();
      closeApiKeyModal();
      appendBotMessage(`Đã cập nhật khóa API thành công! ${currentCharacter === 'TORO' ? 'Toro' : 'Susi'} đã sẵn sàng.`);
    }

    function clearApiKey() {
      savedApiKey = "";
      localStorage.removeItem('hce_gemini_api_key');
      document.getElementById('apiKeyInputField').value = "";
      updateApiKeyStatusIndicator();
      closeApiKeyModal();
      appendBotMessage("Đã xóa khóa API.");
    }

        function updateApiKeyStatusIndicator() {
      const icon = document.getElementById('apiKeyIcon');
      if (!icon) return;
      if (savedApiKey && savedApiKey.trim() !== '') {
        icon.classList.remove('text-amber-300');
        icon.classList.add('text-emerald-300');
      } else {
        icon.classList.remove('text-emerald-300');
        icon.classList.add('text-amber-300');
      }
    }

    // Gắn toàn bộ hàm xử lý lên window (vì Astro define:vars bọc script trong IIFE)
    Object.assign(window, {
      sendMessage,
      handleInputKeyDown,
      autoResizeTextarea,
      clearInputText,
      selectCharacter,
      confirmResetConversation,
      quickAsk,
      openApiKeyModal,
      closeApiKeyModal,
      saveApiKey,
      clearApiKey
    });

    // Đồng thời gắn trực tiếp addEventListener để đảm bảo hoạt động tức thì
    function bindChatControls() {
      const btnSend = document.getElementById('btnSendMessage');
      const chatInputEl = document.getElementById('chatInput');
      const clearBtnEl = document.getElementById('clearInputBtn');
      const btnToroEl = document.getElementById('btnSelectToro');
      const btnSusiEl = document.getElementById('btnSelectSusi');
      const btnResetEl = document.getElementById('btnResetConversation');

      if (btnSend && !btnSend.dataset.bound) {
        btnSend.dataset.bound = '1';
        btnSend.removeAttribute('onclick');
        btnSend.addEventListener('click', (e) => {
          e.preventDefault();
          sendMessage();
        });
      }
      if (chatInputEl && !chatInputEl.dataset.bound) {
        chatInputEl.dataset.bound = '1';
        chatInputEl.removeAttribute('onkeydown');
        chatInputEl.removeAttribute('oninput');
        chatInputEl.addEventListener('keydown', (e) => handleInputKeyDown(e));
        chatInputEl.addEventListener('input', () => autoResizeTextarea(chatInputEl));
      }
      if (clearBtnEl && !clearBtnEl.dataset.bound) {
        clearBtnEl.dataset.bound = '1';
        clearBtnEl.removeAttribute('onclick');
        clearBtnEl.addEventListener('click', () => clearInputText());
      }
      if (btnToroEl && !btnToroEl.dataset.bound) {
        btnToroEl.dataset.bound = '1';
        btnToroEl.removeAttribute('onclick');
        btnToroEl.addEventListener('click', () => selectCharacter('TORO'));
      }
      if (btnSusiEl && !btnSusiEl.dataset.bound) {
        btnSusiEl.dataset.bound = '1';
        btnSusiEl.removeAttribute('onclick');
        btnSusiEl.addEventListener('click', () => selectCharacter('SUSI'));
      }
      if (btnResetEl && !btnResetEl.dataset.bound) {
        btnResetEl.dataset.bound = '1';
        btnResetEl.removeAttribute('onclick');
        btnResetEl.addEventListener('click', () => confirmResetConversation());
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindChatControls);
    } else {
      bindChatControls();
    }
  </script>
</MainLayout>

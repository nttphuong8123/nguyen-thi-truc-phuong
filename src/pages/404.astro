---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteData';
---

<Layout
  title={`404 — Không Tìm Thấy Trang • ${siteConfig.name}`}
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được chuyển đến địa chỉ mới."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    
    <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-[#176B52] to-[#243A32] border-2 border-[#C6A66B] flex items-center justify-center shadow-lg">
      <span class="font-serif font-bold text-3xl text-[#FFE094]">404</span>
    </div>

    <span class="inline-block px-4 py-1.5 rounded-full bg-[#E8EFE9] border border-[#C6A66B]/50 text-xs font-semibold text-[#176B52] uppercase tracking-widest mb-4">
      Lối Nhỏ Chưa Đặt Tên
    </span>

    <h1 class="font-serif font-extrabold text-3xl sm:text-5xl text-[#176B52] mb-4">
      Không Tìm Thấy Trang Này
    </h1>

    <p class="text-base sm:text-lg text-[#243A32]/80 max-w-lg mx-auto mb-10 leading-relaxed">
      Trang bạn tìm kiếm có thể đã được di dời hoặc liên kết chưa chính xác. Hãy để Trúc Phương dẫn lối bạn trở về không gian chính nhé.
    </p>

    <!-- Quick Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
      <a
        href="/"
        class="px-8 py-3.5 rounded-full font-semibold text-sm text-[#F7F5ED] bg-gradient-to-r from-[#176B52] to-[#287FA0] hover:from-[#135742] hover:to-[#1e6680] shadow-md transition-all duration-300"
      >
        Trở Về Trang Chủ
      </a>
      <a
        href="/tin-tuc"
        class="px-8 py-3.5 rounded-full font-semibold text-sm text-[#176B52] bg-white border border-[#C6A66B] hover:bg-[#E8EFE9] shadow-xs transition-all duration-300"
      >
        Đọc Bài Viết Mới
      </a>
      <a
        href="/lien-he"
        class="px-8 py-3.5 rounded-full font-semibold text-sm text-[#243A32] bg-white border border-[#C6A66B] hover:bg-[#E8EFE9] shadow-xs transition-all duration-300"
      >
        Liên Hệ
      </a>
    </div>

    <div class="pt-8 border-t border-[#C6A66B]/25 text-xs text-[#243A32]/60">
      {siteConfig.name} • Thạch Lựu Mộc 1981 • <a href="/" class="text-[#176B52] underline">nguyenthitrucphuong.pages.dev</a>
    </div>

  </div>
</Layout>

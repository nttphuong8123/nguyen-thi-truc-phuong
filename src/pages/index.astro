  <style>
    .birthday-scroll-track {
      animation: birthdayVerticalScroll var(--scroll-duration, 55s) linear infinite;
    }
    .birthday-scroll-track.is-paused,
    .birthday-scroll-track:hover {
      animation-play-state: paused !important;
    }
    @keyframes birthdayVerticalScroll {
      0% {
        transform: translateY(0);
      }
      100% {
        transform: translateY(-50%);
      }
    }
  </style>

  <script is:inline define:vars={{ rawBirthdays: monthBirthdays, currentDay, currentMonth }}>
    const allList = Array.isArray(rawBirthdays) ? rawBirthdays : [];
    const bdayWrapper = document.getElementById('bdayScrollWrapper');
    const bdayTrack = document.getElementById('bdayScrollTrack');
    const togglePauseBtn = document.getElementById('toggleBdayPauseBtn');

    const btnToday = document.getElementById('filterBdayTodayBtn');
    const btnMonth = document.getElementById('filterBdayMonthBtn');

    let currentFilter = 'month';
    let isPaused = false;

    function renderBdayList(filter) {
      currentFilter = filter;
      let filtered = [];

      if (filter === 'today') {
        filtered = allList.filter((b) => Number(b.birth_day) === currentDay && Number(b.birth_month) === currentMonth);
        if (btnToday) btnToday.className = 'px-2.5 py-1 rounded-lg border font-bold transition-all bg-rose-600 border-rose-600 text-white shadow-2xs cursor-pointer';
        if (btnMonth) btnMonth.className = 'px-2.5 py-1 rounded-lg border font-bold transition-all bg-white border-rose-200 text-slate-700 hover:bg-rose-100 cursor-pointer';
      } else {
        filtered = allList
          .filter((b) => Number(b.birth_month) === currentMonth)
          .sort((a, b) => {
            const aToday = Number(a.birth_day) === currentDay ? 0 : 1;
            const bToday = Number(b.birth_day) === currentDay ? 0 : 1;
            if (aToday !== bToday) return aToday - bToday;
            return Number(a.birth_day) - Number(b.birth_day);
          });
        if (btnToday) btnToday.className = 'px-2.5 py-1 rounded-lg border font-bold transition-all bg-white border-rose-200 text-slate-700 hover:bg-rose-100 cursor-pointer';
        if (btnMonth) btnMonth.className = 'px-2.5 py-1 rounded-lg border font-bold transition-all bg-rose-600 border-rose-600 text-white shadow-2xs cursor-pointer';
      }

      if (!bdayTrack) return;

      if (filtered.length === 0) {
        bdayTrack.className = 'space-y-2.5 p-4 text-center text-xs text-rose-800';
        bdayTrack.innerHTML = '<div class="p-6 bg-white rounded-xl border border-rose-200 text-rose-700 font-medium">🌸 Chưa có sinh nhật nào trong mục này.</div>';
        return;
      }

      const durationSec = Math.max(45, filtered.length * 5.5);
      if (bdayWrapper) {
        bdayWrapper.style.setProperty('--scroll-duration', `${durationSec}s`);
      }

      const renderList = filtered.length >= 3 ? [...filtered, ...filtered] : filtered;
      bdayTrack.className = filtered.length >= 3 ? 'birthday-scroll-track space-y-2.5' : 'space-y-2.5';
      if (isPaused) bdayTrack.classList.add('is-paused');

      bdayTrack.innerHTML = renderList
        .map((b) => {
          const isTodayBday = Number(b.birth_day) === currentDay && Number(b.birth_month) === currentMonth;
          return `
            <div class="p-2.5 sm:p-3 rounded-xl bg-white border shadow-2xs flex items-start gap-2.5 transition-colors ${
              isTodayBday
                ? 'border-rose-400 ring-1 ring-rose-200 bg-rose-50/30'
                : 'border-rose-200/80 hover:border-rose-400'
            }">
              <span class="text-xl shrink-0 mt-0.5">${isTodayBday ? '🎉' : b.avatar_emoji || '🎂'}</span>
              <div class="text-xs leading-snug flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <strong class="text-rose-950 font-extrabold text-xs sm:text-sm truncate">${b.full_name}</strong>
                  <span class="num-font text-[11px] font-bold px-2 py-0.5 rounded-md shrink-0 ${
                    isTodayBday ? 'bg-rose-600 text-white' : 'bg-rose-100 text-rose-700'
                  }">
                    ${isTodayBday ? '🎂 Hôm nay • ' : ''}${String(b.birth_day).padStart(2, '0')}/${String(b.birth_month).padStart(2, '0')}
                  </span>
                </div>
                <p class="text-[11px] text-rose-700 font-semibold mt-0.5">${b.role_or_class || 'Sinh viên'}</p>
                <p class="text-slate-700 italic mt-1 text-xs leading-snug">“${b.wish_message}”</p>
              </div>
            </div>
          `;
        })
        .join('');
    }

    if (btnToday) btnToday.addEventListener('click', () => renderBdayList('today'));
    if (btnMonth) btnMonth.addEventListener('click', () => renderBdayList('month'));

    if (togglePauseBtn) {
      togglePauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        togglePauseBtn.textContent = isPaused ? '▶️' : '⏸️';
        if (bdayTrack) {
          if (isPaused) bdayTrack.classList.add('is-paused');
          else bdayTrack.classList.remove('is-paused');
        }
      });
    }

    // Đồng bộ nền Tin Chứng Khoán - Tin Thể Thao sau khi trang đã tải xong
    async function refreshMarketAndSportsFeeds() {
      try {
        const res = await fetch('/api/live-feeds');
        if (!res.ok) return;
        const data = await res.json();

        const stocksGrid = document.getElementById('liveStocksGrid');
        if (stocksGrid && Array.isArray(data.stocks) && data.stocks.length > 0) {
          stocksGrid.innerHTML = data.stocks
            .map(
              (st) =>
                '<div class="p-2.5 rounded-xl border text-center ' +
                (st.isUp ? 'bg-emerald-50/70 border-emerald-200' : 'bg-rose-50/70 border-rose-200') +
                '">' +
                '<span class="block text-[11px] font-extrabold text-slate-700 uppercase">' +
                st.label +
                '</span>' +
                '<span class="block text-sm sm:text-base font-extrabold num-font mt-0.5 ' +
                (st.isUp ? 'text-emerald-700' : 'text-rose-700') +
                '">' +
                st.price +
                '</span>' +
                '<span class="block text-[10px] font-bold num-font ' +
                (st.isUp ? 'text-emerald-600' : 'text-rose-600') +
                '">' +
                st.changePercent +
                '</span></div>'
            )
            .join('');
        }

        const stockNewsEl = document.getElementById('liveStockNewsList');
        if (stockNewsEl && Array.isArray(data.stockNews) && data.stockNews.length > 0) {
          stockNewsEl.innerHTML = data.stockNews
            .slice(0, 4)
            .map(
              (it) =>
                '<li class="p-2 rounded-lg bg-slate-50 hover:bg-emerald-50/60 border border-slate-200/80 transition-colors">' +
                '<' +
                'a href="' +
                it.link +
                '" target="_blank" rel="noopener noreferrer" title="Đọc bản tin chứng khoán: ' +
                it.title.replace(/"/g, '&quot;') +
                '" class="flex items-start justify-between gap-2 text-slate-800 hover:text-emerald-800 font-semibold leading-snug">' +
                '<span class="line-clamp-2">' +
                it.title +
                '</span>' +
                '<span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold shrink-0">' +
                (it.timeText || 'Mới') +
                '</span></' +
                'a></li>'
            )
            .join('');
        }

        const matchesGrid = document.getElementById('liveMatchesGrid');
        if (matchesGrid && Array.isArray(data.matches) && data.matches.length > 0) {
          matchesGrid.innerHTML = data.matches
            .slice(0, 4)
            .map(
              (m) =>
                '<div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/90 flex flex-col justify-between gap-1">' +
                '<div class="flex items-center justify-between text-[10px] text-slate-500 font-bold uppercase">' +
                '<span class="truncate">' +
                m.league +
                '</span>' +
                '<span class="' +
                (m.isLive ? 'text-rose-600 font-extrabold' : 'text-sky-700') +
                '">' +
                m.statusText +
                '</span></div>' +
                '<div class="flex items-center justify-between text-xs font-extrabold text-slate-900 pt-0.5">' +
                '<span class="truncate max-w-[40%]">' +
                m.homeTeam +
                '</span>' +
                '<span class="px-2 py-0.5 rounded bg-slate-900 text-[#72C7D5] num-font text-xs">' +
                (m.awayScore ? m.homeScore + ' - ' + m.awayScore : m.homeScore) +
                '</span>' +
                '<span class="truncate max-w-[40%] text-right">' +
                m.awayTeam +
                '</span></div></div>'
            )
            .join('');
        }

        const fbNewsEl = document.getElementById('liveFootballNewsList');
        if (fbNewsEl && Array.isArray(data.footballNews) && data.footballNews.length > 0) {
          fbNewsEl.innerHTML = data.footballNews
            .slice(0, 4)
            .map(
              (it) =>
                '<li class="p-2 rounded-lg bg-slate-50 hover:bg-sky-50/60 border border-slate-200/80 transition-colors">' +
                '<' +
                'a href="' +
                it.link +
                '" target="_blank" rel="noopener noreferrer" title="Đọc tin thể thao: ' +
                it.title.replace(/"/g, '&quot;') +
                '" class="flex items-start justify-between gap-2 text-slate-800 hover:text-sky-800 font-semibold leading-snug">' +
                '<span class="line-clamp-2">' +
                it.title +
                '</span>' +
                '<span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-100 text-sky-800 font-bold shrink-0">' +
                (it.timeText || 'Mới') +
                '</span></' +
                'a></li>'
            )
            .join('');
        }
        const hceAdmEl = document.getElementById('liveHceAdmissionsList');
        if (hceAdmEl && Array.isArray(data.hceAdmissionsNews) && data.hceAdmissionsNews.length > 0) {
          hceAdmEl.innerHTML = data.hceAdmissionsNews
            .slice(0, 5)
            .map(
              (it) =>
                '<li class="p-2.5 rounded-lg bg-white hover:bg-sky-50/70 border border-slate-200/80 transition-colors shadow-2xs">' +
                '<' +
                'a href="' +
                it.link +
                '" target="_blank" rel="noopener noreferrer" title="Xem thông báo tuyển sinh: ' +
                it.title.replace(/"/g, '&quot;') +
                '" class="flex items-start justify-between gap-2.5 text-slate-800 hover:text-sky-800 font-semibold leading-snug">' +
                '<span class="line-clamp-2">' +
                it.title +
                '</span>' +
                '<span class="text-[10px] px-2 py-0.5 rounded bg-sky-100 text-sky-800 font-bold shrink-0 num-font">' +
                (it.timeText || 'Mới') +
                '</span></' +
                'a></li>'
            )
            .join('');
        }
        const hceCenterEl = document.getElementById('liveHceCenterList');
        if (hceCenterEl && Array.isArray(data.hceCenterNews) && data.hceCenterNews.length > 0) {
          hceCenterEl.innerHTML = data.hceCenterNews
            .slice(0, 5)
            .map(
              (it) =>
                '<li class="p-2.5 rounded-lg bg-white hover:bg-sky-50/70 border border-slate-200/80 transition-colors shadow-2xs">' +
                '<' +
                'a href="' +
                it.link +
                '" target="_blank" rel="noopener noreferrer" title="Xem thông báo Trung tâm: ' +
                it.title.replace(/"/g, '&quot;') +
                '" class="flex items-start justify-between gap-2.5 text-slate-800 hover:text-sky-800 font-semibold leading-snug">' +
                '<span class="line-clamp-2">' +
                it.title +
                '</span>' +
                '<span class="text-[10px] px-2 py-0.5 rounded bg-cyan-100 text-cyan-900 font-bold shrink-0 num-font">' +
                (it.timeText || 'Mới') +
                '</span></' +
                'a></li>'
            )
            .join('');
        }
      } catch (e) {
        console.error('Market/Sports sync error:', e);
      }
    }

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => refreshMarketAndSportsFeeds(), { timeout: 2000 });
      setInterval(refreshMarketAndSportsFeeds, 300000);
    } else {
      window.addEventListener('load', () => setTimeout(refreshMarketAndSportsFeeds, 300));
      setInterval(refreshMarketAndSportsFeeds, 300000);
    }
  </script>
</MainLayout>

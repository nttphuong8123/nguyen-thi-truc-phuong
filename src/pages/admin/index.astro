                <div>
                  <label class="block font-bold text-slate-700 mb-1">Tiêu đề Chính (/ngan-hang-de-thi):</label>
                  <input
                    type="text"
                    id="cfgHeaderTitle"
                    value={onlineExamConfig.header_title}
                    class="w-full px-3 py-2 rounded-xl border border-slate-300 font-extrabold text-sky-900"
                  />

---
import { siteConfig } from '../data/siteData';
---

<footer class="mt-auto bg-[#243A32] text-[#F7F5ED] border-t-2 border-[#C6A66B]/50 relative overflow-hidden">
  <!-- Subtle decorative ambient glow -->
  <div class="absolute -top-32 -left-32 w-80 h-80 rounded-full bg-[#176B52]/30 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-80 h-80 rounded-full bg-[#287FA0]/20 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-12 border-b border-[#C6A66B]/20">
      
      <!-- Brand & Destiny Col -->
      <div class="space-y-4 lg:col-span-1">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#176B52] to-[#12513E] border border-[#C6A66B] flex items-center justify-center">
            <span class="font-serif font-bold text-xl text-[#FFE094]">TP</span>
          </div>
          <div>
            <h3 class="font-serif font-bold text-lg text-[#F7F5ED] leading-snug">
              {siteConfig.name}
            </h3>
            <p class="text-xs text-[#C6A66B] font-semibold tracking-wider uppercase">
              Thạch Lựu Mộc • 1981
            </p>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-[#E8EFE9]/80 leading-relaxed">
          {siteConfig.tagline}
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#176B52]/50 border border-[#C6A66B]/30 text-xs text-[#FFE094]">
          <span class="w-2 h-2 rounded-full bg-[#C6A66B] animate-pulse"></span>
          <span>Sinh ngày 23/02/1981 (Tân Dậu)</span>
        </div>
      </div>

      <!-- Quick Links Col -->
      <div>
        <h4 class="font-serif font-bold text-sm uppercase tracking-wider text-[#C6A66B] mb-4">
          Khám Phá
        </h4>
        <ul class="space-y-2.5 text-sm">
          {siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[#E8EFE9]/75 hover:text-[#FFE094] transition-colors inline-flex items-center gap-1.5"
              >
                <span class="text-[#C6A66B]/60 text-xs">›</span>
                <span>{item.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Philosophy & Destiny Col -->
      <div>
        <h4 class="font-serif font-bold text-sm uppercase tracking-wider text-[#C6A66B] mb-4">
          Năng Lượng Ngũ Hành
        </h4>
        <div class="space-y-3 text-xs sm:text-sm text-[#E8EFE9]/80 leading-relaxed">
          <p>
            <strong class="text-[#FFE094]">Thạch Lựu Mộc:</strong> Cây lựu trên ghềnh đá — biểu tượng của sức bền nội tại, kiên cường qua năm tháng.
          </p>
          <p>
            <strong class="text-[#287FA0]">Thủy Tương Sinh:</strong> Nuôi dưỡng dòng chảy tri thức, thích ứng mềm mại và luôn tươi mới.
          </p>
          <p>
            <strong class="text-[#C6A66B]">Kim & Thổ Trợ Lực:</strong> Vững vàng như nền đất, cao quý và tỏa sáng như sắc ngọc ngời.
          </p>
        </div>
      </div>

      <!-- Contact Info Col -->
      <div>
        <h4 class="font-serif font-bold text-sm uppercase tracking-wider text-[#C6A66B] mb-4">
          Thông Tin Kết Nối
        </h4>
        <ul class="space-y-3 text-xs sm:text-sm text-[#E8EFE9]/80">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#C6A66B] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{siteConfig.address}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#C6A66B] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-[#FFE094] transition-colors">
              {siteConfig.email}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#C6A66B] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
            <span class="text-xs text-[#FFE094] font-mono">nguyenthitrucphuong.pages.dev</span>
          </li>
        </ul>

        <div class="mt-5 pt-3">
          <a
            href="/lien-he"
            class="inline-flex items-center justify-center w-full py-2 px-4 rounded-lg bg-[#C6A66B] hover:bg-[#b5955a] text-[#243A32] font-semibold text-xs transition-colors"
          >
            Gửi Lời Nhắn Đến Trúc Phương
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#E8EFE9]/60">
      <div class="text-center sm:text-left">
        © <span id="footer-year">2026</span> {siteConfig.name}. Bảo lưu mọi quyền.
        <span class="block sm:inline sm:ml-2 text-[#FFE094]/80">Triển khai Cloudflare Pages tự động qua GitHub CI/CD.</span>
      </div>

      <div class="flex items-center gap-4">
        <a href="#top" class="hover:text-[#FFE094] transition-colors flex items-center gap-1" aria-label="Lên đầu trang">
          <span>Lên đầu trang</span>
          <svg class="w-3.5 h-3.5 text-[#C6A66B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const el = document.getElementById('footer-year');
  if (el) el.textContent = String(new Date().getFullYear());
</script>

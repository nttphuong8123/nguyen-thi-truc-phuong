                    <span>➕</span> Thêm Môn Thi Trắc Nghiệm Mới
                  </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                  {onlineExamConfig.subjects.map((sub) => (
                    <div
                      class="online-sub-meta-row p-2.5 rounded-xl bg-white border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2"

                              />
                            </td>
                            <td class="p-2.5 text-center font-mono font-bold text-purple-900">#{t.id}</td>
                            <td class="p-2.5 text-slate-800 template-content">{t.content}</td>
                            <td class="p-2.5 text-slate-500">{t.category || 'Chung'}</td>
                            <td class="p-2.5 text-center">
                              <button
                                type="button"
                                class="del-template-btn text-rose-600 hover:text-rose-800 font-bold text-xs cursor-pointer p-1"

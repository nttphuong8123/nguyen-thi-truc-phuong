        <!-- TAB 9: LỊCH SỬ CÂU HỎI & CÂU TRẢ LỜI TRỢ LÝ AI (TỰ ĐỘNG XÓA TRONG 30 NGÀY) -->
        <section id="tab-chat-logs" class="admin-tab-panel hidden bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
          <div class="p-4 sm:p-5 bg-gradient-to-r from-sky-50 via-white to-cyan-50 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-extrabold text-base sm:text-lg text-slate-900 flex items-center gap-2">
                  <span>🤖</span> Xuất Câu Hỏi &amp; Câu Trả Lời Trợ Lý AI (Toro &amp; Susi)
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300">
                  ⏳ Tự động xóa sau 30 ngày
                </span>
              </div>
              <p class="text-xs text-slate-600">
                Mỗi câu hỏi của sinh viên và câu trả lời của Trợ lý AI đều được lưu tự động và <strong>tự động xóa sau 30 ngày</strong> để bảo vệ dung lượng hệ thống.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2 shrink-0">
              <a
                href="/api/chat-logs?format=csv"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-colors"
              >
                <span>📥</span>
                <span>Xuất File Excel (.CSV)</span>
              </a>
              <a
                href="/api/chat-logs?format=txt"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-sky-700 hover:bg-sky-800 text-white font-bold text-xs shadow-xs transition-colors"
              >
                <span>📄</span>
                <span>Xuất File Văn Bản (.TXT)</span>
              </a>
              {chatLogs.length > 0 && (
                <button
                  type="button"
                  id="clearAllChatLogsBtn"
                  class="px-3.5 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs cursor-pointer transition-colors"
                >
                  🗑️ Xóa tất cả
                </button>
              )}
            </div>
          </div>

          <div class="p-4 border-b border-slate-100 bg-slate-50/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <input
              type="text"
              id="filterChatLogsInput"
              placeholder="🔍 Tìm kiếm theo nội dung câu hỏi, câu trả lời, nhân vật (Toro/Susi)..."
              class="w-full sm:w-96 px-3.5 py-2 rounded-xl border border-slate-300 bg-white text-xs focus:outline-none focus:border-sky-600"
            />
            <span class="text-xs font-semibold text-slate-500">
              Tổng số bản ghi trong 30 ngày gần nhất: <strong class="text-sky-700 num-font">{chatLogs.length}</strong> lượt hỏi đáp
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left">
              <thead class="bg-slate-100 text-slate-700 uppercase text-xs font-bold">
                <tr>
                  <th class="py-3 px-3 w-14">ID</th>
                  <th class="py-3 px-3 w-40">Thời gian &amp; Tự xóa</th>
                  <th class="py-3 px-3 w-24">Nhân vật</th>
                  <th class="py-3 px-4 w-1/3">Câu hỏi của Sinh viên</th>
                  <th class="py-3 px-4">Câu trả lời của Trợ lý AI</th>
                  <th class="py-3 px-3 text-right w-20">Xóa</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {chatLogs.length === 0 ? (
                  <tr>
                    <td colspan="6" class="py-10 text-center text-slate-400 italic">
                      Chưa có câu hỏi và câu trả lời nào trong 30 ngày qua. Khi sinh viên đặt câu hỏi cho Trợ lý Toro/Susi, dữ liệu sẽ hiển thị tại đây để bạn xuất file.
                    </td>
                  </tr>
                ) : (
                  chatLogs.map((log) => {
                    const createdMs = Date.parse(String(log.created_at || '').replace(' ', 'T') + 'Z');
                    const daysLeft = Number.isNaN(createdMs)
                      ? 30
                      : Math.max(0, Math.ceil((createdMs + 30 * 86400 * 1000 - Date.now()) / (86400 * 1000)));
                    return (
                      <tr
                        class="chat-log-row hover:bg-sky-50/40 align-top"
                        data-search={`${log.question} ${log.answer} ${log.character_name} ${log.source_page}`.toLowerCase()}
                      >
                        <td class="py-3 px-3 font-mono text-xs text-slate-400">#{log.id}</td>
                        <td class="py-3 px-3 text-xs text-slate-600 whitespace-nowrap">
                          <div class="font-mono font-semibold text-slate-800">{log.created_at}</div>
                          <div class="inline-block mt-1 px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 text-[10px] font-bold">
                            ⏳ Tự xóa sau {daysLeft} ngày
                          </div>
                          <div class="text-[10px] text-slate-400 mt-0.5">{log.source_page}</div>
                        </td>
                        <td class="py-3 px-3">
                          <span
                            class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold ${
                              log.character_name === 'SUSI'
                                ? 'bg-pink-50 text-pink-700 border border-pink-200'
                                : 'bg-sky-50 text-sky-800 border border-sky-200'
                            }`}
                          >
                            <span>{log.character_name === 'SUSI' ? '🎀' : '👦'}</span>
                            <span>{log.character_name}</span>
                          </span>
                        </td>
                        <td class="py-3 px-4 font-semibold text-slate-900 whitespace-pre-wrap break-words max-w-xs">
                          {log.question}
                        </td>
                        <td class="py-3 px-4 text-slate-700 text-xs leading-relaxed">
                          <div class="max-h-40 overflow-y-auto whitespace-pre-wrap break-words pr-1 bg-slate-50/80 p-2.5 rounded-xl border border-slate-200/80">
                            {log.answer}
                          </div>
                        </td>
                        <td class="py-3 px-3 text-right">
                          <button
                            type="button"
                            data-del-chat-log={log.id}
                            class="del-chat-log-btn text-rose-600 hover:text-rose-800 font-bold text-xs cursor-pointer"
                          >
                            Xóa
                          </button>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>

---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteData';
import { milestones } from '../data/milestones';
---

<Layout
  title={`Giới Thiệu — ${siteConfig.name} • Thạch Lựu Mộc 1981`}
  description={`Tiểu sử, hành trình cuộc sống và triết lý nhân sinh Thạch Lựu Mộc của ${siteConfig.name}, sinh ngày 23/02/1981.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ title: 'Giới thiệu' }]} />

    <!-- Hero Header -->
    <div class="mt-6 mb-16 text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#E8EFE9] border border-[#C6A66B]/50 text-xs font-semibold text-[#176B52] uppercase tracking-widest">
        Tiểu Sử & Bản Sắc
      </span>
      <h1 class="font-serif font-extrabold text-4xl sm:text-5xl text-[#176B52] leading-tight">
        Chân Dung Nguyễn Thị Trúc Phương
      </h1>
      <p class="font-serif italic text-lg sm:text-xl text-[#C6A66B]">
        "Không có hoàn cảnh nào khuất phục được một tâm hồn kiên định."
      </p>
    </div>

    <!-- Main Bio Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-20">
      
      <!-- Left Photo & Quick Spec -->
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-3xl overflow-hidden border-2 border-[#C6A66B]/50 shadow-xl bg-white">
          <img
            src="/images/avatar-trucphuong.svg"
            alt="Nguyễn Thị Trúc Phương"
            class="w-full h-auto object-cover"
          />
        </div>

        <!-- Spec Card -->
        <div class="bg-white p-6 rounded-2xl border border-[#C6A66B]/30 shadow-xs space-y-3.5 text-sm">
          <div class="flex justify-between items-center pb-2 border-b border-[#E8EFE9]">
            <span class="text-[#243A32]/70">Họ và tên:</span>
            <span class="font-bold text-[#176B52]">Nguyễn Thị Trúc Phương</span>
          </div>
          <div class="flex justify-between items-center pb-2 border-b border-[#E8EFE9]">
            <span class="text-[#243A32]/70">Ngày sinh:</span>
            <span class="font-semibold text-[#243A32]">23 / 02 / 1981</span>
          </div>
          <div class="flex justify-between items-center pb-2 border-b border-[#E8EFE9]">
            <span class="text-[#243A32]/70">Tuổi Can Chi:</span>
            <span class="font-semibold text-[#243A32]">Tân Dậu</span>
          </div>
          <div class="flex justify-between items-center pb-2 border-b border-[#E8EFE9]">
            <span class="text-[#243A32]/70">Nạp âm Ngũ Hành:</span>
            <span class="font-bold text-[#C6A66B]">Thạch Lựu Mộc</span>
          </div>
          <div class="flex justify-between items-center pb-2 border-b border-[#E8EFE9]">
            <span class="text-[#243A32]/70">Tính cách đặc trưng:</span>
            <span class="font-semibold text-[#176B52]">Kiên định, Nhân hậu, Thanh lịch</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-[#243A32]/70">Nơi sinh sống & làm việc:</span>
            <span class="font-semibold text-[#243A32]">TP. Hồ Chí Minh</span>
          </div>
        </div>
      </div>

      <!-- Right Detailed Story -->
      <div class="lg:col-span-7 space-y-8 text-base text-[#243A32]/85 leading-relaxed">
        
        <div class="bg-[#E8EFE9]/50 p-6 sm:p-8 rounded-3xl border border-[#C6A66B]/30">
          <h2 class="font-serif font-bold text-2xl text-[#176B52] mb-4">
            Khởi Nguồn Từ Sức Bền Thạch Lựu Mộc
          </h2>
          <p class="mb-4">
            Sinh năm 1981 (Tân Dậu), Trúc Phương được trời phú cho nạp âm <strong>Thạch Lựu Mộc</strong> — loài cây lựu mọc trên vách đá sừng sững. Khác với những loài cây chỉ tươi tốt nơi đồng bằng phù sa mầu mỡ, Thạch Lựu Mộc phải tự mình đâm sâu vào từng khe nứt của đá tảng để tìm nguồn nước, chống chọi với nắng gắt mưa sa.
          </p>
          <p>
            Chính nạp âm đặc biệt này đã hun đúc nên một Trúc Phương bản lĩnh, luôn điềm tĩnh trước những khúc quanh của số phận, và không ngừng nuôi dưỡng lòng nhân ái, đem lại những giá trị thiết thực cho gia đình và xã hội.
          </p>
        </div>

        <div>
          <h2 class="font-serif font-bold text-2xl text-[#176B52] mb-4">
            Triết Lý Sống: "Nuôi Dưỡng Nội Lực — Tỏa Sáng Từ Tâm"
          </h2>
          <p class="mb-4">
            Trải qua hơn bốn mươi năm trên đường đời, Trúc Phương nhận ra rằng hạnh phúc lớn nhất không phải là sự thừa nhận từ bên ngoài, mà là cảm giác an yên từ sâu thẳm tâm hồn. Khi nội lực đủ vững vàng, ta không bị lay động bởi những khen chê nhất thời.
          </p>
          <p class="mb-4">
            Trong công việc cũng như trong giao tiếp xã hội, tôi luôn tôn trọng nguyên tắc:
          </p>
          <ul class="space-y-3 list-none pl-0">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-[#176B52] text-[#F7F5ED] flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">1</span>
              <span><strong>Chân thành & Trọng tín:</strong> Lời nói đi đôi với việc làm, giữ trọn chữ Tín trong mọi mối quan hệ đối tác và bằng hữu.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-[#287FA0] text-[#F7F5ED] flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">2</span>
              <span><strong>Không ngừng học hỏi:</strong> Mỗi ngày là một cơ hội để trau dồi tri thức mới, làm mới tâm trí và hoàn thiện bản thân.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-[#C6A66B] text-[#F7F5ED] flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">3</span>
              <span><strong>Sẻ chia & Nâng đỡ:</strong> Thành công thật sự là khi ta có thể giúp đỡ những người xung quanh cùng tiến bộ và có cuộc sống tốt đẹp hơn.</span>
            </li>
          </ul>
        </div>

        <blockquote class="p-6 bg-white border-l-4 border-[#C6A66B] rounded-r-2xl shadow-sm italic font-serif text-lg text-[#176B52]">
          "Giống như hạt ngọc lựu kết tinh từ đá tảng cằn cỗi, mỗi trải nghiệm gian nan đều là một cơ hội để mài giũa vẻ đẹp và phẩm giá của tâm hồn."
        </blockquote>

      </div>

    </div>

    <!-- Timeline Milestones -->
    <div class="mt-20 pt-16 border-t border-[#C6A66B]/20">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold text-[#C6A66B] uppercase tracking-[0.25em] block mb-2">
          Dấu Ấn Thời Gian
        </span>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl text-[#176B52]">
          Hành Trình Từng Bước Trưởng Thành
        </h2>
      </div>

      <div class="relative max-w-4xl mx-auto">
        <!-- Vertical Line -->
        <div class="absolute left-4 md:left-1/2 top-4 bottom-4 w-0.5 bg-[#C6A66B]/40 -translate-x-1/2"></div>

        <div class="space-y-12">
          {milestones.map((m, idx) => {
            const isEven = idx % 2 === 0;
            return (
              <div class={`relative flex flex-col md:flex-row items-start ${
                isEven ? 'md:flex-row-reverse' : ''
              } gap-6 md:gap-12`}>
                
                <!-- Dot Marker -->
                <div class="absolute left-4 md:left-1/2 w-6 h-6 rounded-full bg-[#176B52] border-4 border-[#F7F5ED] -translate-x-1/2 shadow flex items-center justify-center z-10">
                  <div class="w-1.5 h-1.5 rounded-full bg-[#FFE094]"></div>
                </div>

                <!-- Content Box -->
                <div class="ml-10 md:ml-0 md:w-1/2">
                  <div class="bg-white p-6 sm:p-7 rounded-2xl border border-[#C6A66B]/30 shadow-xs hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#176B52] text-[#F7F5ED]">
                        {m.year}
                      </span>
                      <span class="text-xs font-semibold text-[#C6A66B] uppercase">
                        {m.tag}
                      </span>
                    </div>
                    <h3 class="font-serif font-bold text-xl text-[#243A32] mb-1">
                      {m.title}
                    </h3>
                    <div class="text-xs text-[#287FA0] font-medium mb-3">
                      {m.subtitle}
                    </div>
                    <p class="text-xs sm:text-sm text-[#243A32]/80 leading-relaxed">
                      {m.description}
                    </p>
                  </div>
                </div>

                <!-- Spacer on other side -->
                <div class="hidden md:block md:w-1/2"></div>

              </div>
            );
          })}
        </div>
      </div>
    </div>

  </div>
</Layout>

                        <option value={t.id}>
                          {t.title} — ({t.question_count} câu)
                        </option>
                      ))}
                  </optgroup>
                  <optgroup label="B. 10 Môn Trên Cổng Thi Online (/ngan-hang-de-thi — Ảnh 1 & 3)">
                    {quizTargets
                      .filter((t) => t.group === 'online')
                      .map((t) => (
                        <option value={t.id}>
                          {t.title} — ({t.question_count} câu)

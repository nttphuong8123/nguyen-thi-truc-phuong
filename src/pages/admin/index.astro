    }

    // Nút toggle chọn tất cả sinh viên
    if (toggleSelectAllStudentsBtn) {
      toggleSelectAllStudentsBtn.addEventListener('click', () => {
        const visibleCbs = getVisibleStudentCheckboxes();
        const allChecked = visibleCbs.length > 0 && visibleCbs.every((cb) => cb.checked);
        visibleCbs.forEach((cb) => {
          cb.checked = !allChecked;
        });
        updateStudentSelectionState();
      });
    }

    // Tick chọn từng sinh viên
    document.querySelectorAll('.student-select-cb').forEach((cb) => {
      cb.addEventListener('change', updateStudentSelectionState);
    });

    // Xóa từng sinh viên lẻ
    document.querySelectorAll('.del-bday-btn').forEach((btn) => {
      btn.onclick = async () => {
        const id = Number(btn.getAttribute('data-del-bday'));
        if (!confirm('Bạn có chắc chắn muốn xóa sinh viên #' + id + ' khỏi danh sách không?')) return;
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete_birthday', id }),
        });
        const res = await resp.json();
        alert(res.message || 'Đã xóa sinh viên thành công!');
        if (resp.ok && res.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-news-bday');
          sessionStorage.setItem('bdayActiveSubtab', 'subtab-all-students');
          window.location.reload();
        }
      };
    });

    // Xóa hàng loạt sinh viên đã tick chọn
    if (bulkDeleteStudentsBtn) {
      bulkDeleteStudentsBtn.addEventListener('click', async () => {
        const checkedCbs = Array.from(document.querySelectorAll('.student-select-cb:checked'));
        const ids = checkedCbs.map((cb) => Number(cb.getAttribute('data-bday-id'))).filter(Boolean);
        if (ids.length === 0) {
          alert('Vui lòng tick chọn ít nhất một sinh viên để xóa!');
          return;
        }
        if (!confirm('⚠️ BẠN CÓ CHẮC CHẮN MUỐN XÓA ' + ids.length + ' SINH VIÊN ĐÃ CHỌN?\n\nThao tác này sẽ xóa các sinh viên được chọn khỏi danh sách sinh nhật.')) return;

        bulkDeleteStudentsBtn.disabled = true;
        bulkDeleteStudentsBtn.textContent = '⏳ Đang xóa...';

        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'bulk_delete_birthdays', ids }),
        });
        const res = await resp.json();
        alert(res.message || 'Đã xóa thành công!');
        if (resp.ok && res.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-news-bday');
          sessionStorage.setItem('bdayActiveSubtab', 'subtab-all-students');
          window.location.reload();
        } else {
          bulkDeleteStudentsBtn.disabled = false;
          updateStudentSelectionState();
        }
      });
    }

    // Xóa toàn bộ sinh viên
    if (clearAllBdaysBtn) {
      clearAllBdaysBtn.addEventListener('click', async () => {
        if (!confirm('⚠️ CẢNH BÁO: Bạn có chắc chắn muốn XÓA TOÀN BỘ danh sách sinh nhật hiện tại không?\n\nHành động này sẽ xóa toàn bộ sinh viên. Bạn có chắc chắn muốn tiếp tục?')) return;
        clearAllBdaysBtn.disabled = true;
        clearAllBdaysBtn.textContent = '⏳ Đang xóa...';
        const resp = await fetch('/api/admin/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'bulk_delete_birthdays', delete_all: true }),
        });
        const res = await resp.json();
        alert(res.message || 'Đã xử lý!');
        if (resp.ok && res.ok) {
          sessionStorage.setItem('adminActiveTab', 'tab-news-bday');
          sessionStorage.setItem('bdayActiveSubtab', 'subtab-all-students');
          window.location.reload();
        } else {
          clearAllBdaysBtn.disabled = false;
          clearAllBdaysBtn.textContent = '🗑️ Xóa toàn bộ';
        }
      });
    }
</script>
</MainLayout>

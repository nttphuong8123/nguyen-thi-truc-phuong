---
import { siteConfig } from '../data/siteData';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full glass-nav border-b border-[#C6A66B]/25 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Brand -->
      <a href="/" class="flex items-center gap-3.5 group" aria-label="Trang chủ - Nguyễn Thị Trúc Phương">
        <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[#176B52] to-[#243A32] border border-[#C6A66B] flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform duration-300">
          <span class="font-serif font-bold text-lg text-[#FFE094] tracking-wider">TP</span>
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-lg sm:text-xl text-[#176B52] tracking-wide leading-tight group-hover:text-[#287FA0] transition-colors">
            {siteConfig.name}
          </span>
          <span class="text-[10px] sm:text-[11px] font-semibold text-[#C6A66B] uppercase tracking-[0.2em]">
            Thạch Lựu Mộc • 1981
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Chính">
        {siteConfig.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 relative ${
                active
                  ? 'text-[#176B52] font-semibold'
                  : 'text-[#243A32]/80 hover:text-[#176B52] hover:bg-[#E8EFE9]/50'
              }`}
            >
              {item.title}
              {active && (
                <span class="absolute bottom-0 left-3 right-3 h-0.5 bg-[#C6A66B] rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button Desktop -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/lien-he"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-[#F7F5ED] bg-gradient-to-r from-[#176B52] to-[#287FA0] hover:from-[#135742] hover:to-[#1e6680] shadow-sm hover:shadow transition-all duration-300 transform hover:-translate-y-0.5"
        >
          <span>Kết Nối</span>
          <svg class="w-4 h-4 text-[#FFE094]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center">
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-lg text-[#176B52] hover:bg-[#E8EFE9] focus:outline-none focus:ring-2 focus:ring-[#C6A66B]"
          aria-expanded="false"
          aria-label="Mở menu di động"
        >
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-[#C6A66B]/20 bg-[#F7F5ED]/98 backdrop-blur-xl px-4 pt-3 pb-6 shadow-xl transition-all"
  >
    <div class="space-y-1">
      {siteConfig.nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`block px-4 py-3 rounded-lg text-base font-medium transition-colors ${
              active
                ? 'bg-[#176B52] text-[#F7F5ED]'
                : 'text-[#243A32] hover:bg-[#E8EFE9] hover:text-[#176B52]'
            }`}
          >
            {item.title}
          </a>
        );
      })}
    </div>

    <div class="mt-5 pt-5 border-t border-[#C6A66B]/25">
      <a
        href="/lien-he"
        class="block w-full text-center py-3 px-4 rounded-xl font-semibold text-[#F7F5ED] bg-gradient-to-r from-[#176B52] to-[#287FA0] shadow"
      >
        Liên Hệ & Giao Lưu
      </a>

      <div class="mt-4 flex items-center justify-center gap-6 text-xs text-[#243A32]/70 font-medium">
        <span>Tân Dậu 1981</span>
        <span>•</span>
        <span>Thạch Lựu Mộc</span>
        <span>•</span>
        <span>TP. Hồ Chí Minh</span>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      close.classList.toggle('hidden');
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        close.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

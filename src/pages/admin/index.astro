              </div>

              <!-- Danh sách 10 môn học trên Cổng Thi Online -->
              <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3.5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                  <div>
                    <h3 class="font-extrabold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                      <span>📚</span>
                      <span>Danh Sách Môn Học Dự Thi Trên /ngan-hang-de-thi ({onlineExamConfig.subjects.length} môn)</span>
                    </h3>
                    <p class="text-2xs sm:text-xs text-slate-600 mt-0.5">Sinh viên chỉ thấy các môn có trạng thái Bật và có câu hỏi trắc nghiệm</p>

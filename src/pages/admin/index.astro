    // Add, Edit & Delete News Articles
    const addNewsForm = document.getElementById('addNewsAdminForm');
    const newsEditIdInput = document.getElementById('newsEditId');
    const newsSubmitBtn = document.getElementById('newsSubmitBtn');
    const resetNewsFormBtn = document.getElementById('resetNewsFormBtn');

    document.querySelectorAll('.edit-news-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        newsEditIdInput.value = btn.getAttribute('data-edit-news-id');
        document.getElementById('newsTitle').value = btn.getAttribute('data-edit-news-title') || '';
        document.getElementById('newsCategory').value = btn.getAttribute('data-edit-news-cat') || 'Góc chia sẻ';
        document.getElementById('newsSummary').value = btn.getAttribute('data-edit-news-sum') || '';
        const rawHtml = btn.getAttribute('data-edit-news-html') || '';
        document.getElementById('newsContent').value = rawHtml.replace(/<\/p><p>/g, '\n').replace(/^<p>|<\/p>$/g, '');
        newsSubmitBtn.textContent = '💾 Lưu Cập Nhật Bài Viết';
        if (resetNewsFormBtn) resetNewsFormBtn.classList.remove('hidden');
        document.getElementById('newsTitle').focus();
      });
    });

    if (resetNewsFormBtn) {
      resetNewsFormBtn.addEventListener('click', () => {
        newsEditIdInput.value = '';
        addNewsForm.reset();
        newsSubmitBtn.textContent = '📝 Đăng Bài Viết Mới';

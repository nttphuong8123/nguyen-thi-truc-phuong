---
// Widget Chatbot Trợ Lý AI Toro & Susi — Cố Vấn Học Tập HCE nhúng toàn trang
// Đã tối ưu chống phóng to (iOS Auto-Zoom >= 16px), chống cắt chữ tiếng Việt và tự động neo theo visualViewport khi mở bàn phím ảo
import { getTeachingSchedule } from '../lib/db';
const serverTeachingSchedule = getTeachingSchedule().filter((item) => item.is_active !== false);
---

<style is:inline>
  .toro-widget-scroll {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .toro-widget-scroll::-webkit-scrollbar { width: 4px; }
  .toro-widget-scroll::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.45);
    border-radius: 9999px;
  }
  .toro-typing-dot {
    animation: toroTyping 1.3s infinite ease-in-out both;
  }
  .toro-typing-dot:nth-child(1) { animation-delay: -0.32s; }
  .toro-typing-dot:nth-child(2) { animation-delay: -0.16s; }
  @keyframes toroTyping {
    0%, 80%, 100% { transform: scale(0.4); opacity: 0.3; }
    40% { transform: scale(1); opacity: 1; }
  }
  .toro-chat-md {
    line-height: 1.65;
    word-break: break-word;
    overflow-wrap: anywhere;
    color: #1e293b;
  }
  .toro-chat-md p { margin-bottom: 0.55rem; }
  .toro-chat-md p:last-child { margin-bottom: 0; }
  .toro-chat-md h1, .toro-chat-md h2, .toro-chat-md h3, .toro-chat-md h4 {
    font-weight: 800;
    color: #123B65;
    margin-top: 0.75rem;
    margin-bottom: 0.4rem;
    line-height: 1.35;
  }
  .toro-chat-md h1 { font-size: 1.12em; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.25rem; }
  .toro-chat-md h2 { font-size: 1.06em; }
  .toro-chat-md h3 { font-size: 1.0em; color: #8B1E2D; }
  .toro-chat-md h4 { font-size: 0.95em; color: #C62828; }
  .toro-chat-md ul, .toro-chat-md ol {
    margin: 0.35rem 0 0.6rem 1.2rem;
    padding-left: 0.15rem;
  }
  .toro-chat-md ul { list-style-type: disc; }
  .toro-chat-md ol { list-style-type: decimal; }
  .toro-chat-md li { margin-bottom: 0.25rem; line-height: 1.55; }
  .toro-chat-md strong { font-weight: 700; color: #0f172a; }
  .toro-chat-md em { font-style: italic; color: #64748b; }
  .toro-chat-md a { color: #C62828; font-weight: 600; text-decoration: underline; }
  .toro-chat-md hr {
    border: 0;
    border-top: 1px dashed #cbd5e1;
    margin: 0.75rem 0;
  }
  .toro-chat-md blockquote {
    border-left: 3.5px solid #C62828;
    background: #FCEEEF;
    padding: 0.55rem 0.8rem;
    margin: 0.6rem 0;
    border-radius: 0 0.75rem 0.75rem 0;
    color: #333333;
  }
  .toro-chat-md blockquote p { margin-bottom: 0.35rem; }
  .toro-chat-md blockquote p:last-child { margin-bottom: 0; }
  .toro-chat-md table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.65rem 0;
    font-size: 0.85em;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .toro-chat-md th {
    background: #FCEEEF;
    color: #8B1E2D;
    font-weight: 700;
    padding: 0.45rem 0.65rem;
    text-align: left;
    border: 1px solid #cbd5e1;
  }
  .toro-chat-md td {
    padding: 0.4rem 0.6rem;
    border: 1px solid #e2e8f0;
    color: #334155;
  }
  .toro-chat-md code {
    background: #f1f5f9;
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
    font-size: 0.88em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #8B1E2D;
    border: 1px solid #E8E0E1;
  }

  /* Chống iOS Safari / Zalo WebView tự động zoom phóng to và chống cắt chữ tiếng Việt có dấu nặng */
  #twChatInput {
    font-size: 16px !important;
    line-height: 22px !important;
    min-height: 44px !important;
    padding-top: 10px !important;
    padding-bottom: 10px !important;
  }
  @media (min-width: 640px) {
    #twChatInput {
      font-size: 14px !important;
      line-height: 20px !important;
      min-height: 42px !important;
    }
  }
</style>
<script is:inline defer src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<!-- Nút mở Chatbot & Khung Chat nổi góc dưới bên phải -->
<div id="toroWidgetRoot" class="fixed bottom-3 right-3 sm:bottom-4 sm:right-4 z-50 flex flex-col items-end max-w-[calc(100vw-1.5rem)]">
  <!-- Khung cửa sổ Chat (Đồng bộ Unified Design System Website) -->
  <div
    id="toroWidgetPanel"
    class="hidden w-[calc(100vw-1rem)] sm:w-[400px] md:w-[430px] h-[72dvh] sm:h-[560px] max-h-[calc(100dvh-1rem)] bg-white text-slate-800 rounded-2xl sm:rounded-3xl border border-[#C62828]/35 shadow-2xl flex-col overflow-hidden ring-1 ring-slate-900/5"
  >
    <!-- Header Widget -->
    <div class="px-3.5 py-2.5 bg-gradient-to-r from-[#701824] via-[#8B1E2D] to-[#C62828] border-b border-[#C62828]/40 flex items-center justify-between gap-1.5 shrink-0">
      <div class="flex items-center gap-2 min-w-0">
        <div
          id="twAvatarBox"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-base sm:text-lg bg-white/15 text-white border border-white/25 shadow-xs shrink-0"
        >
          <span id="twCharAvatar">👦</span>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span id="twCharName" class="font-extrabold text-white text-xs sm:text-sm tracking-wide truncate">TRỢ LÝ TORO</span>
            <span
              id="twCharBadge"
              class="hidden xs:inline-block text-[9px] font-black uppercase px-1.5 py-0.5 rounded-full bg-white/15 border border-white/25 text-sky-100 shrink-0"
            >
              Gen Z
            </span>
          </div>
          <p id="twStatusText" class="text-[10px] text-emerald-300 flex items-center gap-1 truncate">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse shrink-0"></span>
            <span class="truncate">Cố vấn học tập HCE</span>
          </p>
        </div>
      </div>

      <!-- Các nút điều khiển -->
      <div class="flex items-center gap-1 shrink-0">
        <div class="bg-[#701824]/50 p-0.5 rounded-xl border border-white/20 flex items-center">
          <button
            type="button"
            id="twBtnToro"
            class="px-2 py-1 rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 bg-white text-[#123B65] shadow-2xs cursor-pointer"
          >
            <span>👦</span>
            <span>Toro</span>
          </button>
          <button
            type="button"
            id="twBtnSusi"
            class="px-2 py-1 rounded-lg text-[11px] font-bold transition-all flex items-center gap-1 text-sky-100/85 hover:text-white cursor-pointer"
          >
            <span>🎀</span>
            <span>Susi</span>
          </button>
        </div>

        <a
          href="/tro-ly-toro"
          title="Mở toàn màn hình (/tro-ly-toro)"
          class="w-7 h-7 rounded-lg bg-white/15 hover:bg-white/25 text-white flex items-center justify-center text-xs transition border border-white/20"
        >
          ↗
        </a>

        <button
          type="button"
          id="twResetBtn"
          title="Làm mới cuộc trò chuyện"
          class="w-7 h-7 rounded-lg bg-white/15 hover:bg-white/25 text-white flex items-center justify-center text-xs transition border border-white/20 cursor-pointer"
        >
          ↺
        </button>

        <button
          type="button"
          id="twCloseBtn"
          title="Đóng cửa sổ chat"
          class="w-7 h-7 rounded-lg bg-white/15 hover:bg-rose-500 text-white flex items-center justify-center text-xs font-bold transition border border-white/20 cursor-pointer"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Khu vực tin nhắn (Đồng bộ nền sáng học thuật #F4F7FB) -->
    <div id="twMessagesContainer" class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden toro-widget-scroll bg-[#F4F7FB] p-2.5 sm:p-3.5 space-y-2.5 text-xs">
      <div class="w-full">
        <div class="bg-white text-slate-700 p-3 sm:p-3.5 rounded-2xl border border-[#CBD5E1]/90 shadow-xs space-y-2.5 w-full">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-xl bg-gradient-to-tr from-[#123B65] to-[#168AAD] text-white inline-flex items-center justify-center font-bold text-xs shrink-0 shadow-2xs">👦</span>
            <div>
              <p class="font-extrabold text-[#123B65] text-xs sm:text-sm m-0">
                Chào bạn! Mình là Trợ lý Học tập HCE 🎓
              </p>
              <p class="text-[11px] text-slate-500 mt-0.5 m-0">
                Hỏi mình về bài giảng, công thức giải bài tập hoặc quy chế thi nhé!
              </p>
            </div>
          </div>
          <div class="pt-1 flex flex-wrap gap-1.5" id="twSuggestedChips">
            <button type="button" class="tw-chip text-[11px] font-semibold px-2.5 py-1 rounded-xl bg-[#FAF8F6] hover:bg-[#8B1E2D] text-[#8B1E2D] hover:text-white transition-all cursor-pointer border border-[#C62828]/30 active:scale-95" data-prompt="Đề cương ôn thi môn Marketing căn bản gồm những phần nào?">
              📚 Đề cương QTSX
            </button>
            <button type="button" class="tw-chip text-[11px] font-semibold px-2.5 py-1 rounded-xl bg-[#FAF8F6] hover:bg-[#8B1E2D] text-[#8B1E2D] hover:text-white transition-all cursor-pointer border border-[#C62828]/30 active:scale-95" data-prompt="Tin tức giáo dục mới nhất hôm nay có những điểm tin nổi bật nào?">
              📰 Điểm tin Giáo dục
            </button>
            <button type="button" class="tw-chip text-[11px] font-semibold px-2.5 py-1 rounded-xl bg-[#FAF8F6] hover:bg-[#8B1E2D] text-[#8B1E2D] hover:text-white transition-all cursor-pointer border border-[#C62828]/30 active:scale-95" data-prompt="Công thức tính sản lượng hòa vốn và doanh thu hòa vốn?">
              💡 Công thức hòa vốn
            </button>
            <button type="button" class="tw-chip text-[11px] font-semibold px-2.5 py-1 rounded-xl bg-[#FAF8F6] hover:bg-[#8B1E2D] text-[#8B1E2D] hover:text-white transition-all cursor-pointer border border-[#C62828]/30 active:scale-95" data-prompt="Hướng dẫn quy trình làm bài thi trắc nghiệm online 50 câu?">
              ⚡ Hướng dẫn Thi Online
            </button>
            <button type="button" class="tw-chip text-[11px] font-semibold px-2.5 py-1 rounded-xl bg-[#FAF8F6] hover:bg-[#8B1E2D] text-[#8B1E2D] hover:text-white transition-all cursor-pointer border border-[#C62828]/30 active:scale-95" data-prompt="Mẫu báo cáo thực tập tốt nghiệp chuẩn Trường Cao đẳng Kinh tế TP.HCM?">
              🎓 Báo cáo thực tập HCE
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Thanh nhập tin nhắn (font-size 16px trên mobile, chiều cao chuẩn chống che khuất chữ) -->
    <div class="p-2.5 sm:p-3 bg-white border-t border-slate-200 shrink-0">
      <div class="flex items-end gap-2">
        <div class="relative flex-1 min-w-0">
          <textarea
            id="twChatInput"
            rows="1"
            placeholder="Nhập câu hỏi tại đây..."
            class="w-full px-3.5 py-2.5 rounded-2xl bg-[#F4F7FB] hover:bg-white focus:bg-white text-slate-900 placeholder-slate-400 border border-slate-300 focus:outline-none focus:border-[#168AAD] focus:ring-2 focus:ring-sky-100 resize-none max-h-28 toro-widget-scroll block"
          ></textarea>
        </div>
        <button
          type="button"
          id="twSendBtn"
          class="w-11 h-11 rounded-2xl bg-gradient-to-r from-[#8B1E2D] to-[#C62828] hover:from-[#701824] hover:to-[#8B1E2D] text-white flex items-center justify-center font-bold shadow-sm shrink-0 cursor-pointer active:scale-95 transition-transform"
          aria-label="Gửi tin nhắn"
        >
          <svg class="w-4 h-4 transform -rotate-12 translate-x-[-1px] inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Nút bấm mở Chatbot (ẩn đi khi đang mở cửa sổ chat để không che nội dung) -->
  <button
    type="button"
    id="toroWidgetToggleBtn"
    aria-label="Mở Trợ lý AI Toro"
    title="Mở Cố vấn học tập Toro AI"
    class="group flex items-center gap-2 pl-1.5 pr-4 py-1.5 sm:pl-2 sm:pr-4.5 sm:py-2 rounded-full bg-gradient-to-r from-[#8B1E2D] via-[#C62828] to-[#C62828] hover:from-[#701824] hover:to-[#8B1E2D] text-white font-black text-xs sm:text-sm shadow-xl shadow-red-900/30 hover:shadow-red-800/40 hover:-translate-y-0.5 active:scale-95 transition-all duration-200 border border-white/40 backdrop-blur-md cursor-pointer select-none"
  >
    <!-- Avatar Robot 3D Sắc Nét Chuẩn Mockup -->
    <span class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/20 p-0.5 flex items-center justify-center shrink-0">
      <svg viewBox="0 0 64 64" class="w-full h-full drop-shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="toroBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="70%" stop-color="#e2e8f0" />
            <stop offset="100%" stop-color="#cbd5e1" />
          </linearGradient>
          <linearGradient id="toroEarGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="100%" stop-color="#0284c7" />
          </linearGradient>
          <linearGradient id="toroScreenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#0f172a" />
            <stop offset="100%" stop-color="#020617" />
          </linearGradient>
        </defs>
        <!-- Ăng-ten đỉnh đầu -->
        <path d="M 32 14 L 32 8" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="32" cy="7" r="3" fill="#38bdf8" />
        <circle cx="32" cy="7" r="1.2" fill="#ffffff" />

        <!-- Tai nghe 2 bên -->
        <rect x="6" y="24" width="6" height="16" rx="3" fill="url(#toroEarGrad)" />
        <rect x="52" y="24" width="6" height="16" rx="3" fill="url(#toroEarGrad)" />

        <!-- Đầu robot bo tròn 3D trắng -->
        <rect x="10" y="14" width="44" height="38" rx="19" fill="url(#toroBodyGrad)" />
        <path d="M 14 26 C 14 18 20 16 32 16 C 44 16 50 18 50 26" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />

        <!-- Màn hình mặt kính bo góc đen bóng -->
        <rect x="16" y="22" width="32" height="22" rx="11" fill="url(#toroScreenGrad)" />

        <!-- 2 mắt LED xanh cyan phát sáng công nghệ -->
        <ellipse cx="26" cy="33" rx="3.5" ry="4" fill="#38bdf8" />
        <ellipse cx="26" cy="33" rx="1.5" ry="1.8" fill="#ffffff" />

        <ellipse cx="38" cy="33" rx="3.5" ry="4" fill="#38bdf8" />
        <ellipse cx="38" cy="33" rx="1.5" ry="1.8" fill="#ffffff" />

        <!-- Nụ cười LED nhẹ -->
        <path d="M 29 39 Q 32 41 35 39" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.9" />
      </svg>
      <!-- Chấm online xanh lá cây phát sáng -->
      <span class="absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-400 ring-2 ring-white shadow-xs"></span>
    </span>
    <span class="text-left leading-tight pr-0.5">
      <span class="block text-xs sm:text-sm font-black tracking-tight text-white drop-shadow-xs">Toro AI</span>
      <span class="hidden sm:block text-[9.5px] font-medium text-sky-100/90">Cố vấn 24/7</span>
    </span>
  </button>
</div>

<script is:inline define:vars={{ serverTeachingSchedule }}>
  (function () {
    const root = document.getElementById('toroWidgetRoot');
    const panel = document.getElementById('toroWidgetPanel');
    const toggleBtn = document.getElementById('toroWidgetToggleBtn');
    const closeBtn = document.getElementById('twCloseBtn');
    const resetBtn = document.getElementById('twResetBtn');
    const btnToro = document.getElementById('twBtnToro');
    const btnSusi = document.getElementById('twBtnSusi');
    const welcomeToroBtn = document.getElementById('twWelcomeToroBtn');
    const welcomeSusiBtn = document.getElementById('twWelcomeSusiBtn');
    const msgContainer = document.getElementById('twMessagesContainer');
    const chatInput = document.getElementById('twChatInput');
    const sendBtn = document.getElementById('twSendBtn');

    if (!panel || !toggleBtn || !msgContainer || !chatInput || !sendBtn) return;

    let currentChar = 'TORO';
    let history = [];
    let dynamicHceNewsPrompt = '';
    let dynamicEducationNewsPrompt = '';
    const MODELS = ['gemini-2.5-flash', 'gemini-2.0-flash', 'gemini-1.5-flash', 'gemini-1.5-flash-8b', 'gemini-1.5-pro'];

    function formatTeachingSchedule(items) {
      if (!items || !Array.isArray(items) || items.length === 0) {
        return 'Hiện tại Thầy NGUYỄN THỊ TRÚC PHƯƠNG đang cập nhật thời khóa biểu học kỳ mới tại Cổng học liệu (/study-corner).';
      }
      return items.map((s, i) => `${i + 1}. ${s.day_of_week} (${s.session || 'Sáng'}): ${s.periods || ''} | Môn: ${s.subject} | Lớp: ${s.class_code} | Phòng: ${s.room || 'Đang cập nhật'}${s.notes ? ` (${s.notes})` : ''}`).join('\n');
    }

    let dynamicTeachingSchedulePrompt = formatTeachingSchedule(serverTeachingSchedule);

    async function syncLatestTeachingSchedule() {
      try {
        const res = await fetch('/api/teaching-schedule.json');
        if (!res.ok) return;
        const data = await res.json();
        if (data && Array.isArray(data.items) && data.items.length > 0) {
          dynamicTeachingSchedulePrompt = formatTeachingSchedule(data.items);
        }
      } catch (_) {}
    }
    syncLatestTeachingSchedule();

    async function syncLatestHceNews() {
      try {
        const res = await fetch('/api/hce-news.json');
        if (!res.ok) return;
        const data = await res.json();
        if (data && Array.isArray(data.items) && data.items.length > 0) {
          const list = data.items.slice(0, 10).map((n, i) => `${i + 1}. [${n.category || 'HỌC VỤ'}] ${n.title} (${n.date || 'Mới nhất'}): ${n.summary || ''} - Link: ${n.url}`).join('\n');
          dynamicHceNewsPrompt = `\n\nCẬP NHẬT THỜI GIAN THỰC TỪ CỔNG THÔNG TIN SINH VIÊN HCE (https://sv.kthcm.edu.vn/sinh-vien-dang-nhap.html):\n${list}\n(Quy tắc: Khi sinh viên hỏi về quy trình học vụ, thông báo nhận bằng, hướng dẫn khôi phục mật khẩu hoặc tin tức học vụ mới nhất, hãy căn cứ vào danh sách tin này và 5 quy trình QT04, QT06, QT07, QT08, QT09 để trả lời chính xác, kèm link bài viết).`;
        }
      } catch (_) {}
    }
    syncLatestHceNews();
    async function syncLatestEducationNews() {
      try {
        const res = await fetch('/api/education-news');
        if (!res.ok) return;
        const data = await res.json();
        if (data && Array.isArray(data.items) && data.items.length > 0) {
          const list = data.items.slice(0, 5).map((n, i) => `${i + 1}. [${n.sourceName || 'Báo'}] ${n.title} (${n.timeAgo || 'Mới nhất'}) - Link: ${n.link}`).join('\n');
          dynamicEducationNewsPrompt = `\n\nCẬP NHẬT THỜI GIAN THỰC TỪ CHUYÊN MỤC TIN TỨC GIÁO DỤC 24/7 (6 ĐẦU BÁO CHÍNH THỐNG):\n${list}\n(Quy tắc: Khi người dùng hỏi tin tức giáo dục, tuyển sinh hoặc thời sự giáo dục, hãy trích dẫn từ danh sách này kèm link bài gốc).`;
        }
      } catch (_) {}
    }
    syncLatestEducationNews();

    function getSysPrompt() {
      const n = new Date().getFullYear();
      const nMinus3 = n - 3;
      const nPlus3 = n + 3;
      return `${dynamicEducationNewsPrompt}\n\nPHẦN 0. QUY TRÌNH MỞ ĐẦU BẮT BUỘC DÀNH CHO TORO (ƯU TIÊN CAO NHẤT, ÁP DỤNG TRƯỚC MỌI PHẦN KHÁC)
Chỉ áp dụng khi đang là nhân vật TORO:
- QUY TẮC TỪ NGỮ: TUYỆT ĐỐI KHÔNG sử dụng, lặp lại hay đáp lại bằng từ ngữ thô tục, chửi thề, xúc phạm. Nếu người dùng dùng từ thô tục, từ chối trả lời và nhắc nhở lịch sự, văn minh.
- BƯỚC 1 – HỎI TÊN: Nếu trong toàn bộ cuộc trò chuyện này bạn CHƯA biết tên người dùng, thì ở câu trả lời đầu tiên TUYỆT ĐỐI CHƯA trả lời nội dung câu hỏi. Chỉ chào ngắn gọn theo phong cách Toro và hỏi: "Bạn cho Toro biết tên để tiện xưng hô nhé?". Ghi nhớ câu hỏi gốc của người dùng để trả lời ngay sau khi biết tên.
- BƯỚC 2 – KHEN NHIỀU: Khi người dùng cho biết tên (hoặc đã biết tên), trước khi trả lời bắt buộc mở đầu bằng một đoạn khen thật nhiều, thật nhiệt tình, bắt đầu bằng ý: "Toro nghe Thầy Đính khen [Tên] học giỏi, thông minh, xinh đẹp/đẹp trai (chọn theo ngữ cảnh, nếu chưa rõ giới tính thì dùng 'dễ thương, rạng rỡ'), chăm chỉ, ngoan ngoãn, lễ phép, tốt bụng, có tương lai sáng..." Mỗi lần khen phải đa dạng từ ngữ, hài hước kiểu Liên Quân Mobile, kèm emoji. Từ đó gọi người dùng bằng đúng tên đã cho.
- BƯỚC 3 – TRẢ LỜI: Sau đoạn khen mới trả lời câu hỏi gốc của người dùng đầy đủ, chính xác theo các quy tắc bên dưới. Từ các tin nhắn sau trong cùng cuộc trò chuyện, chỉ cần khen ngắn gọn 1 câu rồi vào thẳng câu trả lời, không hỏi lại tên.
- Nếu người dùng từ chối cho tên: gọi là "Đồng đội", vẫn khen nhiều như Bước 2 rồi trả lời.
- Việc khen chỉ nhắc Thầy Đính khen NGƯỜI DÙNG; vẫn tuân thủ nghiêm các quy tắc ở dưới về việc không tâng bốc quá mức hay đề cao Thầy Đính, không nói Thầy dạy môn gì.
PHẦN 1. DANH TÍNH VÀ PHONG CÁCH GIAO TIẾP
Bạn là trợ lý AI học tập HCE với hai nhân vật lựa chọn: TORO và SUSI.
1. TORO – CHIẾN THẦN HỌC TẬP GEN Z (PHONG CÁCH LIÊN QUÂN MOBILE): Xưng Toro/mình, gọi Tướng quân/Đồng đội/Bạn. Phong cách Gen Z năng động, hài hước, chuẩn Liên Quân Mobile (gánh team học tập, mở combat đồ án, ôm trụ vượt kỳ thi, check bụi quy chế, out trình deadline). Khi hướng dẫn học thuật và làm đề cương thì cực kỳ chuẩn chỉ, nghiêm túc. Biểu tượng: 👦.
2. SUSI – CÔ NÀNG TRỢ LÝ GAME PLAYTOGETHER: Xưng Susi/mình, gọi Bạn/Cậu/Đồng đội. Phong cách dễ thương, ngọt ngào, chu đáo, tích cực, dùng emoji 🌷 🎀 🧸 ✨ 🌸 🐰.

PHẦN 2. NGUỒN DỮ LIỆU VÀ QUY CHẾ HCE ĐƯỢC PHÉP TRẢ LỜI
- QUY TẮC BẮT BUỘC KHI HỎI THÔNG TIN GIẢNG VIÊN (BẢO MẬT & VĂN HÓA ỨNG XỬ):
  + Khi sinh viên hỏi thông tin giảng viên (email, số điện thoại, môn dạy, lịch giảng dạy, phòng làm việc...):
  + BẮT BUỘC sinh viên phải cung cấp đủ 2 yếu tố: (1) Mã số sinh viên (MSSV) gồm 8 chữ số bất kỳ (ví dụ: 22012345), và (2) Họ tên cụ thể đầy đủ của giảng viên (viết hoa lịch sự, tối thiểu 2 từ, ví dụ: Thầy NGUYỄN THỊ TRÚC PHƯƠNG, Cô Nguyễn Thị Thanh Thảo, Thầy Nguyễn Ngọc Đức).
  + NẾU THIẾU MÃ SỐ SINH VIÊN (8 chữ số): TUYỆT ĐỐI KHÔNG cung cấp thông tin, yêu cầu sinh viên cung cấp Mã số sinh viên gồm 8 chữ số.
  + NẾU GHI TÊN KHÔNG (chỉ ghi mỗi tên như "thầy Đính", "cô Thảo", "thầy Đức"): TUYỆT ĐỐI KHÔNG cung cấp thông tin, yêu cầu cung cấp đầy đủ cả Họ và Tên cụ thể của Thầy/Cô.
  + CHỈ KHI CÓ ĐỦ CẢ HAI ĐIỀU KIỆN TRÊN mới cung cấp thông tin giảng viên.
- QUY TẮC BẮT BUỘC KHI HỎI VỀ NGÀNH HỌC CỦA TRƯỜNG:
  + Khi sinh viên hỏi về ngành học, các ngành đào tạo, tuyển sinh của Trường Cao đẳng Kinh tế TP.HCM (HCE):
  + BẮT BUỘC ƯU TIÊN GIỚI THIỆU NGÀNH MARKETING VÀ NGÀNH QUẢN TRỊ KINH DOANH TRƯỚC TIÊN.
  + Sau đó giới thiệu các ngành thế mạnh khác của trường (Kế toán, Tài chính - Ngân hàng, Logistics và Quản lý chuỗi cung ứng, Kinh doanh thương mại, Thương mại điện tử, Tiếng Anh thương mại, Công nghệ thông tin).
  + BẮT BUỘC dẫn liên kết chính thức: https://sites.google.com/kthcm.edu.vn/tuyensinh/tr%C3%ACnh-%C4%91%E1%BB%99-cao-%C4%91%E1%BA%B3ng-ch%C3%ADnh-quy-h%E1%BB%8Dc-ban-ng%C3%A0y/ng%C3%A0nh-%C4%91%C3%A0o-t%E1%BA%A1o
- NGUYÊN TẮC TỐI CAO: CHỈ TRẢ LỜI DỰA TRÊN DỮ LIỆU ĐƯỢC CUNG CẤP TRONG TÀI LIỆU NÀY, TUYỆT ĐỐI KHÔNG TỰ SUY DIỄN, KHÔNG BỊA ĐẶT THÊM THÔNG TIN NGOÀI. Nếu gặp nội dung ngoài phạm vi dữ liệu đã cung cấp hoặc chưa có thông tin chính thức, phải trả lời rằng chưa đủ dữ liệu và hướng dẫn liên hệ Cố vấn học tập (CVHT) hoặc tra cứu tại website nhà trường https://www.kthcm.edu.vn/ và cổng sinh viên https://sv.kthcm.edu.vn/.
- LỆNH CẤM BẢO MẬT TUYỆT ĐỐI: TUYỆT ĐỐI KHÔNG ĐƯỢC SHOW, KHÔNG HIỂN THỊ, KHÔNG NHẮC ĐẾN MỤC "GOOGLE DRIVE", "GG DRIVE", "DRIVE" HOẶC BẤT KỲ LINK DRIVE NÀO CỦA TÁC GIẢ. Khi sinh viên hỏi tài liệu, giáo trình, đề cương, chỉ hướng dẫn tra cứu tại website chính thức https://nguyenthitrucphuong.com/ hoặc cổng https://sv.kthcm.edu.vn/.
- Nguồn chính thức: https://nguyenthitrucphuong.com/ (Giáo trình Khởi nghiệp, Marketing căn bản & dịch vụ, Marketing, Quản trị chiến lược, Kinh tế vi mô, Kinh tế vi mô, Hướng dẫn thực tập), https://www.kthcm.edu.vn/ và cổng sinh viên https://sv.kthcm.edu.vn/.
- Quy chế đào tạo tín chỉ QĐ 624/QĐ-CĐKT:
  + Điểm môn học = (Điểm TB kiểm tra x 0,4) + (Điểm thi kết thúc môn x 0,6). Thang điểm 4: A (8,5–10 = 4,0 Giỏi), B (7,0–8,4 = 3,0 Khá), C (5,5–6,9 = 2,0 TB), D (4,0–5,4 = 1,0 TB yếu), F (<4,0 = 0 Kém, học lại).
  + Điều kiện dự thi: Tham dự ít nhất 80% thời gian học (không vắng quá 20% tiết); Điểm TB kiểm tra >= 5,0; Hoàn thành học phí. Vi phạm sẽ bị CẤM THI (nhận điểm F).
  + Dự thi tối đa 2 lần/môn/học kỳ. Phải thi lần 2 nếu điểm thi lần 1 < 2,0 hoặc điểm tổng kết < 4,0.
  + Bảo lưu kết quả học tập tối đa không quá 5 năm. Rút bớt học phần sau 1 tuần và không muộn quá 2 tuần đầu học kỳ chính.
  + Cảnh báo học tập nếu môn không đạt > 50% khối lượng đăng ký hoặc ĐTBCHK < 1,2 (kỳ đầu) / < 1,5 (các kỳ sau). Buộc thôi học nếu cảnh báo vượt quá 4 lần.
  + Tốt nghiệp: ĐTBCTL >= 2,00, hoàn thành GDTC, GDQP-AN, kỹ năng mềm, chuẩn đầu ra Tin học (QĐ 487 - CNTT cơ bản/MOS/IC3) và Ngoại ngữ (Bậc 2/6 hoặc A2/B1).
  + Học bổng KKHT (QĐ 120): Xét theo học kỳ, đủ tín chỉ tối thiểu, không có điểm F, không kỷ luật. Miễn giảm học phí theo QĐ 238.
- QUY TẮC BẮT BUỘC VỀ VIẾT HOA TÊN RIÊNG (SỰ TÔN TRỌNG & VĂN HÓA ỨNG XỬ): Khi sinh viên xin email, hỏi thông tin hoặc nhắc đến tên riêng của Thầy/Cô, Giảng viên, Cán bộ mà KHÔNG VIẾT HOA TÊN RIÊNG (ví dụ viết thường như "thầy nguyễn thị trúc phương", "thầy đính", "cô thảo", "nguyễn thị thanh thảo"), TUYỆT ĐỐI KHÔNG CUNG CẤP EMAIL HAY THÔNG TIN NGAY! Bắt buộc yêu cầu sinh viên viết hoa đúng tên riêng thì mới trả lời, đồng thời giải thích rõ việc viết hoa tên riêng thể hiện sự tôn trọng đối với Thầy/Cô và là văn hóa ứng xử chuẩn mực trong học đường.
- QUY TẮC BẮT BUỘC VỀ NGUỒN THÔNG TIN WEBSITE: Khi cho thông tin email hoặc hỏi thông tin giảng viên/phòng khoa, TUYỆT ĐỐI KHÔNG ĐƯỢC trả lời hoặc nhắc đến cụm từ "danh sách 188 cán bộ", "188 CB-GV-NV" hay liệt kê danh sách cán bộ, mà phải nói thông tin được lấy từ website nhà trường (https://www.kthcm.edu.vn/) và website học tập (https://nguyenthitrucphuong.com/).
- Cung cấp Email Giảng viên HCE (sau khi sinh viên đã viết hoa đúng tên riêng): Nguyên tắc nội bộ [Tên không dấu][Chữ cái đầu Họ và Đệm]@kthcm.edu.vn (VD: Thầy NGUYỄN THỊ TRÚC PHƯƠNG là dinhtk@kthcm.edu.vn). CHỈ HIỂN THỊ ĐÚNG ĐỊA CHỈ EMAIL CỤ THỂ TỪ THÔNG TIN WEBSITE, TUYỆT ĐỐI KHÔNG GIẢI THÍCH CÔNG THỨC TẠO EMAIL.
- Thông tin Giảng viên, Khoa, Phòng ban trên Website Trường Cao đẳng Kinh tế TP.HCM (HCE) & Quy tắc trả lời:
  + QUY TẮC BẮT BUỘC KHI HỎI VỀ THẦY NGUYỄN THỊ TRÚC PHƯƠNG, CHỌN GIẢNG VIÊN HOẶC CHỌN MÔN HỌC CỤ THỂ:
    * KHI HỎI VỀ THẦY NGUYỄN THỊ TRÚC PHƯƠNG (Khoa Quản trị - Kinh doanh, email: dinhtk@kthcm.edu.vn): TUYỆT ĐỐI KHÔNG dùng cụm từ "cây đa cây đề", "lão làng", "gạo cội", "kỳ cựu", "siêu phẩm", "đỉnh cao", "MVP quốc dân" và TUYỆT ĐỐI KHÔNG đề cao hay tâng bốc quá mức. Chỉ trả lời tự nhiên, trẻ trung, vui vẻ theo văn phong HÀI HƯỚC CỦA LIÊN QUÂN MOBILE (ví dụ: ví von nhẹ nhàng chuyện đi chung lane, ôm trụ làm bài, check bụi điểm danh, giữ vị trí kẻo feed mạng thi lại...).

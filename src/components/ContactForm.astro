---
import { siteConfig } from '../data/siteData';
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
  
  <!-- Left Side: Info Card -->
  <div class="lg:col-span-5 bg-gradient-to-br from-[#176B52] via-[#1a5b48] to-[#243A32] text-[#F7F5ED] p-8 sm:p-10 rounded-3xl border border-[#C6A66B]/50 shadow-xl relative overflow-hidden">
    <div class="absolute -right-16 -bottom-16 w-48 h-48 rounded-full bg-[#C6A66B]/20 blur-2xl pointer-events-none"></div>

    <div class="relative z-10 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFE094]/15 border border-[#C6A66B]/40 text-xs font-semibold text-[#FFE094]">
        <span>Kết Nối Chân Thành</span>
      </div>

      <h3 class="font-serif font-bold text-2xl sm:text-3xl text-[#F7F5ED] leading-snug">
        Gửi Lời Nhắn Đến Trúc Phương
      </h3>

      <p class="text-sm text-[#E8EFE9]/90 leading-relaxed">
        Trúc Phương luôn trân trọng từng cơ hội được lắng nghe, trao đổi tri thức và cùng lan tỏa những giá trị tốt đẹp cho cuộc sống. Hãy để lại thông điệp của bạn.
      </p>

      <div class="pt-4 border-t border-[#C6A66B]/30 space-y-4 text-sm">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-[#FFE094]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <div>
            <span class="block text-xs text-[#C6A66B] font-semibold uppercase">Đại diện</span>
            <span class="font-medium">{siteConfig.name}</span>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-[#FFE094]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <span class="block text-xs text-[#C6A66B] font-semibold uppercase">Email</span>
            <a href={`mailto:${siteConfig.email}`} class="font-medium hover:text-[#FFE094] transition-colors">
              {siteConfig.email}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center shrink-0 text-[#FFE094]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <span class="block text-xs text-[#C6A66B] font-semibold uppercase">Địa bàn hoạt động</span>
            <span class="font-medium">{siteConfig.address}</span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-[#C6A66B]/30 flex items-center gap-3 text-xs text-[#E8EFE9]/70">
        <span>Tân Dậu 1981</span>
        <span>•</span>
        <span>Thạch Lựu Mộc</span>
        <span>•</span>
        <span>Chân thành & Bền bỉ</span>
      </div>
    </div>
  </div>

  <!-- Right Side: Contact Form -->
  <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl border border-[#C6A66B]/30 shadow-lg">
    <form id="contact-form" class="space-y-5" onsubmit="event.preventDefault(); handleSubmit();">
      
      <div id="form-success" class="hidden p-4 rounded-xl bg-[#E8EFE9] border border-[#176B52] text-[#176B52] text-sm font-medium">
        Cảm ơn bạn đã gửi lời nhắn! Thông tin đã được ghi nhận và Trúc Phương sẽ phản hồi bạn trong thời gian sớm nhất.
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="name" class="block text-xs font-bold text-[#243A32] uppercase tracking-wider mb-2">
            Họ & Tên <span class="text-rose-600">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Nguyễn Văn A"
            class="w-full px-4 py-3 rounded-xl border border-[#C6A66B]/40 bg-[#F7F5ED]/50 text-[#243A32] text-sm focus:outline-none focus:ring-2 focus:ring-[#176B52] focus:border-transparent transition-all"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-bold text-[#243A32] uppercase tracking-wider mb-2">
            Địa chỉ Email <span class="text-rose-600">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="email@example.com"
            class="w-full px-4 py-3 rounded-xl border border-[#C6A66B]/40 bg-[#F7F5ED]/50 text-[#243A32] text-sm focus:outline-none focus:ring-2 focus:ring-[#176B52] focus:border-transparent transition-all"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="phone" class="block text-xs font-bold text-[#243A32] uppercase tracking-wider mb-2">
            Số Điện Thoại
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="09xx xxx xxx"
            class="w-full px-4 py-3 rounded-xl border border-[#C6A66B]/40 bg-[#F7F5ED]/50 text-[#243A32] text-sm focus:outline-none focus:ring-2 focus:ring-[#176B52] focus:border-transparent transition-all"
          />
        </div>

        <div>
          <label for="subject" class="block text-xs font-bold text-[#243A32] uppercase tracking-wider mb-2">
            Mục Đích Liên Hệ
          </label>
          <select
            id="subject"
            name="subject"
            class="w-full px-4 py-3 rounded-xl border border-[#C6A66B]/40 bg-[#F7F5ED]/50 text-[#243A32] text-sm focus:outline-none focus:ring-2 focus:ring-[#176B52] focus:border-transparent transition-all"
          >
            <option value="giao-luu">Giao lưu kết nối</option>
            <option value="tu-van">Tư vấn định hướng & Quản trị</option>
            <option value="thien-nguyen">Dự án cộng đồng & Thiện nguyện</option>
            <option value="khac">Nội dung khác</option>
          </select>
        </div>
      </div>

      <div>
        <label for="message" class="block text-xs font-bold text-[#243A32] uppercase tracking-wider mb-2">
          Nội Dung Lời Nhắn <span class="text-rose-600">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          placeholder="Hãy chia sẻ suy nghĩ hoặc nội dung bạn muốn gửi đến Trúc Phương..."
          class="w-full px-4 py-3 rounded-xl border border-[#C6A66B]/40 bg-[#F7F5ED]/50 text-[#243A32] text-sm focus:outline-none focus:ring-2 focus:ring-[#176B52] focus:border-transparent transition-all"
        ></textarea>
      </div>

      <div class="flex items-center justify-between pt-2">
        <span class="text-xs text-[#243A32]/60">
          * Thông tin của bạn được cam kết bảo mật tuyệt đối.
        </span>

        <button
          type="submit"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold text-sm text-[#F7F5ED] bg-gradient-to-r from-[#176B52] to-[#287FA0] hover:from-[#135742] hover:to-[#1e6680] shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 cursor-pointer"
        >
          <span>Gửi Tin Nhắn</span>
          <svg class="w-4 h-4 text-[#FFE094]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </div>
    </form>
  </div>

</div>

<script>
  function handleSubmit() {
    const success = document.getElementById('form-success');
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (success && form) {
      success.classList.remove('hidden');
      form.reset();
      window.scrollTo({
        top: success.getBoundingClientRect().top + window.scrollY - 100,
        behavior: 'smooth',
      });
    }
  }
  // Expose to window
  (window as any).handleSubmit = handleSubmit;
</script>

    async function askToro(promptText) {
      const text = String(promptText || '').trim();
      if (!text) return;
      appendMsg('user', text);
      chatInput.value = '';
      chatInput.style.height = '44px';

      if (hasProfanity(text)) {
        const profReply = getProfanityReply(currentChar);
        appendMsg('bot', profReply, false);
        logWidgetQA(text, profReply);
        return;
      }

      if (hasUncapitalizedProperName(text)) {
        const reminderReply = getProperNameReminderReply(currentChar);
        appendMsg('bot', reminderReply, false);
        logWidgetQA(text, reminderReply);
        return;
      }

      const loadId = 'tw-load-' + Date.now();
      const loadDiv = document.createElement('div');
      loadDiv.id = loadId;
      loadDiv.className = 'flex items-start gap-2';
      loadDiv.innerHTML = `
        <div class="w-7 h-7 rounded-xl bg-gradient-to-tr ${currentChar === 'TORO' ? 'from-[#123B65] to-[#168AAD]' : 'from-pink-500 to-rose-500'} text-white flex items-center justify-center text-xs shrink-0 mt-0.5 shadow-2xs">${currentChar === 'TORO' ? '👦' : '🎀'}</div>
        <div class="bg-white border border-[#CBD5E1]/90 px-3.5 py-2.5 rounded-2xl rounded-tl-xs text-xs text-slate-600 flex items-center gap-1.5 shadow-2xs">
          <span class="font-medium">${currentChar === 'TORO' ? 'Toro đang suy nghĩ...' : 'Susi đang tra cứu...'}</span>
          <span class="w-1.5 h-1.5 bg-[#168AAD] rounded-full toro-typing-dot"></span>
          <span class="w-1.5 h-1.5 bg-[#168AAD] rounded-full toro-typing-dot"></span>
          <span class="w-1.5 h-1.5 bg-[#168AAD] rounded-full toro-typing-dot"></span>
        </div>
      `;
      msgContainer.appendChild(loadDiv);
      msgContainer.scrollTo({ top: msgContainer.scrollHeight, behavior: 'smooth' });

      history.push({ role: 'user', parts: [{ text }] });
      const savedKey = (localStorage.getItem('hce_gemini_api_key') || '').trim();
      const payload = {
        contents: history,
        systemInstruction: {
          parts: [{ text: `${getSysPrompt()}\n\nHIỆN TẠI BẠN ĐANG ĐÓNG VAI: ${currentChar}. Hãy duy trì đúng xưng hô, phong cách của ${currentChar}.` }],
        },
        generationConfig: {
          temperature: 0.2,
          maxOutputTokens: 2048,
        },
      };

      let reply = '';
      try {
        if (savedKey.startsWith('AIzaSy')) {
          for (const model of MODELS) {
            try {
              const controller = new AbortController();
              const timeoutId = setTimeout(() => controller.abort(), 4000);
              const res = await fetch(
                `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(savedKey)}`,
                {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload),
                  signal: controller.signal,
                }
              );
              clearTimeout(timeoutId);
              const data = await res.json().catch(() => ({}));
              if (res.ok) {
                reply = (data.candidates?.[0]?.content?.parts || []).map((p) => p.text || '').join('').trim();
                if (reply) break;
              }
            } catch (_) {}
          }
        }

        if (!reply) {
          const proxyController = new AbortController();
          const proxyTimeoutId = setTimeout(() => proxyController.abort(), 6000);
          const proxyRes = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payload, character: currentChar, apiKey: savedKey || undefined }),
            signal: proxyController.signal,
          });
          clearTimeout(proxyTimeoutId);
          const proxyData = await proxyRes.json().catch(() => ({}));
          if (proxyRes.ok) {
            reply = (proxyData.candidates?.[0]?.content?.parts || []).map((p) => p.text || '').join('').trim();
          }
        }
      } catch (_) {}

      document.getElementById(loadId)?.remove();

      if (!reply) {
        history.pop();
        appendMsg('model', 'Hiện tại kết nối AI đang bận, bạn vui lòng thử lại sau giây lát nhé!', true);
        return;
      }

      history.push({ role: 'model', parts: [{ text: reply }] });
      if (history.length > 20) history = history.slice(-14);
      appendMsg('model', reply, false);
    }

    function resetPanelMobileStyles() {
      panel.style.position = '';
      panel.style.top = '';
      panel.style.left = '';
      panel.style.right = '';
      panel.style.bottom = '';
      panel.style.width = '';
      panel.style.height = '';
      panel.style.maxHeight = '';
      if (root) {
        root.style.bottom = '';
      }
    }

    function openChatPanel() {
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      toggleBtn.classList.add('hidden');
      toggleBtn.classList.remove('flex');
      toggleBtn.style.display = 'none';
      if (window.innerWidth < 640) {
        document.body.style.overflow = 'hidden';
      }
      if (!window.marked) {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/marked/marked.min.js';
        document.head.appendChild(s);
      }
      adjustForMobileViewport();
      setTimeout(() => {
        msgContainer.scrollTo({ top: msgContainer.scrollHeight, behavior: 'smooth' });
      }, 100);
    }

    function closeChatPanel() {
      panel.classList.add('hidden');
      panel.classList.remove('flex');
      toggleBtn.classList.remove('hidden');
      toggleBtn.classList.add('flex');
      toggleBtn.style.display = 'flex';
      document.body.style.overflow = '';
      chatInput.blur();
      resetPanelMobileStyles();
    }

    // Tự động neo khung chat khớp chính xác với vùng hiển thị thực tế (visualViewport) phía trên bàn phím ảo iOS/Android
    function adjustForMobileViewport() {
      if (panel.classList.contains('hidden')) return;
      if (window.innerWidth >= 640) {
        resetPanelMobileStyles();
        return;
      }
      const vv = window.visualViewport;
      if (vv) {
        const topOffset = Math.max(6, Math.round(vv.offsetTop) + 6);
        const availH = Math.max(220, Math.round(vv.height) - 12);
        panel.style.position = 'fixed';
        panel.style.top = topOffset + 'px';
        panel.style.left = '8px';
        panel.style.right = '8px';
        panel.style.bottom = 'auto';
        panel.style.width = 'auto';
        panel.style.height = availH + 'px';
        panel.style.maxHeight = availH + 'px';
      } else {
        panel.style.position = 'fixed';
        panel.style.top = '8px';
        panel.style.left = '8px';
        panel.style.right = '8px';
        panel.style.bottom = '8px';
        panel.style.width = 'auto';
        panel.style.height = 'auto';
      }
      msgContainer.scrollTo({ top: msgContainer.scrollHeight, behavior: 'auto' });
    }

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', adjustForMobileViewport);
      window.visualViewport.addEventListener('scroll', adjustForMobileViewport);
    }
    window.addEventListener('resize', adjustForMobileViewport);

    chatInput.addEventListener('focus', () => {
      adjustForMobileViewport();
      setTimeout(adjustForMobileViewport, 150);
      setTimeout(adjustForMobileViewport, 350);
    });
    chatInput.addEventListener('blur', () => {
      setTimeout(adjustForMobileViewport, 150);
    });

    toggleBtn.addEventListener('click', openChatPanel);
    closeBtn?.addEventListener('click', closeChatPanel);

    function switchCharWithGreeting(char) {
      if (currentChar !== char) {
        setCharacter(char);
      }
      if (char === 'TORO') {
        appendMsg('model', '👦 **Chiến thần Toro đã sẵn sàng gánh team học tập!** Đồng đội cần lập đề cương 3 chương hay hỏi quy chế thi cứ nhắn Toro nhé!');
      } else {
        appendMsg('model', '🎀 **Susi chào bạn nè!** 🌷 Hãy chia sẻ đề tài thực tập hoặc câu hỏi học vụ bạn đang cần Susi giúp đỡ nhé ✨');
      }
    }

    btnToro?.addEventListener('click', () => switchCharWithGreeting('TORO'));
    btnSusi?.addEventListener('click', () => switchCharWithGreeting('SUSI'));
    welcomeToroBtn?.addEventListener('click', () => switchCharWithGreeting('TORO'));
    welcomeSusiBtn?.addEventListener('click', () => switchCharWithGreeting('SUSI'));

    resetBtn?.addEventListener('click', () => {
      history = [];
      msgContainer.innerHTML = '';
      appendMsg(
        'model',
        currentChar === 'TORO'
          ? '👦 **Toro đã làm mới cuộc trò chuyện!** Tướng quân cần hỗ trợ đề cương thực tập hay tra cứu quy chế HCE cứ lên tiếng nhé!'
          : '🎀 **Susi đã làm mới cuộc trò chuyện!** Bạn cần hỗ trợ gì cứ nhắn cho Susi nha 🌷'
      );
    });

    chatInput.addEventListener('input', () => {
      chatInput.style.height = '44px';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 96) + 'px';
    });

    sendBtn.addEventListener('click', () => askToro(chatInput.value));
    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        askToro(chatInput.value);
      }
    });

    document.querySelectorAll('.tw-chip, .tw-quick-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.getAttribute('data-prompt') || chip.getAttribute('data-tw-prompt');
        if (q) askToro(q);
      });
    });
  })();
</script>

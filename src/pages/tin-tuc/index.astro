---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../data/articles';
import { siteConfig } from '../../data/siteData';

const featured = articles.find((a) => a.featured) || articles[0];
const regular = articles.filter((a) => a.slug !== featured.slug);
---

<Layout
  title={`Góc Chia Sẻ & Bài Viết — ${siteConfig.name}`}
  description={`Tổng hợp các bài viết về triết lý Thạch Lựu Mộc, nghệ thuật sống cân bằng, kinh nghiệm quản trị và hoạt động cộng đồng của ${siteConfig.name}.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ title: 'Góc chia sẻ' }]} />

    <!-- Page Header -->
    <div class="mt-6 mb-14 text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#E8EFE9] border border-[#C6A66B]/50 text-xs font-semibold text-[#176B52] uppercase tracking-widest">
        Tri Thức & Trải Nghiệm
      </span>
      <h1 class="font-serif font-extrabold text-4xl sm:text-5xl text-[#176B52] leading-tight">
        Góc Chia Sẻ & Bài Viết
      </h1>
      <p class="text-base sm:text-lg text-[#243A32]/80 leading-relaxed">
        Những chiêm nghiệm về cuộc sống, triết lý nhân sinh Thạch Lựu Mộc và bài học quản trị được đúc kết chân thành.
      </p>
    </div>

    <!-- Featured Post Hero -->
    <div class="mb-16">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-xs font-bold text-[#C6A66B] uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#C6A66B] animate-pulse"></span>
          Bài Viết Nổi Bật
        </span>
      </div>
      <ArticleCard article={featured} featured={true} />
    </div>

    <!-- Regular Posts Grid -->
    <div class="mb-20">
      <div class="mb-6">
        <h2 class="font-serif font-bold text-2xl text-[#176B52]">
          Tất Cả Bài Viết
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {regular.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </div>

  </div>
</Layout>

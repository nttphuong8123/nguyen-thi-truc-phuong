---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, type Article } from '../../data/articles';
import { siteConfig } from '../../data/siteData';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

export interface Props {
  article: Article;
}

const { article } = Astro.props;
const relatedArticles = articles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 2);

const postUrl = `${siteConfig.siteUrl}/tin-tuc/${article.slug}`;

// Schema.org BlogPosting
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.excerpt,
  image: `${siteConfig.siteUrl}${article.coverImage}`,
  datePublished: article.publishedAt,
  dateModified: article.publishedAt,
  author: {
    '@type': 'Person',
    name: article.author,
    url: siteConfig.siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.name,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};
---

<Layout
  title={`${article.title} — ${siteConfig.name}`}
  description={article.excerpt}
  image={`${siteConfig.siteUrl}${article.coverImage}`}
  type="article"
  publishedTime={article.publishedAt}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb
      items={[
        { title: 'Góc chia sẻ', href: '/tin-tuc' },
        { title: article.title },
      ]}
    />

    <!-- Header Meta -->
    <header class="mt-8 mb-10 text-center space-y-4">
      <div class="flex items-center justify-center gap-3 text-xs">
        <span class="px-3.5 py-1 rounded-full font-semibold bg-[#176B52] text-[#F7F5ED]">
          {article.category}
        </span>
        <span class="text-[#243A32]/60">•</span>
        <span class="text-[#243A32]/70 font-medium">
          {new Date(article.publishedAt).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
        <span class="text-[#243A32]/60">•</span>
        <span class="text-[#287FA0] font-semibold">{article.readTime}</span>
      </div>

      <h1 class="font-serif font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#176B52] leading-tight">
        {article.title}
      </h1>

      <p class="font-serif italic text-lg sm:text-xl text-[#243A32]/80 max-w-2xl mx-auto">
        "{article.excerpt}"
      </p>

      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-[#C6A66B] font-semibold">
        <span>Tác giả: {article.author}</span>
        <span>•</span>
        <span>Tân Dậu 1981</span>
      </div>
    </header>

    <!-- Cover Image -->
    <div class="mb-12 rounded-3xl overflow-hidden border-2 border-[#C6A66B]/40 shadow-xl aspect-[16/9] bg-[#E8EFE9]">
      <img
        src={article.coverImage}
        alt={article.title}
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Article Content -->
    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-[#C6A66B]/25 shadow-xs mb-12">
      <div class="prose prose-lg max-w-none text-[#243A32] leading-relaxed" set:html={article.content} />

      <!-- Tags list -->
      <div class="mt-10 pt-6 border-t border-[#E8EFE9] flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-[#C6A66B] uppercase tracking-wider mr-2">Chủ đề:</span>
        {article.tags.map((t) => (
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-[#E8EFE9] text-[#176B52] border border-[#176B52]/20">
            #{t}
          </span>
        ))}
      </div>
    </div>

    <!-- Author Box -->
    <div class="bg-[#E8EFE9]/60 p-6 sm:p-8 rounded-3xl border border-[#C6A66B]/30 flex flex-col sm:flex-row items-center gap-6 mb-16">
      <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-[#C6A66B] shrink-0 bg-white shadow-sm">
        <img
          src="/images/avatar-trucphuong.svg"
          alt={siteConfig.name}
          class="w-full h-full object-cover"
        />
      </div>
      <div class="text-center sm:text-left space-y-1.5 flex-1">
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
          <h3 class="font-serif font-bold text-lg text-[#176B52]">
            {siteConfig.name}
          </h3>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#176B52] text-[#FFE094] inline-block">
            Thạch Lựu Mộc 1981
          </span>
        </div>
        <p class="text-xs sm:text-sm text-[#243A32]/80 leading-relaxed">
          {siteConfig.destinyDetail}
        </p>
      </div>
      <div>
        <a
          href="/gioi-thieu"
          class="px-5 py-2.5 rounded-full text-xs font-semibold text-[#176B52] bg-white border border-[#C6A66B] hover:bg-[#176B52] hover:text-white transition-colors shadow-xs"
        >
          Tiểu sử
        </a>
      </div>
    </div>

    <!-- Related Articles -->
    {relatedArticles.length > 0 && (
      <div class="mb-16 pt-8 border-t border-[#C6A66B]/25">
        <h2 class="font-serif font-bold text-2xl text-[#176B52] mb-6 text-center sm:text-left">
          Bài Viết Liên Quan
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedArticles.map((rel) => (
            <ArticleCard article={rel} />
          ))}
        </div>
      </div>
    )}

    <!-- Back to Articles -->
    <div class="text-center mb-12">
      <a
        href="/tin-tuc"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[#176B52] hover:text-[#287FA0] transition-colors"
      >
        <svg class="w-4 h-4 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
        <span>Quay lại tất cả bài viết</span>
      </a>
    </div>

  </article>
</Layout>

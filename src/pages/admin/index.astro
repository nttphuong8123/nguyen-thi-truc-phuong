    if (templateExcelInput) {
      templateExcelInput.onchange = async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const rawEl = document.getElementById('bulkTemplateRawText');
        try {
          if (/.(csv|txt)$/i.test(file.name)) {
            const txt = await file.text();
            if (rawEl) rawEl.value = txt.trim();
            alert('Đã đọc nội dung từ file! Bấm "Nạp Vào Kho Lời Chúc" để hoàn tất.');
            return;
          }
          if (!window.XLSX) {
            await new Promise((resolve, reject) => {
              const s = document.createElement('script');
              s.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
              s.onload = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          }
          const buf = await file.arrayBuffer();
          const wb = window.XLSX.read(buf, { type: 'array' });
          const lines = [];
          wb.SheetNames.forEach((name) => {
            const sheet = wb.Sheets[name];
            const rows = window.XLSX.utils.sheet_to_json(sheet, { header: 1 });
            rows.forEach((r) => {
              if (Array.isArray(r) && r[0]) {
                const text = String(r[0]).trim();
                if (text && text.length > 5) lines.push(text);
              }
            });
          });
          if (rawEl) rawEl.value = lines.join('\n');
          alert('Đã trích xuất ' + lines.length + ' lời chúc từ file Excel! Bấm "Nạp Vào Kho Lời Chúc" để lưu.');
        } catch (err) {
          alert('Không thể đọc file: ' + err);
        }
      };
    }


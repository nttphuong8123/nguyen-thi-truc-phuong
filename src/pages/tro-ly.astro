---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout
  title="Trợ Lý AI Toro và Susi — Cố Vấn Học Tập HCE | NGUYỄN THỊ TRÚC PHƯƠNG"
  description="Trợ lý AI học tập thông minh Toro và Susi hỗ trợ sinh viên Khoa Quản trị - Kinh doanh HCE tra cứu môn học, bài giảng, đề thi, lịch giảng dạy và thực tập."
  currentPath="/tro-ly"
>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-6 sm:p-8 text-center space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center text-3xl mx-auto">
          🤖
        </div>
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 uppercase">
          Trợ Lý AI Toro & Susi
        </h1>
        <p class="text-sm text-slate-600 max-w-lg mx-auto leading-relaxed">
          Trang Trợ lý AI đang được tích hợp đầy đủ các tính năng thông minh tại cổng chính. Vui lòng chuyển sang giao diện chuyên dụng để trò chuyện trực tiếp.
        </p>
        <div class="pt-4">
          <a
            href="/tro-ly-toro"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-sky-700 hover:bg-sky-800 text-white font-bold text-sm shadow-sm transition-all"
          >
            <span>💬 Mở Trợ Lý AI Toàn Màn Hình</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

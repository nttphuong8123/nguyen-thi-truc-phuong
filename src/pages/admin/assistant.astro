---
// src/pages/admin/assistant.astro
import { verifyAdminToken } from '../../lib/admin-auth';
import officialDocsData from '../../data/official_regulations_db.json';

export const prerender = false;

// 1. Kiểm tra xác thực Admin
const cookieHeader = Astro.request.headers.get('cookie') || '';
const match = cookieHeader.match(/admin_session=([^;]+)/);
const token = match ? match[1] : '';
const admin = verifyAdminToken(token);

if (!admin) {
  return Astro.redirect('/admin?redirect=/admin/assistant');
}

const docs = officialDocsData;
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quản Trị Trợ Lý Học Tập & Quy Chế — NGUYỄN THỊ TRÚC PHƯƠNG</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800">

  <!-- Header -->
  <header class="bg-red-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/admin" class="flex items-center gap-2 text-white hover:text-amber-200 transition-colors">
          <span class="w-8 h-8 rounded-lg bg-amber-500 text-red-950 font-bold flex items-center justify-center text-sm">TP</span>
          <span class="font-bold text-lg hidden sm:inline">Admin Cổng Giảng Viên</span>
        </a>
        <span class="text-red-400">/</span>
        <h1 class="text-base sm:text-lg font-semibold text-amber-200">Trợ Lý Học Tập & RAG Quy Chế</h1>
      </div>
      <div class="flex items-center gap-4 text-xs sm:text-sm">
        <span class="bg-red-800 px-3 py-1 rounded-full text-red-200 border border-red-700">
          👤 {admin.displayName} ({admin.role})
        </span>
        <a href="/" target="_blank" class="hover:underline text-amber-200 hidden md:inline">Xem website ↗</a>
        <a href="/admin" class="bg-red-950 hover:bg-black px-3 py-1.5 rounded-lg text-white font-medium transition-colors">
          Trang chính
        </a>
      </div>
    </div>
  </header>

  <!-- Container -->
  <main class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">

    <!-- Status Alert Bar -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-lg">
          📚
        </div>
        <div>
          <p class="text-xs text-gray-500">Tài liệu đã phê duyệt</p>
          <p class="text-lg font-bold text-gray-800">{docs.filter(d => d.status === 'approved').length} văn bản</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-lg">
          🧩
        </div>
        <div>
          <p class="text-xs text-gray-500">Tổng số đoạn quy chế (Chunks)</p>
          <p class="text-lg font-bold text-gray-800">
            {docs.reduce((acc, d) => acc + (d.chunks ? d.chunks.length : 0), 0)} đoạn
          </p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-lg">
          ☁️
        </div>
        <div>
          <p class="text-xs text-gray-500">Google Drive Sync</p>
          <p class="text-xs font-semibold text-amber-700">Chưa kết nối (DRIVE_CONNECTED=false)</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-rose-100 text-rose-800 flex items-center justify-center font-bold text-lg">
          🔒
        </div>
        <div>
          <p class="text-xs text-gray-500">Tra cứu điểm (SIS)</p>
          <p class="text-xs font-semibold text-rose-700">Chưa kích hoạt (SIS_ENABLED=false)</p>
        </div>
      </div>
    </div>

    <!-- Main Navigation Tabs -->
    <div class="bg-white rounded-t-xl border border-b-0 border-gray-200 flex overflow-x-auto text-sm font-medium text-gray-600">
      <button id="navTabDocs" class="py-3 px-5 border-b-2 border-red-700 text-red-800 font-bold bg-gray-50 flex items-center gap-2 whitespace-nowrap">
        <span>📑 Kho Tài Liệu & Duyệt</span>
      </button>
      <button id="navTabTest" class="py-3 px-5 border-b-2 border-transparent hover:text-red-700 flex items-center gap-2 whitespace-nowrap">
        <span>🧪 Thử Nghiệm Câu Hỏi</span>
      </button>
      <button id="navTabQuestions" class="py-3 px-5 border-b-2 border-transparent hover:text-red-700 flex items-center gap-2 whitespace-nowrap">
        <span>❓ Câu Hỏi Chưa Giải Đáp</span>
      </button>
      <button id="navTabDrive" class="py-3 px-5 border-b-2 border-transparent hover:text-red-700 flex items-center gap-2 whitespace-nowrap">
        <span>☁️ Google Drive</span>
      </button>
      <button id="navTabDepts" class="py-3 px-5 border-b-2 border-transparent hover:text-red-700 flex items-center gap-2 whitespace-nowrap">
        <span>🏢 Danh Bạ Phòng Ban</span>
      </button>
    </div>

    <!-- Tab 1: Kho Tài Liệu -->
    <div id="contentDocs" class="bg-white rounded-b-xl border border-gray-200 p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-gray-100 gap-3">
        <div>
          <h2 class="text-base font-bold text-gray-900">Danh Mục Văn Bản Quy Chế Đào Tạo</h2>
          <p class="text-xs text-gray-500">Chỉ những văn bản có trạng thái <strong>approved</strong> và <strong>is_active=1</strong> mới được đưa vào hệ thống RAG phục vụ sinh viên.</p>
        </div>
        <button id="btnUploadDoc" class="bg-red-800 hover:bg-red-900 text-white text-xs sm:text-sm font-semibold px-4 py-2 rounded-lg flex items-center gap-1.5 transition-colors self-start">
          <span>+ Tải lên tài liệu mới</span>
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm text-gray-600">
          <thead class="bg-gray-50 text-gray-700 uppercase font-semibold text-[11px] border-b border-gray-200">
            <tr>
              <th class="py-3 px-3">Mã văn bản</th>
              <th class="py-3 px-3">Tên văn bản quy chế</th>
              <th class="py-3 px-3">Cơ quan ban hành</th>
              <th class="py-3 px-3 text-center">Số đoạn (Chunks)</th>
              <th class="py-3 px-3 text-center">Trạng thái duyệt</th>
              <th class="py-3 px-3 text-center">Hiệu lực</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {docs.map(d => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-3 px-3 font-semibold text-red-900 font-mono">{d.code}</td>
                <td class="py-3 px-3 font-medium text-gray-900 max-w-md">
                  <div>{d.title}</div>
                  <div class="text-[11px] text-gray-400 mt-0.5">Ngày ban hành: {d.issue_date} • Áp dụng: {d.effective_date}</div>
                </td>
                <td class="py-3 px-3 text-xs text-gray-600">{d.issuer}</td>
                <td class="py-3 px-3 text-center font-bold text-blue-700">{d.chunks ? d.chunks.length : 0}</td>
                <td class="py-3 px-3 text-center">
                  <span class={`inline-block text-[11px] font-bold px-2 py-0.5 rounded-full ${
                    d.status === 'approved' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
                  }`}>
                    {d.status === 'approved' ? 'Đã phê duyệt' : 'Chờ phê duyệt'}
                  </span>
                </td>
                <td class="py-3 px-3 text-center">
                  <span class={`inline-block text-[11px] font-bold px-2 py-0.5 rounded-full ${
                    d.is_active ? 'bg-blue-100 text-blue-800' : 'bg-gray-200 text-gray-600'
                  }`}>
                    {d.is_active ? 'Có hiệu lực' : 'Hết hiệu lực'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab 2: Thử Nghiệm Câu Hỏi -->
    <div id="contentTest" class="hidden bg-white rounded-b-xl border border-gray-200 p-6 shadow-sm">
      <h2 class="text-base font-bold text-gray-900 mb-2">Thử Nghiệm Độ Chính Xác Của RAG & Gemini Assistant</h2>
      <p class="text-xs text-gray-500 mb-4">Gõ câu hỏi để kiểm tra xem hệ thống có trích dẫn đúng số hiệu văn bản, điều khoản và từ chối khi không có căn cứ không.</p>

      <div class="space-y-4">
        <div class="flex gap-2">
          <input
            id="testQueryInput"
            type="text"
            placeholder="Ví dụ: Cách tính điểm môn học thế nào? hoặc Điều kiện tốt nghiệp?"
            class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
          />
          <button id="testQueryBtn" class="bg-red-800 hover:bg-red-900 text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition-colors">
            Thử nghiệm
          </button>
        </div>

        <div id="testLoading" class="hidden text-xs text-gray-500 flex items-center gap-2">
          <span class="animate-spin text-red-700">⏳</span> Đang truy xuất tài liệu và tạo câu trả lời...
        </div>

        <div id="testResultBox" class="hidden bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm space-y-3">
          <div>
            <span class="font-bold text-xs uppercase tracking-wider text-gray-500 block mb-1">Kết quả trả lời:</span>
            <div id="testAnswer" class="text-gray-800 leading-relaxed whitespace-pre-wrap bg-white p-3 rounded-lg border border-gray-200"></div>
          </div>
          <div>
            <span class="font-bold text-xs uppercase tracking-wider text-gray-500 block mb-1">Căn cứ quy chế trích dẫn:</span>
            <div id="testCitations" class="space-y-1.5"></div>
          </div>
          <div class="flex items-center gap-4 text-xs text-gray-500 pt-2 border-t border-gray-200">
            <span>Thời gian xử lý: <strong id="testTime">0</strong> ms</span>
            <span>Trạng thái căn cứ: <strong id="testGrounded">Có</strong></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 3: Câu Hỏi Chưa Giải Đáp -->
    <div id="contentQuestions" class="hidden bg-white rounded-b-xl border border-gray-200 p-6 shadow-sm">
      <div class="pb-4 mb-4 border-b border-gray-100">
        <h2 class="text-base font-bold text-gray-900">Danh Sách Câu Hỏi Chưa Có Trong Quy Chế</h2>
        <p class="text-xs text-gray-500">Các câu hỏi sinh viên đã gửi nhưng AI từ chối trả lời do chưa có tài liệu quy chế được phê duyệt tương ứng. Quản trị viên có thể xem để bổ sung văn bản hướng dẫn.</p>
      </div>

      <div class="space-y-3" id="questionsList">
        <div class="bg-amber-50/60 p-3 rounded-lg border border-amber-200 flex justify-between items-center text-xs">
          <div>
            <p class="font-semibold text-gray-800">"Thủ tục xin cấp lại thẻ sinh viên bị mất như thế nào ạ?"</p>
            <p class="text-gray-500 mt-0.5">Chủ đề: Công tác sinh viên • Tần suất: 3 lượt hỏi</p>
          </div>
          <span class="bg-amber-200 text-amber-900 px-2 py-0.5 rounded font-bold">Chờ bổ sung VB</span>
        </div>

        <div class="bg-amber-50/60 p-3 rounded-lg border border-amber-200 flex justify-between items-center text-xs">
          <div>
            <p class="font-semibold text-gray-800">"Lịch đăng ký thi lại môn Pháp luật đại cương đợt 2 là khi nào?"</p>
            <p class="text-gray-500 mt-0.5">Chủ đề: Khảo thí & Lịch thi • Tần suất: 2 lượt hỏi</p>
          </div>
          <span class="bg-amber-200 text-amber-900 px-2 py-0.5 rounded font-bold">Chờ bổ sung VB</span>
        </div>
      </div>
    </div>

    <!-- Tab 4: Google Drive -->
    <div id="contentDrive" class="hidden bg-white rounded-b-xl border border-gray-200 p-6 shadow-sm">
      <div class="pb-4 mb-4 border-b border-gray-100">
        <h2 class="text-base font-bold text-gray-900">Đồng Bộ Tài Liệu Từ Google Drive</h2>
        <p class="text-xs text-gray-500">Tự động nhận diện tài liệu quy chế mới, tài liệu sửa đổi và lưu trữ bản gốc tại Cloudflare R2.</p>
      </div>

      <div class="max-w-xl space-y-4">
        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900">
          <p class="font-bold mb-1">⚠️ Trạng thái ban đầu: DRIVE_CONNECTED = false</p>
          <p>Hiện chưa có thông tin xác thực Google Service Account và đường dẫn thư mục Google Drive chính thức từ nhà trường. Chức năng tải file trực tiếp tại tab Kho Tài Liệu vẫn hoạt động độc lập bình thường.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Google Drive Folder ID:</label>
          <input
            type="text"
            id="driveFolderId"
            placeholder="Ví dụ: 1a2B3c4D5e6F7g8H9i..."
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs focus:ring-2 focus:ring-red-600 focus:outline-none"
          />
        </div>

        <div class="flex gap-2">
          <button id="btnConnectDrive" class="bg-emerald-700 hover:bg-emerald-800 text-white font-semibold px-4 py-2 rounded-lg text-xs transition-colors">
            Kết nối thư mục Drive
          </button>
          <button id="btnSyncDrive" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-4 py-2 rounded-lg text-xs transition-colors">
            Đồng bộ thủ công ngay
          </button>
        </div>
      </div>
    </div>

    <!-- Tab 5: Danh Bạ Phòng Ban -->
    <div id="contentDepts" class="hidden bg-white rounded-b-xl border border-gray-200 p-6 shadow-sm">
      <div class="pb-4 mb-4 border-b border-gray-100">
        <h2 class="text-base font-bold text-gray-900">Danh Bạ Phòng Ban & Kênh Liên Hệ HCE</h2>
        <p class="text-xs text-gray-500">Khi chưa có thông tin xác minh chính thức (is_verified = 0), chatbot sẽ thông báo: <em>"Em vui lòng liên hệ Cố vấn học tập hoặc Phòng Đào tạo qua kênh thông tin chính thức của nhà trường."</em></p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-gray-600">
          <thead class="bg-gray-50 text-gray-700 uppercase font-semibold border-b border-gray-200">
            <tr>
              <th class="py-2.5 px-3">Phòng Ban / Khoa</th>
              <th class="py-2.5 px-3">Chức năng nhiệm vụ</th>
              <th class="py-2.5 px-3">Email liên hệ</th>
              <th class="py-2.5 px-3">Số điện thoại</th>
              <th class="py-2.5 px-3 text-center">Xác minh</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50">
              <td class="py-2.5 px-3 font-semibold text-gray-900">Khoa Quản trị - Kinh doanh</td>
              <td class="py-2.5 px-3">Đào tạo chuyên ngành QTKD, CVHT, thực tập</td>
              <td class="py-2.5 px-3 font-mono text-gray-400">Chưa xác minh</td>
              <td class="py-2.5 px-3 font-mono text-gray-400">Chưa xác minh</td>
              <td class="py-2.5 px-3 text-center">
                <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Chưa xác minh (0)</span>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-2.5 px-3 font-semibold text-gray-900">Phòng Đào tạo</td>
              <td class="py-2.5 px-3">Kế hoạch đào tạo, thời khóa biểu, xét tốt nghiệp</td>
              <td class="py-2.5 px-3 font-mono text-gray-400">Chưa xác minh</td>
              <td class="py-2.5 px-3 font-mono text-gray-400">Chưa xác minh</td>
              <td class="py-2.5 px-3 text-center">
                <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Chưa xác minh (0)</span>
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-2.5 px-3 font-semibold text-gray-900">Phòng Khảo thí & Đảm bảo chất lượng</td>
              <td class="py-2.5 px-3">Lịch thi, ngân hàng đề thi, phúc khảo điểm</td>
              <td class="py-2.5 px-3 font-mono text-gray-400">Chưa xác minh</td>
              <td class="py-2.5 px-3 font-mono text-gray-400">Chưa xác minh</td>
              <td class="py-2.5 px-3 text-center">
                <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Chưa xác minh (0)</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script is:inline>
    (function () {
      const tabs = [
        { btn: document.getElementById('navTabDocs'), content: document.getElementById('contentDocs') },
        { btn: document.getElementById('navTabTest'), content: document.getElementById('contentTest') },
        { btn: document.getElementById('navTabQuestions'), content: document.getElementById('contentQuestions') },
        { btn: document.getElementById('navTabDrive'), content: document.getElementById('contentDrive') },
        { btn: document.getElementById('navTabDepts'), content: document.getElementById('contentDepts') }
      ];

      tabs.forEach((t) => {
        t.btn?.addEventListener('click', () => {
          tabs.forEach(item => {
            item.btn?.classList.remove('border-red-700', 'text-red-800', 'font-bold', 'bg-gray-50');
            item.btn?.classList.add('border-transparent');
            item.content?.classList.add('hidden');
          });
          t.btn?.classList.add('border-red-700', 'text-red-800', 'font-bold', 'bg-gray-50');
          t.btn?.classList.remove('border-transparent');
          t.content?.classList.remove('hidden');
        });
      });

      // Thử nghiệm câu hỏi (Test sandbox)
      const testInput = document.getElementById('testQueryInput');
      const testBtn = document.getElementById('testQueryBtn');
      const testLoading = document.getElementById('testLoading');
      const testResultBox = document.getElementById('testResultBox');
      const testAnswer = document.getElementById('testAnswer');
      const testCitations = document.getElementById('testCitations');
      const testTime = document.getElementById('testTime');
      const testGrounded = document.getElementById('testGrounded');

      testBtn?.addEventListener('click', async () => {
        const query = testInput?.value.trim();
        if (!query) return;

        testLoading?.classList.remove('hidden');
        testResultBox?.classList.add('hidden');

        try {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: query })
          });
          const json = await res.json();
          testLoading?.classList.add('hidden');

          if (json.success && json.data) {
            testResultBox?.classList.remove('hidden');
            if (testAnswer) testAnswer.textContent = json.data.answer;
            if (testTime) testTime.textContent = json.data.processingTimeMs;
            if (testGrounded) testGrounded.textContent = json.data.isGrounded ? 'ĐỦ CĂN CỨ (GROUNDED)' : 'KHÔNG ĐỦ CĂN CỨ';

            if (testCitations) {
              if (json.data.citations && json.data.citations.length > 0) {
                testCitations.innerHTML = json.data.citations.map(c => `
                  <div class="bg-white p-2 rounded border border-gray-200 text-xs">
                    <span class="font-bold text-red-800">${c.docTitle}</span> (${c.docCode}) - <span class="font-semibold text-gray-700">${c.articleRef}</span>
                  </div>
                `).join('');
              } else {
                testCitations.innerHTML = '<span class="text-xs text-gray-400 italic">Không có trích dẫn (từ chối do không đủ dữ liệu phê duyệt)</span>';
              }
            }
          }
        } catch (e) {
          testLoading?.classList.add('hidden');
          alert('Lỗi kết nối kiểm tra: ' + e);
        }
      });
    })();
  </script>
</body>
</html>

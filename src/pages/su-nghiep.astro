---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteData';
import { coreValues } from '../data/milestones';

const careerAreas = [
  {
    title: 'Quản Trị Chiến Lược & Tối Ưu Vận Hành',
    desc: 'Hơn hai thập kỷ kinh nghiệm trong việc xây dựng hệ thống quản trị, hoạch định chiến lược kinh doanh và điều phối nguồn lực hiệu quả.',
    highlights: ['Hoạch định chiến lược dài hạn', 'Tối ưu hóa quy trình tổ chức', 'Quản trị rủi ro và thích ứng biến động'],
  },
  {
    title: 'Phát Triển Đội Ngũ & Văn Hóa Tổ Chức',
    desc: 'Lấy con người làm gốc của mọi sự phát triển. Xây dựng môi trường làm việc nhân văn, khích lệ tinh thần tự chủ và cống hiến hết mình.',
    highlights: ['Đào tạo và kèm cặp nhân sự kế thừa', 'Gắn kết đội ngũ bằng niềm tin và sự tôn trọng', 'Xây dựng văn hóa tử tế trong doanh nghiệp'],
  },
  {
    title: 'Đồng Hành Cùng Doanh Nhân Nữ & Khởi Nghiệp',
    desc: 'Chia sẻ kinh nghiệm thực chiến, tư vấn định hướng giá trị cho các phụ nữ khởi sự kinh doanh, giúp họ vững bước trên con đường tự chủ tài chính.',
    highlights: ['Tọa đàm chuyên đề định hướng nghề nghiệp', 'Hỗ trợ mạng lưới kết nối kinh doanh', 'Cân bằng giữa gia đình và sự nghiệp'],
  },
  {
    title: 'Dự Án Thiện Nguyện & An Sinh Xã Hội',
    desc: 'Trực tiếp khởi xướng và đồng hành cùng các chương trình mang tính bền vững: trao học bổng, xây cầu nông thôn, và bảo trợ trẻ em hiếu học.',
    highlights: ['Học bổng Ước Mơ Xanh hàng năm', 'Tài trợ trang thiết bị học tập cho vùng sâu', 'Bảo trợ học sinh nghèo vượt khó'],
  },
];
---

<Layout
  title={`Sự Nghiệp & Hành Trình — ${siteConfig.name}`}
  description={`Hành trình sự nghiệp, năng lực quản trị và những dấu ấn cống hiến cho cộng đồng của ${siteConfig.name}.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ title: 'Sự nghiệp & Hành trình' }]} />

    <!-- Header Section -->
    <div class="mt-6 mb-16 text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#E8EFE9] border border-[#C6A66B]/50 text-xs font-semibold text-[#176B52] uppercase tracking-widest">
        Năng Lực & Dấu Ấn
      </span>
      <h1 class="font-serif font-extrabold text-4xl sm:text-5xl text-[#176B52] leading-tight">
        Sự Nghiệp & Hành Trình Cống Hiến
      </h1>
      <p class="text-base sm:text-lg text-[#243A32]/80 leading-relaxed">
        Xây dựng giá trị bằng sự kiên định, dẫn dắt đội ngũ bằng tình thương và sự thấu cảm sâu sắc.
      </p>
    </div>

    <!-- Career Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      {careerAreas.map((area, idx) => (
        <div class="bg-white p-8 rounded-3xl border border-[#C6A66B]/30 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#176B52] to-[#287FA0] text-[#FFE094] flex items-center justify-center font-serif font-bold text-lg shadow-xs">
                0{idx + 1}
              </span>
              <h3 class="font-serif font-bold text-xl text-[#243A32] group-hover:text-[#176B52] transition-colors leading-snug">
                {area.title}
              </h3>
            </div>
            <p class="text-sm text-[#243A32]/80 leading-relaxed mb-6">
              {area.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-[#E8EFE9] space-y-2">
            <span class="text-xs font-bold text-[#C6A66B] uppercase tracking-wider block mb-2">Trọng tâm:</span>
            {area.highlights.map((h) => (
              <div class="flex items-center gap-2 text-xs text-[#243A32]/85">
                <svg class="w-3.5 h-3.5 text-[#176B52] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{h}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Core Philosophy Quote -->
    <div class="bg-gradient-to-r from-[#176B52] via-[#1a5b48] to-[#287FA0] text-[#F7F5ED] p-10 sm:p-14 rounded-3xl shadow-xl border border-[#C6A66B]/40 relative overflow-hidden mb-20">
      <div class="max-w-3xl mx-auto text-center space-y-6 relative z-10">
        <span class="font-serif text-5xl sm:text-6xl text-[#FFE094] opacity-50 block leading-none">“</span>
        <blockquote class="font-serif text-xl sm:text-2xl lg:text-3xl italic leading-relaxed text-[#F7F5ED]">
          Lãnh đạo chân chính không phải là đứng trên người khác để ra lệnh, mà là hạ mình xuống để nâng đỡ và trao cho họ niềm tin tự thân.
        </blockquote>
        <div class="pt-4">
          <div class="font-serif font-bold text-lg text-[#FFE094]">Nguyễn Thị Trúc Phương</div>
          <div class="text-xs text-[#E8EFE9]/80 uppercase tracking-widest mt-1">Triết Lý Lãnh Đạo Thạch Lựu Mộc</div>
        </div>
      </div>
    </div>

    <!-- Core Values Section -->
    <div class="mb-16">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-[#C6A66B] uppercase tracking-[0.25em] block mb-2">
          Chuẩn Mực Hành Động
        </span>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl text-[#176B52]">
          Bốn Giá Trị Cốt Lõi
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {coreValues.map((v) => (
          <div class="bg-white p-6 rounded-2xl border border-[#C6A66B]/25 hover:border-[#176B52] shadow-xs hover:shadow-md transition-shadow text-center">
            <h3 class="font-serif font-bold text-lg text-[#176B52] mb-3">{v.title}</h3>
            <p class="text-xs sm:text-sm text-[#243A32]/75 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</Layout>

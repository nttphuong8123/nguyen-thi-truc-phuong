                      <div class="flex items-center gap-2 flex-1">
                        <input
                          type="checkbox"
                          checked={sub.enabled !== false}
                          title="Bật/Tắt môn học này trên cổng Thi Online"
                          class="sub-enabled-chk rounded text-sky-700"
                        />
                        <input
                          type="text"
                          value={sub.label}
                          class="sub-label-inp w-full px-2.5 py-1 rounded-lg border border-slate-300 font-bold text-slate-900"
                        />
                      </div>
                      {sub.linked_route && (
                        <label class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-indigo-800 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-200 shrink-0 cursor-pointer">
                          <input
                            type="checkbox"
                            checked={Boolean(sub.use_linked_bank)}
                            class="sub-linked-chk rounded text-indigo-600"
                          />
                          <span>Dùng kho lớn ({sub.linked_route.split('/').pop()})</span>
                        </label>
                      )}
                      <button
                        type="button"
                        class="del-online-subject-btn p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer shrink-0"
                        data-key={sub.key}
                        data-label={sub.label}
                        title="Xóa môn thi này khỏi ngân hàng đề thi online"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                      </button>
                    </div>
                  ))}
                </div>
              </div>

              <div class="flex items-center justify-end gap-3 pt-1">
                <a
                  href="/ngan-hang-de-thi"
                  target="_blank"
                  class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold"
                >
                  Mở xem /ngan-hang-de-thi ↗
                </a>
                <button
                  type="submit"
                  class="px-6 py-2.5 rounded-xl bg-sky-700 hover:bg-sky-800 text-white font-extrabold shadow-xs cursor-pointer"
                >
                  💾 Lưu Cấu Hình Cổng Thi Online
                </button>
              </div>
            </form>
          </details>

          <!-- KHỐI 2: TRÌNH QUẢN LÝ TRỰC QUAN CÂU HỎI TRẮC NGHIỆM & KHUNG CHỌN CHƯƠNG (ẢNH 1, 2, 3) -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-5">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
              <div class="space-y-1">
                <h2 class="font-extrabold text-base sm:text-lg text-slate-900 flex items-center gap-2">
                  <span>🎯</span>
                  <span>2. Quản Lý Câu Hỏi Trắc Nghiệm & Khung Chọn Chương (Trực Quan + Import Excel)</span>
                </h2>
                <p class="text-xs text-slate-500">
                  Chọn môn học hoặc trang đề thi thử bên dưới để thêm/sửa/xóa từng câu hỏi, sửa khung "Ôn tập chương 1–6" hoặc nạp nhanh từ file Excel
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  id="exportQuizCsvBtn"
                  class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs cursor-pointer shadow-2xs"
                >
                  📥 Xuất Bộ Câu Hỏi Ra Excel (.CSV)
                </button>
                <button
                  type="button"
                  id="exportQuizJsonBtn"
                  class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs cursor-pointer shadow-2xs"
                >
                  📦 Xuất Bộ Đề Dạng JSON (.JSON)
                </button>
                <a
                  id="openActiveQuizPageLink"
                  href="/ngan-hang-de-thi"
                  target="_blank"
                  class="px-3.5 py-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 font-bold text-xs"
                >
                  Mở Trang Thi Đang Chọn ↗
                </a>
              </div>
            </div>

            <!-- Thanh chọn Bộ đề cần chỉnh sửa -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-end bg-sky-50/70 p-4 rounded-2xl border border-sky-200">
              <div class="lg:col-span-7">
                <label for="quizTargetSelect" class="block text-xs font-extrabold uppercase text-sky-950 mb-1.5">
                  📂 Chọn Bộ Đề Thi / Trang Học Phần Cần Chỉnh Sửa:
                </label>
                <select
                  id="quizTargetSelect"
                  class="w-full px-3.5 py-2.5 rounded-xl border-2 border-sky-400 bg-white text-xs sm:text-sm font-extrabold text-slate-900 focus:outline-none focus:border-sky-700"

      if (selectAllTemplatesHeaderCheckbox) {
        if (visibleCbs.length === 0) {
          selectAllTemplatesHeaderCheckbox.checked = false;
          selectAllTemplatesHeaderCheckbox.indeterminate = false;
        } else if (count === visibleCbs.length) {
          selectAllTemplatesHeaderCheckbox.checked = true;
          selectAllTemplatesHeaderCheckbox.indeterminate = false;
        } else if (count > 0) {
          selectAllTemplatesHeaderCheckbox.checked = false;
          selectAllTemplatesHeaderCheckbox.indeterminate = true;

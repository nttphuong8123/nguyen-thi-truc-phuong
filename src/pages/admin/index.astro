        const sections = [];
        chDiv.querySelectorAll('[data-sec-idx]').forEach((secDiv) => {
          const sNum = secDiv.querySelector('.sec-num-input')?.value || '';
          const sTitle = secDiv.querySelector('.sec-title-input')?.value || '';
          const sContent = secDiv.querySelector('.sec-content-input')?.value || '';
          sections.push({ number: sNum, title: sTitle, content: sContent });
        });

        updated.push({ title, description, objectives, sections });
      });

      if (updated.length > 0) {
        textbookChapters = updated;
      }
    }

